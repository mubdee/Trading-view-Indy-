//@version=6
indicator("SMC Suite v1.4", shorttitle = "SMC Suite", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ═══════════════════════════ INPUTS ═══════════════════════════
G0 = "General / Entry"
profile   = input.string("Balanced", "Profile", options = ["Strict", "Balanced", "Context-only"], group = G0)
trigMode  = input.string("Rejection Candle", "Entry trigger", options = ["Rejection Candle", "Internal MSS", "SFP", "Any enabled trigger"], group = G0)
zoneMode  = input.string("OB A+ or D/S", "Entry zone", options = ["OB A+ or D/S", "OB A+ only", "D/S only", "OB A+ overlapping D/S"], group = G0)
trigMax   = input.int(10, "Internal MSS trigger: max bars after first touch", minval = 1, group = G0)
entryLen  = input.int(20, "Entry zone length (bars)", minval = 3, maxval = 300, group = G0)
showCk    = input.bool(false, "Show entry checklist tooltip marker", group = G0)
showDash  = input.bool(true, "Show dashboard", group = G0)
debugOn   = input.bool(false, "Debug: show reset reasons", group = G0)

G1 = "Timeframes (Phase 1: detection modules run on Chart TF)"
htfOn     = input.bool(false, "HTF context", inline = "htf", group = G1)
htfTf     = input.timeframe("240", "", inline = "htf", group = G1)

G2 = "Market structure (CHoCH / BOS / IDM)"
chochLen  = input.int(5, "CHoCH detection period (swing length)", minval = 1, group = G2)
idmLen    = input.int(2, "IDM detection period (swing length)", minval = 1, group = G2)
idmReclaim = input.bool(false, "IDM counts as taken only if the candle closes back", group = G2)
brkBufAtr = input.float(0.0, "Break buffer (x ATR14)", minval = 0, step = 0.01, group = G2)
eqTolAtr  = input.float(0.05, "Equal-level tolerance (x ATR14)", minval = 0, step = 0.01, group = G2)
showMajor = input.bool(true, "Show BOS / CHoCH", group = G2)
showFake  = input.bool(true, "Show structure sweeps (wick only)", group = G2)
showIdm   = input.bool(true, "Show IDM (when taken)", group = G2)
showIdmPend = input.bool(false, "Show IDM before it is taken", group = G2)
showSw    = input.bool(true, "Show HH / HL / LH / LL / EQH / EQL", group = G2)

G3 = "Liquidity"
liqMajor  = input.bool(true, "Pools from CHoCH swings", group = G3)
usePD     = input.bool(true, "PDH / PDL", group = G3)
usePW     = input.bool(true, "PWH / PWL", group = G3)
swBufAtr  = input.float(0.0, "Sweep buffer (x ATR14)", minval = 0, step = 0.01, group = G3)
poolMax   = input.int(500, "Pool max age (bars)", minval = 10, group = G3)
showPools = input.bool(true, "Show liquidity lines", group = G3)
showSwp   = input.bool(true, "Show liquidity grabs (swept level, wick, confirmation level)", group = G3)

G4 = "MSS / Displacement"
mssCh     = input.bool(true, "CHoCH can be MSS (reversal setups)", group = G4)
dispMult  = input.float(1.0, "Displacement body >= x ATR14", minval = 0.1, step = 0.1, group = G4)
dispLoc   = input.float(0.25, "Displacement close in outer % of range", minval = 0.05, maxval = 0.5, step = 0.05, group = G4)
dispWin   = input.int(0, "Displacement window (bars before break)", minval = 0, group = G4)

G5 = "Order Block A+ / Demand-Supply"
obLook    = input.int(5, "OB: last opposite candle within N bars", minval = 1, maxval = 20, group = G5)
obFilter  = input.string("A+ only", "OB filter", options = ["A+ only", "All"], group = G5)
reqSweep  = input.bool(true, "A+: leg must sweep liquidity", group = G5)
sweepLook = input.int(10, "A+: liquidity lookback before OB (bars)", minval = 2, maxval = 50, group = G5)
reqImb    = input.bool(true, "A+: leg must leave an imbalance", group = G5)
imbMinAtr = input.float(0.05, "A+: imbalance minimum size (x ATR14)", minval = 0, step = 0.01, group = G5)
dsOn      = input.bool(true, "Demand / Supply zones", group = G5)
dsMaxBase = input.int(3, "D/S: max base candles", minval = 1, maxval = 6, group = G5)
dsBasePct = input.float(0.5, "D/S: base candle body <= % of range", minval = 0.1, maxval = 0.9, step = 0.05, group = G5)
invBufAtr = input.float(0.0, "Zone invalidation buffer (x ATR14)", minval = 0, step = 0.01, group = G5)
mitMode   = input.string("Touch", "Zone counts as mitigated at", options = ["Touch", "50%", "Full"], group = G5)
zoneView  = input.string("Fresh only", "Zone display", options = ["Fresh only", "All active"], group = G5)
zoneRemove = input.string("Close beyond", "Remove zone when price", options = ["Close beyond", "Wick through"], group = G5)
showMid   = input.bool(true, "Show 50% line", group = G5)
showStats = input.bool(true, "Show zone statistics panel", group = G5)
zoneMax   = input.int(300, "Zone max age (bars)", minval = 10, group = G5)
showAllZ  = input.bool(false, "Also draw zones not linked to an MSS", group = G5)
keepInv   = input.bool(false, "Keep invalidated zones (greyed)", group = G5)

G6 = "SFP / Rejection Block"
sfpOn     = input.bool(true, "SFP module", group = G6)
sfpTrig   = input.string("Sweep candle", "SFP trigger level = low/high of", options = ["Sweep candle", "Swept swing candle"], group = G6)
sfpMax    = input.int(5, "SFP max bars after sweep", minval = 1, group = G6)
volLen    = input.int(20, "Strong volume: SMA length", minval = 2, group = G6)
volMult   = input.float(1.5, "Strong volume: >= x SMA", minval = 1.0, step = 0.1, group = G6)
volDirReq = input.bool(true, "Strong-volume candle must close in SFP direction", group = G6)
showSfp   = input.bool(true, "Show SFP", group = G6)
rbMode    = input.string("Wick", "Rejection Block boundary", options = ["Wick", "Body", "Full"], group = G6)
rbBufAtr  = input.float(0.0, "RB invalidation buffer (x ATR14)", minval = 0, step = 0.01, group = G6)
rbAt      = input.string("SFP confirmed", "Create RJB when", options = ["SFP confirmed", "Liquidity sweep"], group = G6)
rbLen     = input.int(10, "RJB box length (bars)", minval = 2, maxval = 200, group = G6)
showRB    = input.bool(true, "Show Rejection Blocks (RJB)", group = G6)

G7 = "SMT"
smtOn     = input.bool(true, "SMT module", group = G7)
smtMode   = input.string("Auto map", "Comparison symbol", options = ["Auto map", "Manual"], group = G7)
smtManual = input.symbol("OANDA:XAGUSD", "Manual symbol", group = G7)
smtInvMan = input.bool(false, "Manual: inverse correlation", group = G7)
smtTol    = input.int(2, "Timestamp tolerance (bars)", minval = 0, group = G7)
showSmt   = input.bool(true, "Show SMT", group = G7)

G8 = "Colours"
colBull   = input.color(color.new(#b2b5be, 0), "Bullish", group = G8)
colBear   = input.color(color.new(#5d606b, 0), "Bearish", group = G8)
colFake   = input.color(color.new(#787b86, 0), "Neutral / sweep", group = G8)
colIdmC   = input.color(color.new(#868993, 0), "IDM waiting", group = G8)
colIdmS   = input.color(color.new(#d1d4dc, 0), "IDM taken", group = G8)

// ═══════════════════════════ CONSTANTS ═══════════════════════════
S_NONE = 0
S_MSS = 4
S_ZONE = 5
K_OB = 0
K_DS = 1
K_RB = 2

// ═══════════════════════════ TYPES ═══════════════════════════
type Ctr
    int n = 0

type Struct
    float hi
    int   hiBar
    int   hiState = 0   // 0 active, 1 wick-swept (still breakable), 2 consumed
    float lo
    int   loBar
    int   loState = 0
    int   bias = 0
    float lastPH
    int   lastPHBar
    float lastPL
    int   lastPLBar

// structure engine: CHoCH from swings, BOS from trailing extremes, IDM required between phases
type Eng
    int   trend = 0     // 1 bull, -1 bear, 0 neutral
    float tMax
    int   tMaxBar
    float tMin
    int   tMinBar
    float pLo           // protected low (bearish CHoCH level)
    int   pLoBar
    float pHi           // protected high (bullish CHoCH level)
    int   pHiBar
    float idm
    int   idmBar
    bool  idmTaken = false
    int   idmTakenBar
    float pull          // pullback extreme after IDM taken
    int   pullBar
    int   phaseBar
    int   legStart
    int   sweptHi
    int   sweptLo
    line  idmLn
    label idmLb

type Pool
    int   id
    float price
    int   dir
    string src
    int   pbar
    int   created
    float oLow
    float oHigh
    int   touches = 1
    line  ln

type Zone
    int   id
    int   kind
    int   dir
    float top
    float bot
    float invLvl
    int   leftBar
    int   createdBar
    int   dispBar
    int   srcId
    int   firstTouch
    int   state = 0
    bool  sweep = false
    bool  imb = false
    box   bx
    line  mid

type Sfp
    int   id
    int   dir
    float trig
    float ext
    int   sweepBar
    int   wickBar
    float rbTop
    float rbBot
    line  confLn

type Setup
    int   dir
    int   stage = 0
    int   legStart
    int   mssBar
    int   mssId
    string mssType = ""
    string reason = "-"
    string zoneEnd = ""

// ═══════════════════════════ SERIES ═══════════════════════════
atr      = ta.atr(14)
rng      = high - low
body     = math.abs(close - open)
brkBuf   = atr * brkBufAtr
eqTol    = atr * eqTolAtr
sweepBuf = atr * swBufAtr
invBuf   = atr * invBufAtr
rbBuf    = atr * rbBufAtr

majPH = ta.pivothigh(high, chochLen, chochLen)
majPL = ta.pivotlow(low, chochLen, chochLen)
intPH = ta.pivothigh(high, idmLen, idmLen)
intPL = ta.pivotlow(low, idmLen, idmLen)
pivTimeMaj = time[chochLen]

dispBull = rng > 0 and close > open and body >= atr * dispMult and close >= high - rng * dispLoc
dispBear = rng > 0 and close < open and body >= atr * dispMult and close <= low + rng * dispLoc

volSma   = ta.sma(volume, volLen)
volAvail = not na(volume) and volume > 0
volOk    = volAvail and not na(volSma[1]) and volume >= volSma[1] * volMult

warm = bar_index > math.max(2 * chochLen, 2 * idmLen, sweepLook + obLook, 20)

// ═══════════════════════════ REQUESTS ═══════════════════════════
htfCalc(int L) =>
    var float h = na
    var float l = na
    var int b = 0
    float ph = ta.pivothigh(high, L, L)
    float pl = ta.pivotlow(low, L, L)
    if not na(ph)
        h := ph
    if not na(pl)
        l := pl
    if not na(h) and close > h
        b := 1
        h := na
    if not na(l) and close < l
        b := -1
        l := na
    b

htfRaw = request.security(syminfo.tickerid, htfTf, htfCalc(chochLen)[1], lookahead = barmerge.lookahead_on)
bool htfTfOk   = timeframe.in_seconds(htfTf) >= timeframe.in_seconds()
bool htfActive = htfOn and htfTfOk
int htfBias    = htfActive ? nz(htfRaw, 0) : 0
bool htfOkBull = not htfActive or (profile == "Strict" ? htfBias == 1 : htfBias != -1)
bool htfOkBear = not htfActive or (profile == "Strict" ? htfBias == -1 : htfBias != 1)

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
bool pdOk = usePD and timeframe.in_seconds() < 86400
bool pwOk = usePW and timeframe.in_seconds() < 604800

mapSym(string r) =>
    switch r
        "XAUUSD" => "XAGUSD"
        "EURUSD" => "GBPUSD"
        "GBPUSD" => "EURUSD"
        "AUDUSD" => "NZDUSD"
        "NZDUSD" => "AUDUSD"
        "USDCHF" => "EURUSD"
        "USDJPY" => "USDCHF"
        => ""

string tk      = syminfo.ticker
string root6   = str.length(tk) >= 6 ? str.upper(str.substring(tk, 0, 6)) : str.upper(tk)
string sfx     = str.length(tk) > 6 ? str.substring(tk, 6) : ""
string autoSym = mapSym(root6)
string cmpSym  = smtMode == "Manual" ? smtManual : autoSym == "" ? "" : syminfo.prefix + ":" + autoSym + sfx
bool cmpInv    = smtMode == "Manual" ? smtInvMan : root6 == "USDCHF"
bool smtHasSym = smtOn and cmpSym != ""
string reqSym  = smtHasSym ? cmpSym : syminfo.tickerid
[cPH, cPL, cTm, cCl] = request.security(reqSym, timeframe.period, [ta.pivothigh(high, chochLen, chochLen), ta.pivotlow(low, chochLen, chochLen), time[chochLen], close], ignore_invalid_symbol = true)
bool smtAvail = smtHasSym and not na(cCl)
int tolMs = smtTol * timeframe.in_seconds() * 1000

// ═══════════════════════════ STATE ═══════════════════════════
var Ctr ctr = Ctr.new()
var Struct majS = Struct.new()
var Struct intS = Struct.new()
var Eng eng = Eng.new()
var array<Pool> pools = array.new<Pool>()
var array<Zone> zones = array.new<Zone>()
var Setup bullSt = Setup.new(1)
var Setup bearSt = Setup.new(-1)
var Sfp bullP = na
var Sfp bearP = na
var int lastDispBull = na
var int lastDispBear = na
var int lastObBullLeft = na
var int lastObBearLeft = na
var int lastDsBull = na
var int lastDsBear = na
var float cHi = na
var float cHiPrev = na
var int cHiT = na
var float cLo = na
var float cLoPrev = na
var int cLoT = na
var int pendBullT = na
var int pendBullBar = na
var int pendBullDl = na
var float pendBullPx = na
var int pendBullPrevBar = na
var float pendBullPrevPx = na
var int pendBearT = na
var int pendBearBar = na
var int pendBearDl = na
var float pendBearPx = na
var int pendBearPrevBar = na
var float pendBearPrevPx = na
var int lastSmtDir = 0
var int lastSmtBar = na

// ═══════════════════════════ HELPERS ═══════════════════════════
method next(Ctr c) =>
    c.n += 1
    c.n

stageName(int s) =>
    switch s
        0 => "NONE"
        4 => "MSS_CONFIRMED"
        5 => "ZONE_WAIT"
        => "?"

biasTxt(int b) =>
    b == 1 ? "Bull" : b == -1 ? "Bear" : "Neutral"

method onPivots(Struct s, float ph, float pl, int R, bool showLbl) =>
    if not na(ph)
        if showLbl and not na(s.lastPH)
            string t = math.abs(ph - s.lastPH) <= eqTol ? "EQH" : ph > s.lastPH ? "HH" : "LH"
            label.new(bar_index - R, ph, t, style = label.style_label_down, color = color(na), textcolor = colBear, size = size.tiny)
        s.lastPH := ph
        s.lastPHBar := bar_index - R
        s.hi := ph
        s.hiBar := bar_index - R
        s.hiState := 0
    if not na(pl)
        if showLbl and not na(s.lastPL)
            string t = math.abs(pl - s.lastPL) <= eqTol ? "EQL" : pl < s.lastPL ? "LL" : "HL"
            label.new(bar_index - R, pl, t, style = label.style_label_up, color = color(na), textcolor = colBull, size = size.tiny)
        s.lastPL := pl
        s.lastPLBar := bar_index - R
        s.lo := pl
        s.loBar := bar_index - R
        s.loState := 0
    true

// simple swing-break structure (neutral start + internal trigger). type 1 BOS, 2 CHoCH, 3 wick-only
method breaks(Struct s, float buf) =>
    int bullT = 0
    int bearT = 0
    float bL = s.hi
    int bLB = s.hiBar
    float sL = s.lo
    int sLB = s.loBar
    bool hiOk = not na(s.hi) and s.hiState != 2
    bool loOk = not na(s.lo) and s.loState != 2
    bool upW = hiOk and high > s.hi + buf
    bool upB = hiOk and close > s.hi + buf
    bool dnW = loOk and low < s.lo - buf
    bool dnB = loOk and close < s.lo - buf
    if upB and not dnB and not dnW
        bullT := s.bias == -1 ? 2 : 1
        s.bias := 1
        s.hiState := 2
    else if dnB and not upB and not upW
        bearT := s.bias == 1 ? 2 : 1
        s.bias := -1
        s.loState := 2
    else if not upB and not dnB
        if upW and not dnW and s.hiState == 0
            bullT := 3
            s.hiState := 1
        if dnW and not upW and s.loState == 0
            bearT := 3
            s.loState := 1
    [bullT, bearT, bL, bLB, sL, sLB]

drawBreak(int fromBar, float lvl, int typ, int d, string tag) =>
    bool show = typ == 3 ? showFake : showMajor
    if show and not na(lvl) and not na(fromBar)
        color c = typ == 3 ? colFake : d == 1 ? colBull : colBear
        string t = (typ == 1 ? "BOS" : typ == 2 ? "CHoCH" : tag) + (typ != 3 and tag != "" ? " · " + tag : "")
        line.new(fromBar, lvl, bar_index, lvl, color = c, style = typ == 1 ? line.style_solid : typ == 2 ? line.style_dashed : line.style_dotted, width = 1)
        label.new(math.round((fromBar + bar_index) / 2), lvl, t, style = d == 1 ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = typ == 3 ? size.tiny : size.small)
    true

// start a new trend phase (after CHoCH or first break). fromBar = bar of the broken level
method startPhase(Eng e, int d, int fromBar) =>
    if not na(e.idmLn) and not e.idmTaken
        e.idmLn.delete()
        if not na(e.idmLb)
            e.idmLb.delete()
    e.trend := d
    e.phaseBar := bar_index
    e.idm := na
    e.idmBar := na
    e.idmTaken := false
    e.idmTakenBar := na
    e.pull := na
    e.pullBar := na
    e.idmLn := na
    e.idmLb := na
    int n = na(fromBar) ? 0 : math.min(math.max(bar_index - fromBar, 0), 300)
    if d == 1
        float lo = low
        int lb = bar_index
        for i = 0 to n
            if low[i] < lo
                lo := low[i]
                lb := bar_index - i
        e.pLo := lo
        e.pLoBar := lb
        e.pHi := na
        e.pHiBar := na
        e.tMax := high
        e.tMaxBar := bar_index
        e.legStart := lb
    else
        float hi = high
        int hb = bar_index
        for i = 0 to n
            if high[i] > hi
                hi := high[i]
                hb := bar_index - i
        e.pHi := hi
        e.pHiBar := hb
        e.pLo := na
        e.pLoBar := na
        e.tMin := low
        e.tMinBar := bar_index
        e.legStart := hb
    true

// continuation BOS: protected level moves to the pullback extreme made after IDM was taken
method contPhase(Eng e) =>
    if e.trend == 1
        e.pLo := e.pull
        e.pLoBar := e.pullBar
        e.legStart := e.pullBar
        e.tMax := high
        e.tMaxBar := bar_index
    else
        e.pHi := e.pull
        e.pHiBar := e.pullBar
        e.legStart := e.pullBar
        e.tMin := low
        e.tMinBar := bar_index
    e.phaseBar := bar_index
    e.idm := na
    e.idmBar := na
    e.idmTaken := false
    e.idmTakenBar := na
    e.pull := na
    e.pullBar := na
    e.idmLn := na
    e.idmLb := na
    true

// IDM drawn like the reference: dotted grey line from the IDM swing to the bar that takes it, label in the middle
drawIdm(Eng e, int d) =>
    if not na(e.idmLn)
        e.idmLn.delete()
    if not na(e.idmLb)
        e.idmLb.delete()
    e.idmLn := na
    e.idmLb := na
    if showIdm and not na(e.idmBar)
        e.idmLn := line.new(e.idmBar, e.idm, bar_index, e.idm, color = colIdmC, style = line.style_dotted, width = 1)
        e.idmLb := label.new(math.round((e.idmBar + bar_index) / 2), e.idm, "IDM", style = d == 1 ? label.style_label_up : label.style_label_down, color = color(na), textcolor = colIdmC, size = size.small)
    true

tfLabel() =>
    int sec = timeframe.in_seconds()
    sec < 3600 ? str.tostring(math.round(sec / 60)) + "M" : sec < 86400 ? str.tostring(math.round(sec / 3600)) + "H" : timeframe.period

addPool(float price, int d, string src, int pbar, float oL, float oH) =>
    bool merged = false
    if src == "SWING" and pools.size() > 0
        for i = 0 to pools.size() - 1
            Pool p = pools.get(i)
            if p.dir == d and (p.src == "SWING" or p.src == "EQ") and math.abs(p.price - price) <= eqTol
                p.touches += 1
                p.src := "EQ"
                p.price := d == 1 ? math.max(p.price, price) : math.min(p.price, price)
                if not na(p.ln)
                    p.ln.set_y1(p.price)
                    p.ln.set_y2(p.price)
                merged := true
                break
    if not merged
        line ln = na
        if showPools
            color c = src == "SWING" ? color.new(colFake, 55) : color.new(colFake, 25)
            ln := line.new(pbar, price, bar_index, price, color = c, style = line.style_dotted)
            if src != "SWING"
                label.new(bar_index, price, src, style = label.style_label_left, color = color(na), textcolor = colFake, size = size.tiny)
        pools.push(Pool.new(id = ctr.next(), price = price, dir = d, src = src, pbar = pbar, created = bar_index, oLow = oL, oHigh = oH, ln = ln))
        if pools.size() > 120
            pools.shift()
    merged

zoneText(Zone z) =>
    z.kind == K_RB ? "RJB" : tfLabel() + " " + (z.dir == 1 ? "Demand" : "Supply") + (z.kind == K_OB ? (z.sweep and z.imb ? " OB A+" : " OB") : "")

drawZone(Zone z) =>
    if na(z.bx)
        color base = z.dir == 1 ? colBull : colBear
        int tr = z.kind == K_OB ? 85 : z.kind == K_DS ? 90 : 88
        int right = z.kind == K_RB ? z.leftBar + rbLen : bar_index + 1
        z.bx := box.new(z.leftBar, z.top, right, z.bot, border_color = color.new(base, 50), border_width = 1, bgcolor = color.new(base, tr), text = zoneText(z), text_size = size.tiny, text_color = color.new(base, 20), text_halign = text.align_right, text_valign = text.align_top)
        if showMid and z.kind != K_RB
            float m = (z.top + z.bot) / 2
            z.mid := line.new(z.leftBar, m, right, m, color = color.new(base, 30), style = line.style_dashed, width = 1)
    true

newZone(int kind, int d, float top, float bot, int left, float inv, int dispB, bool show) =>
    Zone z = Zone.new(id = ctr.next(), kind = kind, dir = d, top = top, bot = bot, invLvl = inv, leftBar = left, createdBar = bar_index, dispBar = dispB)
    if show
        drawZone(z)
    zones.push(z)
    if zones.size() > 200
        zones.shift()
    z

method reset(Setup st, string why) =>
    st.stage := S_NONE
    st.reason := why
    if debugOn and why != "ENTRY_DONE"
        label.new(bar_index, st.dir == 1 ? low : high, (st.dir == 1 ? "Bull: " : "Bear: ") + why, style = st.dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(colFake, 30), textcolor = color.white, size = size.tiny)
    true

// link OB A+ / Demand-Supply created inside this MSS leg. returns [linked, newOB, newDS]
method link(Setup st) =>
    int n = 0
    bool nOb = false
    bool nDs = false
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            Zone z = zones.get(i)
            if z.dir == st.dir and z.kind != K_RB
                if na(z.srcId) and not na(z.dispBar) and z.dispBar > st.legStart and z.dispBar <= st.mssBar
                    bool ok = z.kind == K_DS or obFilter == "All" or ((not reqSweep or z.sweep) and (not reqImb or z.imb))
                    if ok
                        z.srcId := st.mssId
                        drawZone(z)
                        if z.kind == K_OB
                            nOb := true
                        else
                            nDs := true
                if not na(z.srcId) and z.srcId == st.mssId
                    n += 1
    [n, nOb, nDs]

dsOverlap(Zone z, int mid) =>
    bool ov = false
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            Zone y = zones.get(i)
            if y.kind == K_DS and y.dir == z.dir and not na(y.srcId) and y.srcId == mid and y.top >= z.bot and y.bot <= z.top
                ov := true
                break
    ov

// zone wait -> entry. returns [fire, zone, triggerName]
method entry(Setup st, bool intBrk, bool sfpNow, float sfpExt) =>
    bool fire = false
    string trig = ""
    Zone hit = na
    if st.stage == S_ZONE
        int live = 0
        if zones.size() > 0
            for i = 0 to zones.size() - 1
                Zone z = zones.get(i)
                if z.dir == st.dir and not na(z.srcId) and z.srcId == st.mssId
                    live += 1
                    bool allowed = zoneMode == "OB A+ or D/S" or (zoneMode == "OB A+ only" and z.kind == K_OB) or (zoneMode == "D/S only" and z.kind == K_DS) or (zoneMode == "OB A+ overlapping D/S" and z.kind == K_OB and dsOverlap(z, st.mssId))
                    if allowed and not fire and z.createdBar < bar_index
                        bool rc = rng > 0 and (st.dir == 1 ? (low <= z.top and close > z.top and close >= low + 0.5 * rng) : (high >= z.bot and close < z.bot and close <= high - 0.5 * rng))
                        bool im = intBrk and not na(z.firstTouch) and z.firstTouch < bar_index and bar_index - z.firstTouch <= trigMax
                        bool sf = sfpNow and not na(sfpExt) and sfpExt <= z.top and sfpExt >= z.bot
                        bool t = trigMode == "Rejection Candle" ? rc : trigMode == "Internal MSS" ? im : trigMode == "SFP" ? sf : (rc or im or sf)
                        if t
                            fire := true
                            hit := z
                            trig := trigMode != "Any enabled trigger" ? trigMode : rc ? "Rejection Candle" : im ? "Internal MSS" : "SFP"
        if live == 0 and bar_index > st.mssBar + 1
            st.reset(st.zoneEnd == "" ? "ZONE_EXPIRED" : st.zoneEnd)
    [fire, hit, trig]

// 0 pending, 1 confirmed by body, 2 confirmed by wick + strong volume, 3 invalidated, 4 expired
method adv(Sfp p) =>
    int r = 0
    int d = p.dir
    if bar_index > p.sweepBar
        bool inv = d == -1 ? close > p.ext : close < p.ext
        if inv
            r := 3
        else if bar_index - p.sweepBar > sfpMax
            r := 4
        else
            if not na(p.wickBar) and bar_index == p.wickBar + 1
                bool dirOk = not volDirReq or (d == -1 ? close < open : close > open)
                if volOk and dirOk
                    r := 2
                p.wickBar := na
            if r == 0
                bool bodyBrk = d == -1 ? close < p.trig : close > p.trig
                bool wickBrk = d == -1 ? low < p.trig : high > p.trig
                if bodyBrk
                    r := 1
                else if wickBrk
                    p.wickBar := bar_index
    r

drawSfp(int d, int how) =>
    if showSfp
        color c = d == 1 ? colBull : colBear
        label.new(bar_index, d == 1 ? low : high, how == 2 ? "SFP (vol)" : "SFP", style = d == 1 ? label.style_label_up : label.style_label_down, color = c, textcolor = d == 1 ? color.black : color.white, size = size.small)
    true

dashRow(table tb, int r, string k, string v, color vc) =>
    tb.cell(0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    tb.cell(1, r, v, text_color = vc, text_size = size.small, text_halign = text.align_left)
    true

// ═══════════════════════════ MAIN (closed candles only) ═══════════════════════════
bool evBullBOS = false
bool evBearBOS = false
bool evBullCH = false
bool evBearCH = false
bool evFake = false
bool evMssBull = false
bool evMssBear = false
bool evSweep = false
bool evIdmCand = false
bool evIdmSwept = false
bool evSfpBull = false
bool evSfpBear = false
bool evNewOB = false
bool evNewDS = false
bool evMitig = false
bool evSmtBull = false
bool evSmtBear = false
bool evEntryBull = false
bool evEntryBear = false
string msg = ""

if barstate.isconfirmed and warm
    // 1. confirmed swings + liquidity pools
    float prevMajPL = majS.lastPL
    float prevMajPH = majS.lastPH
    int prevMajPLBar = majS.lastPLBar
    int prevMajPHBar = majS.lastPHBar
    majS.onPivots(majPH, majPL, chochLen, showSw)
    intS.onPivots(intPH, intPL, idmLen, false)
    if liqMajor and not na(majPH)
        addPool(majPH, 1, "SWING", bar_index - chochLen, low[chochLen], high[chochLen])
    if liqMajor and not na(majPL)
        addPool(majPL, -1, "SWING", bar_index - chochLen, low[chochLen], high[chochLen])
    if pdOk and not na(pdh) and pdh != pdh[1]
        addPool(pdh, 1, "PDH", bar_index, na, na)
        addPool(pdl, -1, "PDL", bar_index, na, na)
    if pwOk and not na(pwh) and pwh != pwh[1]
        addPool(pwh, 1, "PWH", bar_index, na, na)
        addPool(pwl, -1, "PWL", bar_index, na, na)

    if dispBull
        lastDispBull := bar_index
    if dispBear
        lastDispBear := bar_index

    // 2. structure engine: CHoCH / BOS / IDM
    float eLvl = na
    int eLvlBar = na
    if eng.trend == 0
        // first break from neutral: body close = BOS, wick only = Fake BOS
        [nbT, nsT, nbL, nbLB, nsL, nsLB] = majS.breaks(brkBuf)
        if nbT == 1
            evBullBOS := true
            eLvl := nbL
            eLvlBar := nbLB
            eng.startPhase(1, nbLB)
        else if nsT == 1
            evBearBOS := true
            eLvl := nsL
            eLvlBar := nsLB
            eng.startPhase(-1, nsLB)
        else
            if nbT == 3
                evFake := true
                drawBreak(nbLB, nbL, 3, 1, "Fake BOS")
            if nsT == 3
                evFake := true
                drawBreak(nsLB, nsL, 3, -1, "Fake BOS")
    else if eng.trend == 1
        bool choch = not na(eng.pLo) and close < eng.pLo - brkBuf
        bool bos = not choch and eng.idmTaken and close > eng.tMax + brkBuf
        if choch
            evBearCH := true
            eLvl := eng.pLo
            eLvlBar := eng.pLoBar
            eng.startPhase(-1, eng.tMaxBar)
        else if bos
            evBullBOS := true
            eLvl := eng.tMax
            eLvlBar := eng.tMaxBar
            eng.contPhase()
        else
            if not na(eng.pLo) and low < eng.pLo - brkBuf and (na(eng.sweptLo) or eng.sweptLo != eng.pLoBar)
                eng.sweptLo := eng.pLoBar
                evFake := true
                drawBreak(eng.pLoBar, eng.pLo, 3, -1, "x")
            if eng.idmTaken and high > eng.tMax + brkBuf and (na(eng.sweptHi) or eng.sweptHi != eng.tMaxBar)
                eng.sweptHi := eng.tMaxBar
                evFake := true
                drawBreak(eng.tMaxBar, eng.tMax, 3, 1, "x")
            if high > eng.tMax
                eng.tMax := high
                eng.tMaxBar := bar_index
            if not eng.idmTaken
                if not na(intPL) and bar_index - idmLen > eng.phaseBar
                    if not na(eng.idmLn)
                        eng.idmLn.delete()
                    if not na(eng.idmLb)
                        eng.idmLb.delete()
                    eng.idm := intPL
                    eng.idmBar := bar_index - idmLen
                    evIdmCand := true
                    if showIdmPend
                        eng.idmLn := line.new(eng.idmBar, eng.idm, bar_index, eng.idm, color = colIdmC, style = line.style_dashed, width = 1)
                        eng.idmLb := label.new(eng.idmBar, eng.idm, "IDM?", style = label.style_label_up, color = color(na), textcolor = colIdmC, size = size.tiny)
                else if not na(eng.idm) and low < eng.idm - sweepBuf and (not idmReclaim or close > eng.idm)
                    eng.idmTaken := true
                    eng.idmTakenBar := bar_index
                    eng.pull := low
                    eng.pullBar := bar_index
                    evIdmSwept := true
                    drawIdm(eng, 1)
                else if not na(eng.idmLn)
                    eng.idmLn.set_x2(bar_index)
            else if low < eng.pull
                eng.pull := low
                eng.pullBar := bar_index
    else
        bool choch = not na(eng.pHi) and close > eng.pHi + brkBuf
        bool bos = not choch and eng.idmTaken and close < eng.tMin - brkBuf
        if choch
            evBullCH := true
            eLvl := eng.pHi
            eLvlBar := eng.pHiBar
            eng.startPhase(1, eng.tMinBar)
        else if bos
            evBearBOS := true
            eLvl := eng.tMin
            eLvlBar := eng.tMinBar
            eng.contPhase()
        else
            if not na(eng.pHi) and high > eng.pHi + brkBuf and (na(eng.sweptHi) or eng.sweptHi != eng.pHiBar)
                eng.sweptHi := eng.pHiBar
                evFake := true
                drawBreak(eng.pHiBar, eng.pHi, 3, 1, "x")
            if eng.idmTaken and low < eng.tMin - brkBuf and (na(eng.sweptLo) or eng.sweptLo != eng.tMinBar)
                eng.sweptLo := eng.tMinBar
                evFake := true
                drawBreak(eng.tMinBar, eng.tMin, 3, -1, "x")
            if low < eng.tMin
                eng.tMin := low
                eng.tMinBar := bar_index
            if not eng.idmTaken
                if not na(intPH) and bar_index - idmLen > eng.phaseBar
                    if not na(eng.idmLn)
                        eng.idmLn.delete()
                    if not na(eng.idmLb)
                        eng.idmLb.delete()
                    eng.idm := intPH
                    eng.idmBar := bar_index - idmLen
                    evIdmCand := true
                    if showIdmPend
                        eng.idmLn := line.new(eng.idmBar, eng.idm, bar_index, eng.idm, color = colIdmC, style = line.style_dashed, width = 1)
                        eng.idmLb := label.new(eng.idmBar, eng.idm, "IDM?", style = label.style_label_down, color = color(na), textcolor = colIdmC, size = size.tiny)
                else if not na(eng.idm) and high > eng.idm + sweepBuf and (not idmReclaim or close < eng.idm)
                    eng.idmTaken := true
                    eng.idmTakenBar := bar_index
                    eng.pull := high
                    eng.pullBar := bar_index
                    evIdmSwept := true
                    drawIdm(eng, -1)
                else if not na(eng.idmLn)
                    eng.idmLn.set_x2(bar_index)
            else if high > eng.pull
                eng.pull := high
                eng.pullBar := bar_index

    // 3. MSS = BOS (after IDM) or CHoCH, with displacement -> setup
    bool bullBrk = evBullBOS or (mssCh and evBullCH)
    bool bearBrk = evBearBOS or (mssCh and evBearCH)
    bool bullDispOk = dispWin == 0 ? dispBull : (not na(lastDispBull) and lastDispBull > eng.legStart and bar_index - lastDispBull <= dispWin)
    bool bearDispOk = dispWin == 0 ? dispBear : (not na(lastDispBear) and lastDispBear > eng.legStart and bar_index - lastDispBear <= dispWin)
    evMssBull := bullBrk and bullDispOk and htfOkBull
    evMssBear := bearBrk and bearDispOk and htfOkBear
    if evBullBOS or evBullCH
        drawBreak(eLvlBar, eLvl, evBullBOS ? 1 : 2, 1, evMssBull ? "MSS" : "")
    if evBearBOS or evBearCH
        drawBreak(eLvlBar, eLvl, evBearBOS ? 1 : 2, -1, evMssBear ? "MSS" : "")
    if evBearCH and bullSt.stage != S_NONE
        bullSt.reset("PROTECTED_BROKEN")
    if evBullCH and bearSt.stage != S_NONE
        bearSt.reset("PROTECTED_BROKEN")
    if evMssBull
        bullSt.stage := S_MSS
        bullSt.legStart := eng.legStart
        bullSt.mssBar := bar_index
        bullSt.mssId := ctr.next()
        bullSt.mssType := evBullBOS ? "BOS" : "CHoCH"
        bullSt.zoneEnd := ""
    if evMssBear
        bearSt.stage := S_MSS
        bearSt.legStart := eng.legStart
        bearSt.mssBar := bar_index
        bearSt.mssId := ctr.next()
        bearSt.mssType := evBearBOS ? "BOS" : "CHoCH"
        bearSt.zoneEnd := ""

    // 4. internal structure (for the Internal MSS trigger)
    [ibT, isT, ibL, ibLB, isL, isLB] = intS.breaks(brkBuf)
    bool intBullBrk = ibT == 1 or ibT == 2
    bool intBearBrk = isT == 1 or isT == 2

    // 5. liquidity sweeps
    Pool bslP = na
    Pool sslP = na
    if pools.size() > 0
        for i = pools.size() - 1 to 0
            Pool p = pools.get(i)
            bool rem = false
            if p.created < bar_index
                if p.dir == 1
                    if high > p.price + sweepBuf and close < p.price
                        if na(bslP) or p.price > bslP.price
                            bslP := p
                        rem := true
                    else if close > p.price
                        rem := true
                else
                    if low < p.price - sweepBuf and close > p.price
                        if na(sslP) or p.price < sslP.price
                            sslP := p
                        rem := true
                    else if close < p.price
                        rem := true
                if not rem and bar_index - p.created > poolMax
                    rem := true
            if rem
                if not na(p.ln)
                    p.ln.delete()
                pools.remove(i)
            else if not na(p.ln)
                p.ln.set_x2(bar_index)
    bool sweepAmb = not na(bslP) and not na(sslP)
    int bslSweepId = na
    int sslSweepId = na
    if not sweepAmb and not na(bslP)
        bslSweepId := ctr.next()
        evSweep := true
        if showSwp
            line.new(bslP.pbar, bslP.price, bar_index, bslP.price, color = colBear, width = 1)
            line.new(bar_index, math.max(open, close), bar_index, high, color = colBear, width = 3)
    if not sweepAmb and not na(sslP)
        sslSweepId := ctr.next()
        evSweep := true
        if showSwp
            line.new(sslP.pbar, sslP.price, bar_index, sslP.price, color = colBull, width = 1)
            line.new(bar_index, math.min(open, close), bar_index, low, color = colBull, width = 3)

    // 6. lifecycle of existing zones (before new zones are added)
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            if z.createdBar < bar_index
                bool touched = z.dir == 1 ? low <= z.top : high >= z.bot
                if touched and na(z.firstTouch)
                    z.firstTouch := bar_index
                float h = z.top - z.bot
                float depth = h > 0 ? (z.dir == 1 ? (z.top - low) / h : (high - z.bot) / h) : (touched ? 1.0 : 0.0)
                bool mit = mitMode == "Touch" ? touched : mitMode == "50%" ? depth >= 0.5 : depth >= 1.0
                float buf = z.kind == K_RB ? rbBuf : invBuf
                bool wickRm = zoneRemove == "Wick through" and z.kind != K_RB
                bool inv = z.dir == 1 ? (wickRm ? low : close) < z.invLvl - buf : (wickRm ? high : close) > z.invLvl + buf
                bool expd = bar_index - z.createdBar > zoneMax
                if z.state == 0 and mit and not inv
                    z.state := 1
                    if not na(z.srcId) and z.kind != K_RB
                        evMitig := true
                    if not na(z.bx)
                        if zoneView == "Fresh only"
                            z.bx.delete()
                            z.bx := na
                            if not na(z.mid)
                                z.mid.delete()
                                z.mid := na
                        else
                            z.bx.set_bgcolor(color.new(z.dir == 1 ? colBull : colBear, 94))
                // All active: the box shrinks as price trades into it
                if zoneView == "All active" and touched and not inv and not na(z.bx) and z.kind != K_RB
                    if z.dir == 1
                        z.bx.set_top(math.max(z.bot, math.min(z.bx.get_top(), low)))
                    else
                        z.bx.set_bottom(math.min(z.top, math.max(z.bx.get_bottom(), high)))
                if inv or expd
                    string why = inv ? "ZONE_INVALIDATED" : "ZONE_EXPIRED"
                    if not na(z.srcId)
                        if z.dir == 1 and not na(bullSt.mssId) and z.srcId == bullSt.mssId
                            bullSt.zoneEnd := why
                        if z.dir == -1 and not na(bearSt.mssId) and z.srcId == bearSt.mssId
                            bearSt.zoneEnd := why
                    if not na(z.bx)
                        z.bx.set_right(bar_index)
                        if keepInv and inv
                            z.bx.set_bgcolor(color.new(colFake, 88))
                            z.bx.set_border_color(color.new(colFake, 60))
                        else
                            z.bx.delete()
                    if not na(z.mid)
                        z.mid.delete()
                    zones.remove(i)
                else if not na(z.bx) and z.kind != K_RB
                    z.bx.set_right(bar_index + 1)
                    if not na(z.mid)
                        z.mid.set_x2(bar_index + 1)
                // imbalance can complete one bar after the displacement candle
                if z.kind == K_OB and not z.imb and not na(z.dispBar) and z.dispBar == bar_index - 1
                    if z.dir == 1 ? (low > high[2] and low - high[2] >= atr * imbMinAtr) : (high < low[2] and low[2] - high >= atr * imbMinAtr)
                        z.imb := true

    // 7. new Order Blocks (graded) and Demand / Supply zones
    if dispBull
        int src = na
        for i = 1 to obLook
            if close[i] < open[i]
                src := i
                break
        if not na(src) and bar_index - src != lastObBullLeft
            lastObBullLeft := bar_index - src
            float legLow = low
            for j = 0 to src
                legLow := math.min(legLow, low[j])
            float prior = low[src + 1]
            for j = src + 1 to src + sweepLook
                prior := math.min(prior, low[j])
            Zone z = newZone(K_OB, 1, open[src], low[src], bar_index - src, low[src], bar_index, showAllZ)
            z.sweep := legLow < prior
            z.imb := low > high[2] and low - high[2] >= atr * imbMinAtr
    if dispBear
        int src = na
        for i = 1 to obLook
            if close[i] > open[i]
                src := i
                break
        if not na(src) and bar_index - src != lastObBearLeft
            lastObBearLeft := bar_index - src
            float legHigh = high
            for j = 0 to src
                legHigh := math.max(legHigh, high[j])
            float prior = high[src + 1]
            for j = src + 1 to src + sweepLook
                prior := math.max(prior, high[j])
            Zone z = newZone(K_OB, -1, high[src], open[src], bar_index - src, high[src], bar_index, showAllZ)
            z.sweep := legHigh > prior
            z.imb := high < low[2] and low[2] - high >= atr * imbMinAtr
    if dsOn and dispBull
        int nb = 0
        float top = na
        float bot = na
        for i = 1 to dsMaxBase
            if rng[i] > 0 and math.abs(close[i] - open[i]) <= rng[i] * dsBasePct
                nb += 1
                top := na(top) ? math.max(open[i], close[i]) : math.max(top, math.max(open[i], close[i]))
                bot := na(bot) ? low[i] : math.min(bot, low[i])
            else
                break
        if nb > 0 and top > bot and (na(lastDsBull) or bar_index - 1 != lastDsBull)
            lastDsBull := bar_index
            newZone(K_DS, 1, top, bot, bar_index - nb, bot, bar_index, showAllZ)
    if dsOn and dispBear
        int nb = 0
        float top = na
        float bot = na
        for i = 1 to dsMaxBase
            if rng[i] > 0 and math.abs(close[i] - open[i]) <= rng[i] * dsBasePct
                nb += 1
                top := na(top) ? high[i] : math.max(top, high[i])
                bot := na(bot) ? math.min(open[i], close[i]) : math.min(bot, math.min(open[i], close[i]))
            else
                break
        if nb > 0 and top > bot and (na(lastDsBear) or bar_index - 1 != lastDsBear)
            lastDsBear := bar_index
            newZone(K_DS, -1, top, bot, bar_index - nb, top, bar_index, showAllZ)

    // 8. SFP (advance pending first, then register new sweeps) + Rejection Blocks
    bool sfpBullNow = false
    bool sfpBearNow = false
    float sfpBullExt = na
    float sfpBearExt = na
    if not na(bearP)
        int r = bearP.adv()
        if r == 1 or r == 2
            evSfpBear := true
            sfpBearNow := true
            sfpBearExt := bearP.ext
            drawSfp(-1, r)
            if not na(bearP.confLn)
                bearP.confLn.set_x2(bar_index)
            if rbAt == "SFP confirmed" and bearP.rbTop > bearP.rbBot
                newZone(K_RB, -1, bearP.rbTop, bearP.rbBot, bearP.sweepBar, bearP.ext, na, showRB)
            bearP := na
        else if r >= 3
            if not na(bearP.confLn)
                bearP.confLn.delete()
            bearP := na
        else if not na(bearP.confLn)
            bearP.confLn.set_x2(bar_index)
    if not na(bullP)
        int r = bullP.adv()
        if r == 1 or r == 2
            evSfpBull := true
            sfpBullNow := true
            sfpBullExt := bullP.ext
            drawSfp(1, r)
            if not na(bullP.confLn)
                bullP.confLn.set_x2(bar_index)
            if rbAt == "SFP confirmed" and bullP.rbTop > bullP.rbBot
                newZone(K_RB, 1, bullP.rbTop, bullP.rbBot, bullP.sweepBar, bullP.ext, na, showRB)
            bullP := na
        else if r >= 3
            if not na(bullP.confLn)
                bullP.confLn.delete()
            bullP := na
        else if not na(bullP.confLn)
            bullP.confLn.set_x2(bar_index)
    if not na(bslSweepId)
        // bearish RJB = upper rejection wick of the sweep candle (Wick), its body (Body) or the whole candle (Full)
        float rTop = rbMode == "Body" ? math.max(open, close) : high
        float rBot = rbMode == "Full" ? low : rbMode == "Body" ? math.min(open, close) : math.max(open, close)
        if sfpOn
            if not na(bearP) and not na(bearP.confLn)
                bearP.confLn.delete()
            float trg = sfpTrig == "Sweep candle" ? low : nz(bslP.oLow, low)
            line cl = showSwp ? line.new(bar_index, trg, bar_index + 1, trg, color = colBear, style = line.style_dotted, width = 1) : na
            bearP := Sfp.new(bslSweepId, -1, trg, high, bar_index, na, rTop, rBot, cl)
            if sfpTrig != "Sweep candle" and close < trg
                evSfpBear := true
                sfpBearNow := true
                sfpBearExt := high
                drawSfp(-1, 1)
                if rbAt == "SFP confirmed" and rTop > rBot
                    newZone(K_RB, -1, rTop, rBot, bar_index, high, na, showRB)
                bearP := na
        if rbAt == "Liquidity sweep" and rTop > rBot
            newZone(K_RB, -1, rTop, rBot, bar_index, high, na, showRB)
    if not na(sslSweepId)
        // bullish RJB = lower rejection wick of the sweep candle (Wick), its body (Body) or the whole candle (Full)
        float rTop = rbMode == "Full" ? high : rbMode == "Body" ? math.max(open, close) : math.min(open, close)
        float rBot = rbMode == "Body" ? math.min(open, close) : low
        if sfpOn
            if not na(bullP) and not na(bullP.confLn)
                bullP.confLn.delete()
            float trg = sfpTrig == "Sweep candle" ? high : nz(sslP.oHigh, high)
            line cl = showSwp ? line.new(bar_index, trg, bar_index + 1, trg, color = colBull, style = line.style_dotted, width = 1) : na
            bullP := Sfp.new(sslSweepId, 1, trg, low, bar_index, na, rTop, rBot, cl)
            if sfpTrig != "Sweep candle" and close > trg
                evSfpBull := true
                sfpBullNow := true
                sfpBullExt := low
                drawSfp(1, 1)
                if rbAt == "SFP confirmed" and rTop > rBot
                    newZone(K_RB, 1, rTop, rBot, bar_index, low, na, showRB)
                bullP := na
        if rbAt == "Liquidity sweep" and rTop > rBot
            newZone(K_RB, 1, rTop, rBot, bar_index, low, na, showRB)

    // 9. link OB A+ / D/S zones to the MSS leg
    if (bullSt.stage == S_MSS or bullSt.stage == S_ZONE) and bar_index <= bullSt.mssBar + 1
        [n, nOb, nDs] = bullSt.link()
        evNewOB := evNewOB or nOb
        evNewDS := evNewDS or nDs
        if n > 0 and bullSt.stage == S_MSS
            bullSt.stage := S_ZONE
        else if n == 0 and bullSt.stage == S_MSS and bar_index == bullSt.mssBar + 1
            bullSt.reset("NO_LINKED_ZONE")
    if (bearSt.stage == S_MSS or bearSt.stage == S_ZONE) and bar_index <= bearSt.mssBar + 1
        [n, nOb, nDs] = bearSt.link()
        evNewOB := evNewOB or nOb
        evNewDS := evNewDS or nDs
        if n > 0 and bearSt.stage == S_MSS
            bearSt.stage := S_ZONE
        else if n == 0 and bearSt.stage == S_MSS and bar_index == bearSt.mssBar + 1
            bearSt.reset("NO_LINKED_ZONE")

    // 10. SMT (line drawn between the two chart swings)
    if smtAvail
        if not na(cPH)
            cHiPrev := cHi
            cHi := cPH
            cHiT := cTm
        if not na(cPL)
            cLoPrev := cLo
            cLo := cPL
            cLoT := cTm
        if not na(majPL) and not na(prevMajPL) and majPL < prevMajPL
            pendBullT := pivTimeMaj
            pendBullBar := bar_index - chochLen
            pendBullDl := bar_index + smtTol
            pendBullPx := majPL
            pendBullPrevBar := prevMajPLBar
            pendBullPrevPx := prevMajPL
        if not na(majPH) and not na(prevMajPH) and majPH > prevMajPH
            pendBearT := pivTimeMaj
            pendBearBar := bar_index - chochLen
            pendBearDl := bar_index + smtTol
            pendBearPx := majPH
            pendBearPrevBar := prevMajPHBar
            pendBearPrevPx := prevMajPH
        if not na(pendBullT)
            float cn = cmpInv ? cHi : cLo
            float cp = cmpInv ? cHiPrev : cLoPrev
            int ct = cmpInv ? cHiT : cLoT
            if not na(ct) and not na(cp) and math.abs(ct - pendBullT) <= tolMs
                if cmpInv ? cn <= cp : cn >= cp
                    evSmtBull := true
                    lastSmtDir := 1
                    lastSmtBar := bar_index
                    if showSmt
                        line.new(pendBullPrevBar, pendBullPrevPx, pendBullBar, pendBullPx, color = colBull, style = line.style_solid, width = 1)
                        label.new(pendBullBar, pendBullPx, "SMT", style = label.style_label_up, color = color(na), textcolor = colBull, size = size.tiny)
                pendBullT := na
            else if bar_index > pendBullDl
                pendBullT := na
        if not na(pendBearT)
            float cn = cmpInv ? cLo : cHi
            float cp = cmpInv ? cLoPrev : cHiPrev
            int ct = cmpInv ? cLoT : cHiT
            if not na(ct) and not na(cp) and math.abs(ct - pendBearT) <= tolMs
                if cmpInv ? cn >= cp : cn <= cp
                    evSmtBear := true
                    lastSmtDir := -1
                    lastSmtBar := bar_index
                    if showSmt
                        line.new(pendBearPrevBar, pendBearPrevPx, pendBearBar, pendBearPx, color = colBear, style = line.style_solid, width = 1)
                        label.new(pendBearBar, pendBearPx, "SMT", style = label.style_label_down, color = color(na), textcolor = colBear, size = size.tiny)
                pendBearT := na
            else if bar_index > pendBearDl
                pendBearT := na

    // 11. entries (drawn as a zone)
    [fb, zb, tb] = bullSt.entry(intBullBrk, sfpBullNow, sfpBullExt)
    [fs, zs, ts] = bearSt.entry(intBearBrk, sfpBearNow, sfpBearExt)
    bool conflict = fb and fs
    if conflict and debugOn
        label.new(bar_index, high, "CONFLICT: both directions", style = label.style_label_down, color = colFake, textcolor = color.white, size = size.tiny)
    string smtB = not smtAvail ? "N/A" : lastSmtDir == 1 and bar_index - lastSmtBar <= 50 ? "yes (bull)" : "no"
    string smtS = not smtAvail ? "N/A" : lastSmtDir == -1 and bar_index - lastSmtBar <= 50 ? "yes (bear)" : "no"
    if fb and not conflict and profile != "Context-only"
        box.new(bar_index, zb.top, bar_index + entryLen, zb.bot, border_color = colBull, border_width = 1, bgcolor = color.new(colBull, 75), text = "BUY · " + zoneText(zb), text_size = size.tiny, text_color = color.black, text_halign = text.align_left, text_valign = text.align_center)
        if showCk
            string ck = "HTF: " + (htfActive ? biasTxt(htfBias) : "N/A (off)") + "\nMSS: " + bullSt.mssType + " + displacement\nZone: " + zoneText(zb) + "\nTrigger: " + tb + "\nSMT (info): " + smtB
            label.new(bar_index, zb.bot, "i", style = label.style_circle, color = colBull, textcolor = color.black, size = size.tiny, tooltip = ck)
        evEntryBull := true
        bullSt.reset("ENTRY_DONE")
    if fs and not conflict and profile != "Context-only"
        box.new(bar_index, zs.top, bar_index + entryLen, zs.bot, border_color = colBear, border_width = 1, bgcolor = color.new(colBear, 70), text = "SELL · " + zoneText(zs), text_size = size.tiny, text_color = color.white, text_halign = text.align_left, text_valign = text.align_center)
        if showCk
            string ck = "HTF: " + (htfActive ? biasTxt(htfBias) : "N/A (off)") + "\nMSS: " + bearSt.mssType + " + displacement\nZone: " + zoneText(zs) + "\nTrigger: " + ts + "\nSMT (info): " + smtS
            label.new(bar_index, zs.top, "i", style = label.style_circle, color = colBear, textcolor = color.white, size = size.tiny, tooltip = ck)
        evEntryBear := true
        bearSt.reset("ENTRY_DONE")

    msg := (evEntryBull ? "BUY entry. " : "") + (evEntryBear ? "SELL entry. " : "") + (evMssBull ? "Bull MSS. " : "") + (evMssBear ? "Bear MSS. " : "") + (evSfpBull ? "Bull SFP. " : "") + (evSfpBear ? "Bear SFP. " : "") + (evBullCH ? "Bull CHoCH. " : "") + (evBearCH ? "Bear CHoCH. " : "") + (evBullBOS ? "Bull BOS. " : "") + (evBearBOS ? "Bear BOS. " : "") + (evSmtBull ? "Bull SMT. " : "") + (evSmtBear ? "Bear SMT. " : "")

if msg != ""
    alert(syminfo.ticker + " " + timeframe.period + ": " + msg + "Close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ═══════════════════════════ ALERT CONDITIONS ═══════════════════════════
alertcondition(evBullBOS, "Bullish BOS", "SMC {{ticker}} {{interval}}: bullish BOS")
alertcondition(evBearBOS, "Bearish BOS", "SMC {{ticker}} {{interval}}: bearish BOS")
alertcondition(evBullCH, "Bullish CHoCH", "SMC {{ticker}} {{interval}}: bullish CHoCH")
alertcondition(evBearCH, "Bearish CHoCH", "SMC {{ticker}} {{interval}}: bearish CHoCH")
alertcondition(evFake, "Structure sweep / Fake BOS", "SMC {{ticker}} {{interval}}: wick-only structure sweep")
alertcondition(evMssBull, "Bullish MSS", "SMC {{ticker}} {{interval}}: bullish MSS")
alertcondition(evMssBear, "Bearish MSS", "SMC {{ticker}} {{interval}}: bearish MSS")
alertcondition(evSweep, "Liquidity sweep", "SMC {{ticker}} {{interval}}: liquidity sweep")
alertcondition(evIdmCand, "New IDM", "SMC {{ticker}} {{interval}}: new IDM")
alertcondition(evIdmSwept, "IDM taken", "SMC {{ticker}} {{interval}}: IDM taken")
alertcondition(evSfpBull, "Bullish SFP", "SMC {{ticker}} {{interval}}: bullish SFP")
alertcondition(evSfpBear, "Bearish SFP", "SMC {{ticker}} {{interval}}: bearish SFP")
alertcondition(evNewOB, "New OB A+", "SMC {{ticker}} {{interval}}: new OB A+ linked to MSS")
alertcondition(evNewDS, "New Demand / Supply", "SMC {{ticker}} {{interval}}: new Demand/Supply linked to MSS")
alertcondition(evMitig, "Zone mitigation", "SMC {{ticker}} {{interval}}: entry zone touched")
alertcondition(evSmtBull or evSmtBear, "SMT divergence", "SMC {{ticker}} {{interval}}: SMT divergence")
alertcondition(evEntryBull, "BUY entry", "SMC {{ticker}} {{interval}}: confirmed BUY setup")
alertcondition(evEntryBear, "SELL entry", "SMC {{ticker}} {{interval}}: confirmed SELL setup")

// ═══════════════════════════ DASHBOARD ═══════════════════════════
var table dash = table.new(position.top_right, 2, 14, bgcolor = color.new(#131722, 10), border_color = color.new(#363a45, 0), border_width = 1)
if barstate.islast and showDash
    string htfTxt = not htfOn ? "Off" : not htfTfOk ? "Disabled: TF lower than chart (Phase 2)" : htfTf + " " + biasTxt(htfBias)
    string smtTxt = not smtOn ? "Off" : not smtHasSym ? "N/A (no pair for " + root6 + ", use Manual)" : not smtAvail ? "N/A (" + cmpSym + " not found)" : cmpSym + (cmpInv ? " inverse" : " direct") + " | last: " + (lastSmtDir == 1 ? "bull" : lastSmtDir == -1 ? "bear" : "-")
    string idmTxt = na(eng.idm) ? "-" : str.tostring(eng.idm, format.mintick) + (eng.idmTaken ? " (taken, BOS allowed)" : " (waiting)")
    bool counter = htfActive and htfBias != 0 and eng.trend != 0 and htfBias != eng.trend
    dashRow(dash, 0, "SMC Suite v1.4", profile, color.white)
    dashRow(dash, 1, "Entry trigger / zone", trigMode + " / " + zoneMode, color.white)
    dashRow(dash, 2, "Detection TF", "Chart TF (" + timeframe.period + ")", color.white)
    dashRow(dash, 3, "HTF context", htfTxt, htfBias == 1 ? colBull : htfBias == -1 ? colBear : color.white)
    dashRow(dash, 4, "Trend (CHoCH/BOS)", biasTxt(eng.trend), eng.trend == 1 ? colBull : eng.trend == -1 ? colBear : color.white)
    dashRow(dash, 5, "IDM", idmTxt, eng.idmTaken ? colIdmS : color.white)
    dashRow(dash, 6, "Protected low / high", (na(eng.pLo) ? "-" : str.tostring(eng.pLo, format.mintick)) + " / " + (na(eng.pHi) ? "-" : str.tostring(eng.pHi, format.mintick)), color.white)
    dashRow(dash, 7, "Bull setup", stageName(bullSt.stage) + " (last: " + bullSt.reason + ")", colBull)
    dashRow(dash, 8, "Bear setup", stageName(bearSt.stage) + " (last: " + bearSt.reason + ")", colBear)
    dashRow(dash, 9, "Active pools / zones", str.tostring(pools.size()) + " / " + str.tostring(zones.size()), color.white)
    dashRow(dash, 10, "SMT", smtTxt, color.white)
    dashRow(dash, 11, "SFP volume", volAvail ? "OK (tick volume)" : "N/A - body break only", color.white)
    dashRow(dash, 12, "Countertrend (HTF vs chart)", counter ? "YES" : "no", counter ? colIdmS : color.white)
    dashRow(dash, 13, "Note", "Zones/entries are a checklist, not a win rate", color.gray)

// ═══════════════════════════ ZONE STATISTICS ═══════════════════════════
var table stats = table.new(position.bottom_right, 4, 4, bgcolor = color.new(#131722, 10), border_color = color.new(#363a45, 0), border_width = 1)
if barstate.islast and showStats
    int dF = 0
    int dM = 0
    int sF = 0
    int sM = 0
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            Zone z = zones.get(i)
            if z.kind != K_RB and (showAllZ or not na(z.srcId))
                if z.dir == 1
                    dF += z.state == 0 ? 1 : 0
                    dM += z.state == 1 ? 1 : 0
                else
                    sF += z.state == 0 ? 1 : 0
                    sM += z.state == 1 ? 1 : 0
    stats.cell(0, 0, "Zones · " + tfLabel(), text_color = color.silver, text_size = size.small)
    stats.cell(1, 0, "Fresh", text_color = color.silver, text_size = size.small)
    stats.cell(2, 0, "Mitigated", text_color = color.silver, text_size = size.small)
    stats.cell(3, 0, "Active", text_color = color.silver, text_size = size.small)
    stats.cell(0, 1, "Demand", text_color = colBull, text_size = size.small)
    stats.cell(1, 1, str.tostring(dF), text_color = color.white, text_size = size.small)
    stats.cell(2, 1, str.tostring(dM), text_color = color.white, text_size = size.small)
    stats.cell(3, 1, str.tostring(dF + dM), text_color = color.white, text_size = size.small)
    stats.cell(0, 2, "Supply", text_color = colBear, text_size = size.small)
    stats.cell(1, 2, str.tostring(sF), text_color = color.white, text_size = size.small)
    stats.cell(2, 2, str.tostring(sM), text_color = color.white, text_size = size.small)
    stats.cell(3, 2, str.tostring(sF + sM), text_color = color.white, text_size = size.small)
    stats.cell(0, 3, "TOTAL", text_color = color.silver, text_size = size.small)
    stats.cell(1, 3, str.tostring(dF + sF), text_color = color.white, text_size = size.small)
    stats.cell(2, 3, str.tostring(dM + sM), text_color = color.white, text_size = size.small)
    stats.cell(3, 3, str.tostring(dF + dM + sF + sM), text_color = color.white, text_size = size.small)
