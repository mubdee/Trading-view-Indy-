//@version=6
indicator("SMC Suite v1.2.1", shorttitle = "SMC Suite", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ═══════════════════════════ INPUTS ═══════════════════════════
G0 = "General"
profile   = input.string("Balanced", "Profile", options = ["Strict", "Balanced", "Context-only"], group = G0)
trigMode  = input.string("Rejection Candle", "Entry trigger", options = ["Rejection Candle", "Internal MSS", "SFP", "Any enabled trigger"], group = G0)
trigMax   = input.int(10, "Internal MSS trigger: max bars after first touch", minval = 1, group = G0)
showDash  = input.bool(true, "Show dashboard", group = G0)
debugOn   = input.bool(false, "Debug: show reset reasons", group = G0)

G1 = "Timeframes (Phase 1: detection modules run on Chart TF)"
htfOn     = input.bool(false, "HTF context", inline = "htf", group = G1)
htfTf     = input.timeframe("240", "", inline = "htf", group = G1)

G2 = "Market structure"
majL      = input.int(3, "Major pivot left", minval = 1, group = G2)
majR      = input.int(3, "Major pivot right", minval = 1, group = G2)
intL      = input.int(1, "Internal pivot left", minval = 1, group = G2)
intR      = input.int(1, "Internal pivot right", minval = 1, group = G2)
breakMode = input.string("CLOSE", "Break source", options = ["CLOSE", "WICK"], group = G2)
brkBufAtr = input.float(0.0, "Break buffer (x ATR14)", minval = 0, step = 0.01, group = G2)
eqTolAtr  = input.float(0.05, "Equal-level tolerance (x ATR14)", minval = 0, step = 0.01, group = G2)
showMajor = input.bool(true, "Show major BOS / CHoCH", group = G2)
showInt   = input.bool(false, "Show internal BOS / CHoCH", group = G2)
showFake  = input.bool(true, "Show Fake BOS", group = G2)
showSw    = input.bool(true, "Show HH / HL / LH / LL / EQH / EQL", group = G2)

G3 = "Liquidity"
liqMajor  = input.bool(true, "Pools from major swings", group = G3)
liqInt    = input.bool(false, "Pools from internal swings", group = G3)
usePD     = input.bool(true, "PDH / PDL", group = G3)
usePW     = input.bool(true, "PWH / PWL", group = G3)
swBufAtr  = input.float(0.0, "Sweep buffer (x ATR14)", minval = 0, step = 0.01, group = G3)
poolMax   = input.int(500, "Pool max age (bars)", minval = 10, group = G3)
showPools = input.bool(true, "Show liquidity lines", group = G3)
showSwp   = input.bool(true, "Show sweeps", group = G3)

G4 = "IDM / MSS / Displacement"
idmOn     = input.bool(true, "IDM module", group = G4)
idmMax    = input.int(100, "IDM candidate max bars", minval = 5, group = G4)
reclaimOn = input.bool(false, "Allow IDM reclaim within N bars", inline = "rc", group = G4)
reclaimN  = input.int(3, "N", minval = 1, inline = "rc", group = G4)
mssMode   = input.string("Internal", "MSS break level", options = ["Internal", "Major"], group = G4)
dispMult  = input.float(1.0, "Displacement body >= x ATR14", minval = 0.1, step = 0.1, group = G4)
dispLoc   = input.float(0.25, "Displacement close in outer % of range", minval = 0.05, maxval = 0.5, step = 0.05, group = G4)
dispWin   = input.int(0, "Displacement window (bars before MSS break)", minval = 0, group = G4)
showIdm   = input.bool(true, "Show IDM / MSS", group = G4)

G5 = "Order Block / FVG"
obLook    = input.int(5, "OB search: last opposite candle within N bars", minval = 1, maxval = 20, group = G5)
fvgMinAtr = input.float(0.05, "FVG minimum size (x ATR14)", minval = 0, step = 0.01, group = G5)
fvgDisp   = input.bool(false, "FVG: require displacement middle candle", group = G5)
invBufAtr = input.float(0.0, "OB/FVG invalidation buffer (x ATR14)", minval = 0, step = 0.01, group = G5)
mitMode   = input.string("Touch", "Mitigation threshold", options = ["Touch", "50%", "Full"], group = G5)
zoneMax   = input.int(300, "Zone max age (bars)", minval = 10, group = G5)
delMit    = input.bool(true, "Remove zone from chart once mitigated", group = G5)
keepInv   = input.bool(false, "Keep invalidated zones (greyed)", group = G5)
showOB    = input.bool(true, "Show OB", group = G5)
showFVG   = input.bool(true, "Show FVG", group = G5)

G6 = "SFP / Rejection Block"
sfpOn     = input.bool(true, "SFP module", group = G6)
sfpTrig   = input.string("Sweep candle", "SFP trigger level = low/high of", options = ["Sweep candle", "Swept swing candle"], group = G6)
sfpMax    = input.int(5, "SFP max bars after sweep", minval = 1, group = G6)
volLen    = input.int(20, "Strong volume: SMA length", minval = 2, group = G6)
volMult   = input.float(1.5, "Strong volume: >= x SMA", minval = 1.0, step = 0.1, group = G6)
volDirReq = input.bool(true, "Strong-volume candle must close in SFP direction", group = G6)
showSfp   = input.bool(true, "Show SFP", group = G6)
rbMode    = input.string("Wick", "Rejection Block boundary", options = ["Wick", "Body", "Full"], group = G6)
rbBufAtr  = input.float(0.0, "RB invalidation buffer (x ATR14)", minval = 0, step = 0.01, group = G6)
showRB    = input.bool(true, "Show Rejection Blocks", group = G6)

G7 = "SMT"
smtOn     = input.bool(true, "SMT module", group = G7)
smtMode   = input.string("Auto map", "Comparison symbol", options = ["Auto map", "Manual"], group = G7)
smtManual = input.symbol("OANDA:XAGUSD", "Manual symbol", group = G7)
smtInvMan = input.bool(false, "Manual: inverse correlation", group = G7)
smtTol    = input.int(2, "Timestamp tolerance (bars)", minval = 0, group = G7)
showSmt   = input.bool(true, "Show SMT", group = G7)

G8 = "Colours"
colBull   = input.color(color.new(#b2b5be, 0), "Bullish", group = G8)
colBear   = input.color(color.new(#5d606b, 0), "Bearish", group = G8)
colFake   = input.color(color.new(#787b86, 0), "Fake / neutral", group = G8)
colIdmC   = input.color(color.new(#868993, 0), "IDM candidate", group = G8)
colIdmS   = input.color(color.new(#d1d4dc, 0), "IDM swept", group = G8)

// ═══════════════════════════ CONSTANTS ═══════════════════════════
S_NONE = 0
S_CTX = 1
S_CAND = 2
S_SWEPT = 3
S_MSS = 4
S_ZONE = 5
K_OB = 0
K_FVG = 1
K_RB = 2

// ═══════════════════════════ TYPES ═══════════════════════════
type Ctr
    int n = 0

type Struct
    float hi
    int   hiBar
    int   hiState = 0   // 0 active, 1 fake-broken (still breakable), 2 consumed
    float lo
    int   loBar
    int   loState = 0
    int   bias = 0      // 1 bull, -1 bear, 0 neutral
    float lastPH
    int   lastPHBar
    float lastPL
    int   lastPLBar

type Pool
    int   id
    float price
    int   dir           // 1 = BSL (highs), -1 = SSL (lows)
    string src
    int   pbar
    int   created
    float oLow
    float oHigh
    int   touches = 1
    line  ln

type Zone
    int   id
    int   kind
    int   dir
    float top
    float bot
    float invLvl
    int   createdBar
    int   dispBar
    int   midBar
    int   srcId
    int   firstTouch
    int   state = 0     // 0 active, 1 mitigated
    box   bx

type Sfp
    int   id
    int   dir           // 1 bullish SFP (sweep of low), -1 bearish SFP (sweep of high)
    float trig
    float ext
    int   sweepBar
    int   wickBar

type Setup
    int   dir
    int   stage = 0
    float idm
    int   idmBar
    int   idmCreated
    int   protBar
    int   sweepBar
    int   reclaimBy
    float mssLvl
    int   mssBar
    int   mssId
    int   dispBar
    string reason = "-"
    string zoneEnd = ""
    line  idmLn
    label idmLb

// ═══════════════════════════ SERIES ═══════════════════════════
atr      = ta.atr(14)
rng      = high - low
body     = math.abs(close - open)
brkBuf   = atr * brkBufAtr
eqTol    = atr * eqTolAtr
sweepBuf = atr * swBufAtr
invBuf   = atr * invBufAtr
rbBuf    = atr * rbBufAtr
wickMode = breakMode == "WICK"

majPH = ta.pivothigh(high, majL, majR)
majPL = ta.pivotlow(low, majL, majR)
intPH = ta.pivothigh(high, intL, intR)
intPL = ta.pivotlow(low, intL, intR)
pivTimeMaj = time[majR]

dispBull = rng > 0 and close > open and body >= atr * dispMult and close >= high - rng * dispLoc
dispBear = rng > 0 and close < open and body >= atr * dispMult and close <= low + rng * dispLoc

volSma   = ta.sma(volume, volLen)
volAvail = not na(volume) and volume > 0
volOk    = volAvail and not na(volSma[1]) and volume >= volSma[1] * volMult

warm = bar_index > math.max(majL + majR, intL + intR, 20)

// ═══════════════════════════ REQUESTS ═══════════════════════════
htfCalc(int L, int R) =>
    var float h = na
    var float l = na
    var int b = 0
    float ph = ta.pivothigh(high, L, R)
    float pl = ta.pivotlow(low, L, R)
    if not na(ph)
        h := ph
    if not na(pl)
        l := pl
    if not na(h) and close > h
        b := 1
        h := na
    if not na(l) and close < l
        b := -1
        l := na
    b

htfRaw = request.security(syminfo.tickerid, htfTf, htfCalc(majL, majR)[1], lookahead = barmerge.lookahead_on)
bool htfTfOk  = timeframe.in_seconds(htfTf) >= timeframe.in_seconds()
bool htfActive = htfOn and htfTfOk
int htfBias = htfActive ? nz(htfRaw, 0) : 0
bool htfOkBull = not htfActive or (profile == "Strict" ? htfBias == 1 : htfBias != -1)
bool htfOkBear = not htfActive or (profile == "Strict" ? htfBias == -1 : htfBias != 1)

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
bool pdOk = usePD and timeframe.in_seconds() < 86400
bool pwOk = usePW and timeframe.in_seconds() < 604800

mapSym(string r) =>
    switch r
        "XAUUSD" => "XAGUSD"
        "EURUSD" => "GBPUSD"
        "GBPUSD" => "EURUSD"
        "AUDUSD" => "NZDUSD"
        "NZDUSD" => "AUDUSD"
        "USDCHF" => "EURUSD"
        "USDJPY" => "USDCHF"
        => ""

string tk      = syminfo.ticker
string root6   = str.length(tk) >= 6 ? str.upper(str.substring(tk, 0, 6)) : str.upper(tk)
string sfx     = str.length(tk) > 6 ? str.substring(tk, 6) : ""
string autoSym = mapSym(root6)
string cmpSym  = smtMode == "Manual" ? smtManual : autoSym == "" ? "" : syminfo.prefix + ":" + autoSym + sfx
bool cmpInv    = smtMode == "Manual" ? smtInvMan : root6 == "USDCHF"
bool smtHasSym = smtOn and cmpSym != ""
string reqSym  = smtHasSym ? cmpSym : syminfo.tickerid
[cPH, cPL, cTm, cCl] = request.security(reqSym, timeframe.period, [ta.pivothigh(high, majL, majR), ta.pivotlow(low, majL, majR), time[majR], close], ignore_invalid_symbol = true)
bool smtAvail = smtHasSym and not na(cCl)
int tolMs = smtTol * timeframe.in_seconds() * 1000

// ═══════════════════════════ STATE ═══════════════════════════
var Ctr ctr = Ctr.new()
var Struct majS = Struct.new()
var Struct intS = Struct.new()
var array<Pool> pools = array.new<Pool>()
var array<Zone> zones = array.new<Zone>()
var Setup bullSt = Setup.new(1)
var Setup bearSt = Setup.new(-1)
var Sfp bullP = na
var Sfp bearP = na
var float protLo = na
var int protLoBar = na
var int bullBrkBar = na
var float protHi = na
var int protHiBar = na
var int bearBrkBar = na
var int lastDispBull = na
var int lastDispBear = na
var int lastObBullLeft = na
var int lastObBearLeft = na
var float cHi = na
var float cHiPrev = na
var int cHiT = na
var float cLo = na
var float cLoPrev = na
var int cLoT = na
var int pendBullT = na
var int pendBullBar = na
var int pendBullDl = na
var float pendBullPx = na
var int pendBearT = na
var int pendBearBar = na
var int pendBearDl = na
var float pendBearPx = na
var int lastSmtDir = 0
var int lastSmtBar = na

// ═══════════════════════════ HELPERS ═══════════════════════════
method next(Ctr c) =>
    c.n += 1
    c.n

stageName(int s) =>
    switch s
        0 => "NONE"
        1 => "CONTEXT_FOUND"
        2 => "IDM_CANDIDATE"
        3 => "IDM_SWEPT"
        4 => "MSS_CONFIRMED"
        5 => "ZONE_WAIT"
        => "?"

biasTxt(int b) =>
    b == 1 ? "Bull" : b == -1 ? "Bear" : "Neutral"

method onPivots(Struct s, float ph, float pl, int R, bool showLbl) =>
    if not na(ph)
        if showLbl and not na(s.lastPH)
            string t = math.abs(ph - s.lastPH) <= eqTol ? "EQH" : ph > s.lastPH ? "HH" : "LH"
            label.new(bar_index - R, ph, t, style = label.style_label_down, color = color(na), textcolor = colBear, size = size.tiny)
        s.lastPH := ph
        s.lastPHBar := bar_index - R
        s.hi := ph
        s.hiBar := bar_index - R
        s.hiState := 0
    if not na(pl)
        if showLbl and not na(s.lastPL)
            string t = math.abs(pl - s.lastPL) <= eqTol ? "EQL" : pl < s.lastPL ? "LL" : "HL"
            label.new(bar_index - R, pl, t, style = label.style_label_up, color = color(na), textcolor = colBull, size = size.tiny)
        s.lastPL := pl
        s.lastPLBar := bar_index - R
        s.lo := pl
        s.loBar := bar_index - R
        s.loState := 0
    true

// returns [bullType, bearType, bullLvl, bullLvlBar, bearLvl, bearLvlBar]; type 1 BOS, 2 CHoCH, 3 Fake BOS
method breaks(Struct s, float buf, bool wm) =>
    int bullT = 0
    int bearT = 0
    float bL = s.hi
    int bLB = s.hiBar
    float sL = s.lo
    int sLB = s.loBar
    bool hiOk = not na(s.hi) and s.hiState != 2
    bool loOk = not na(s.lo) and s.loState != 2
    bool upW = hiOk and high > s.hi + buf
    bool upB = hiOk and close > s.hi + buf
    bool dnW = loOk and low < s.lo - buf
    bool dnB = loOk and close < s.lo - buf
    if s.bias == 0
        // first break from Neutral: body = real BOS, wick only = Fake BOS
        if upB and not dnB and not dnW
            bullT := 1
            s.bias := 1
            s.hiState := 2
        else if dnB and not upB and not upW
            bearT := 1
            s.bias := -1
            s.loState := 2
        else if not upB and not dnB
            if upW and not dnW and s.hiState == 0
                bullT := 3
                s.hiState := 1
            if dnW and not upW and s.loState == 0
                bearT := 3
                s.loState := 1
    else
        bool up = wm ? upW : upB
        bool dn = wm ? dnW : dnB
        if up and not dn
            bullT := s.bias == 1 ? 1 : 2
            s.bias := 1
            s.hiState := 2
        else if dn and not up
            bearT := s.bias == -1 ? 1 : 2
            s.bias := -1
            s.loState := 2
    [bullT, bearT, bL, bLB, sL, sLB]

drawBreak(int fromBar, float lvl, int typ, int d, bool major) =>
    bool show = major ? (typ == 3 ? showFake : showMajor) : (showInt and (typ != 3 or showFake))
    if show and not na(lvl) and not na(fromBar)
        color c = typ == 3 ? colFake : d == 1 ? colBull : colBear
        string t = (major ? "" : "i") + (typ == 1 ? "BOS" : typ == 2 ? "CHoCH" : "Fake BOS")
        line.new(fromBar, lvl, bar_index, lvl, color = c, style = typ == 3 ? line.style_dotted : major ? line.style_solid : line.style_dashed, width = 1)
        label.new(math.round((fromBar + bar_index) / 2), lvl, t, style = d == 1 ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = major ? size.small : size.tiny)
    true

addPool(float price, int d, string src, int pbar, float oL, float oH) =>
    bool merged = false
    if src == "SWING" and pools.size() > 0
        for i = 0 to pools.size() - 1
            Pool p = pools.get(i)
            if p.dir == d and (p.src == "SWING" or p.src == "EQ") and math.abs(p.price - price) <= eqTol
                p.touches += 1
                p.src := "EQ"
                p.price := d == 1 ? math.max(p.price, price) : math.min(p.price, price)
                if not na(p.ln)
                    p.ln.set_y1(p.price)
                    p.ln.set_y2(p.price)
                merged := true
                break
    if not merged
        line ln = na
        if showPools
            color c = src == "SWING" ? color.new(colFake, 55) : color.new(colFake, 25)
            ln := line.new(pbar, price, bar_index, price, color = c, style = line.style_dotted)
            if src != "SWING"
                label.new(bar_index, price, src, style = label.style_label_left, color = color(na), textcolor = colFake, size = size.tiny)
        pools.push(Pool.new(id = ctr.next(), price = price, dir = d, src = src, pbar = pbar, created = bar_index, oLow = oL, oHigh = oH, ln = ln))
        if pools.size() > 120
            pools.shift()
    merged

newZone(int kind, int d, float top, float bot, int left, float inv, int dispB, int midB) =>
    color base = d == 1 ? colBull : colBear
    string t = kind == K_OB ? "OB" : kind == K_FVG ? "FVG" : "RB"
    int tr = kind == K_OB ? 85 : kind == K_FVG ? 90 : 88
    bool show = kind == K_OB ? showOB : kind == K_FVG ? showFVG : showRB
    box b = na
    if show
        b := box.new(left, top, bar_index + 1, bot, border_color = color.new(base, 60), border_width = 1, bgcolor = color.new(base, tr), text = t, text_size = size.tiny, text_color = color.new(base, 30), text_halign = text.align_left, text_valign = text.align_top)
    Zone z = Zone.new(id = ctr.next(), kind = kind, dir = d, top = top, bot = bot, invLvl = inv, createdBar = bar_index, dispBar = dispB, midBar = midB, bx = b)
    zones.push(z)
    if zones.size() > 200
        zones.shift()
    z

method reset(Setup st, string why) =>
    if st.stage >= S_CAND and st.stage <= S_SWEPT
        if not na(st.idmLn)
            st.idmLn.delete()
        if not na(st.idmLb)
            st.idmLb.delete()
    st.stage := S_NONE
    st.reason := why
    if debugOn and why != "ENTRY_DONE"
        label.new(bar_index, st.dir == 1 ? low : high, (st.dir == 1 ? "Bull: " : "Bear: ") + why, style = st.dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(colFake, 30), textcolor = color.white, size = size.tiny)
    true

// IDM -> sweep -> MSS. returns [newCandidate, idmSwept, mss]
method step(Setup st, float prot, int pBar, bool protBroken, float piv, int pivBar, float mssRef, bool dispNow, int lastDisp, bool ctxOk) =>
    bool evCand = false
    bool evSwept = false
    bool evMss = false
    int d = st.dir
    color dc = d == 1 ? colBull : colBear
    if st.stage == S_CTX and (not ctxOk or na(prot) or protBroken)
        st.reset(not ctxOk ? "CONTEXT_LOST" : "PROTECTED_BROKEN")
    if st.stage == S_NONE and not na(prot) and ctxOk and not protBroken
        st.stage := S_CTX
    // new IDM candidate (most recent qualifying internal swing replaces an older unswept one)
    if (st.stage == S_CTX or st.stage == S_CAND) and not na(piv) and not na(prot) and not protBroken
        bool side = d == 1 ? piv > prot : piv < prot
        if side
            if st.stage == S_CAND
                if not na(st.idmLn)
                    st.idmLn.delete()
                if not na(st.idmLb)
                    st.idmLb.delete()
            st.idm := piv
            st.idmBar := pivBar
            st.idmCreated := bar_index
            st.protBar := pBar
            st.reclaimBy := na
            st.stage := S_CAND
            evCand := true
            if showIdm
                st.idmLn := line.new(pivBar, piv, bar_index, piv, color = colIdmC, style = line.style_dashed)
                st.idmLb := label.new(pivBar, piv, "IDM", style = d == 1 ? label.style_label_up : label.style_label_down, color = color(na), textcolor = colIdmC, size = size.tiny)
    // candidate -> swept
    if st.stage == S_CAND and not evCand
        bool protChanged = (na(pBar) != na(st.protBar)) or (not na(pBar) and pBar != st.protBar)
        if protBroken
            st.reset("PROTECTED_BROKEN")
        else if protChanged
            st.reset("PROTECTED_CHANGED")
        else if bar_index - st.idmCreated > idmMax
            st.reset("IDM_EXPIRED")
        else
            bool reclaimed = d == 1 ? close > st.idm : close < st.idm
            if na(st.reclaimBy)
                bool swept = d == 1 ? low < st.idm - sweepBuf : high > st.idm + sweepBuf
                if swept
                    if reclaimed
                        evSwept := true
                    else if reclaimOn
                        st.reclaimBy := bar_index + reclaimN
                    else
                        st.reset("IDM_EXPIRED")
            else
                if reclaimed
                    evSwept := true
                else if bar_index >= st.reclaimBy
                    st.reset("IDM_EXPIRED")
            if evSwept
                st.stage := S_SWEPT
                st.sweepBar := bar_index
                st.mssLvl := mssRef
                if not na(st.idmLn)
                    st.idmLn.set_x2(bar_index)
                    st.idmLn.set_color(colIdmS)
                if not na(st.idmLb)
                    st.idmLb.set_text("IDM swept")
                    st.idmLb.set_textcolor(colIdmS)
    else if st.stage == S_CAND and not na(st.idmLn)
        st.idmLn.set_x2(bar_index)
    // swept -> MSS
    if st.stage == S_SWEPT
        if protBroken
            st.reset("PROTECTED_BROKEN")
        else if bar_index - st.sweepBar > idmMax
            st.reset("IDM_EXPIRED")
        else if not na(st.mssLvl)
            bool brk = d == 1 ? (wickMode ? high : close) > st.mssLvl + brkBuf : (wickMode ? low : close) < st.mssLvl - brkBuf
            if brk
                if bar_index == st.sweepBar
                    st.reset("SAME_BAR_AMBIGUOUS")
                else
                    bool ok = dispWin == 0 ? dispNow : (not na(lastDisp) and lastDisp > st.sweepBar and bar_index - lastDisp <= dispWin)
                    if ok
                        evMss := true
                        st.stage := S_MSS
                        st.mssBar := bar_index
                        st.mssId := ctr.next()
                        st.dispBar := dispWin == 0 ? bar_index : lastDisp
                        st.zoneEnd := ""
                        if showIdm
                            line.new(st.sweepBar, st.mssLvl, bar_index, st.mssLvl, color = dc, width = 1)
                            label.new(bar_index, st.mssLvl, "MSS", style = d == 1 ? label.style_label_down : label.style_label_up, color = dc, textcolor = d == 1 ? color.black : color.white, size = size.small)
                        if not na(st.idmLn)
                            st.idmLn.set_color(dc)
    [evCand, evSwept, evMss]

// link OB/FVG created by this MSS displacement leg
method link(Setup st) =>
    int n = 0
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            Zone z = zones.get(i)
            if z.dir == st.dir and z.kind != K_RB
                if na(z.srcId)
                    bool okOB = z.kind == K_OB and not na(z.dispBar) and z.dispBar == st.dispBar
                    bool okFVG = z.kind == K_FVG and not na(z.midBar) and z.midBar >= st.sweepBar + 1 and z.midBar <= st.mssBar
                    if okOB or okFVG
                        z.srcId := st.mssId
                if not na(z.srcId) and z.srcId == st.mssId
                    n += 1
    n

// zone wait -> entry. returns [fire, zone, triggerName]
method entry(Setup st, bool protBroken, bool intBrk, bool sfpNow, float sfpExt) =>
    bool fire = false
    string trig = ""
    Zone hit = na
    if (st.stage == S_ZONE or st.stage == S_MSS) and protBroken
        st.reset("PROTECTED_BROKEN")
    if st.stage == S_ZONE
        int live = 0
        if zones.size() > 0
            for i = 0 to zones.size() - 1
                Zone z = zones.get(i)
                if z.dir == st.dir and not na(z.srcId) and z.srcId == st.mssId
                    live += 1
                    if not fire and z.createdBar < bar_index
                        bool rc = rng > 0 and (st.dir == 1 ? (low <= z.top and close > z.top and close >= low + 0.5 * rng) : (high >= z.bot and close < z.bot and close <= high - 0.5 * rng))
                        bool im = intBrk and not na(z.firstTouch) and z.firstTouch < bar_index and bar_index - z.firstTouch <= trigMax
                        bool sf = sfpNow and not na(sfpExt) and (st.dir == 1 ? (sfpExt <= z.top and sfpExt >= z.bot) : (sfpExt >= z.bot and sfpExt <= z.top))
                        bool t = trigMode == "Rejection Candle" ? rc : trigMode == "Internal MSS" ? im : trigMode == "SFP" ? sf : (rc or im or sf)
                        if t
                            fire := true
                            hit := z
                            trig := trigMode != "Any enabled trigger" ? trigMode : rc ? "Rejection Candle" : im ? "Internal MSS" : "SFP"
        if live == 0 and bar_index > st.mssBar + 1
            st.reset(st.zoneEnd == "" ? "ZONE_EXPIRED" : st.zoneEnd)
    [fire, hit, trig]

// 0 pending, 1 confirmed by body, 2 confirmed by wick + strong volume, 3 invalidated, 4 expired
method adv(Sfp p) =>
    int r = 0
    int d = p.dir
    if bar_index > p.sweepBar
        bool inv = d == -1 ? close > p.ext : close < p.ext
        if inv
            r := 3
        else if bar_index - p.sweepBar > sfpMax
            r := 4
        else
            if not na(p.wickBar) and bar_index == p.wickBar + 1
                bool dirOk = not volDirReq or (d == -1 ? close < open : close > open)
                if volOk and dirOk
                    r := 2
                p.wickBar := na
            if r == 0
                bool bodyBrk = d == -1 ? close < p.trig : close > p.trig
                bool wickBrk = d == -1 ? low < p.trig : high > p.trig
                if bodyBrk
                    r := 1
                else if wickBrk
                    p.wickBar := bar_index
    r

drawSfp(int d, int how) =>
    if showSfp
        color c = d == 1 ? colBull : colBear
        label.new(bar_index, d == 1 ? low : high, how == 2 ? "SFP (vol)" : "SFP", style = d == 1 ? label.style_label_up : label.style_label_down, color = c, textcolor = d == 1 ? color.black : color.white, size = size.small)
    true

dashRow(table tb, int r, string k, string v, color vc) =>
    tb.cell(0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    tb.cell(1, r, v, text_color = vc, text_size = size.small, text_halign = text.align_left)
    true

// ═══════════════════════════ MAIN (closed candles only) ═══════════════════════════
bool evBullBOS = false
bool evBearBOS = false
bool evBullCH = false
bool evBearCH = false
bool evFake = false
bool evMssBull = false
bool evMssBear = false
bool evSweep = false
bool evIdmCand = false
bool evIdmSwept = false
bool evSfpBull = false
bool evSfpBear = false
bool evNewOB = false
bool evNewFVG = false
bool evMitig = false
bool evSmtBull = false
bool evSmtBear = false
bool evEntryBull = false
bool evEntryBear = false
string msg = ""

if barstate.isconfirmed and warm
    // 1-2. confirmed pivots, swing labels, protected swings, liquidity pools
    float prevMajPL = majS.lastPL
    float prevMajPH = majS.lastPH
    majS.onPivots(majPH, majPL, majR, showSw)
    intS.onPivots(intPH, intPL, intR, false)
    if not na(majPL)
        int pb = bar_index - majR
        if na(protLo) or na(bullBrkBar) or (pb < bullBrkBar and pb > protLoBar)
            protLo := majPL
            protLoBar := pb
    if not na(majPH)
        int pb = bar_index - majR
        if na(protHi) or na(bearBrkBar) or (pb < bearBrkBar and pb > protHiBar)
            protHi := majPH
            protHiBar := pb
    if liqMajor and not na(majPH)
        addPool(majPH, 1, "SWING", bar_index - majR, low[majR], high[majR])
    if liqMajor and not na(majPL)
        addPool(majPL, -1, "SWING", bar_index - majR, low[majR], high[majR])
    if liqInt and not na(intPH)
        addPool(intPH, 1, "SWING", bar_index - intR, low[intR], high[intR])
    if liqInt and not na(intPL)
        addPool(intPL, -1, "SWING", bar_index - intR, low[intR], high[intR])
    if pdOk and not na(pdh) and pdh != pdh[1]
        addPool(pdh, 1, "PDH", bar_index, na, na)
        addPool(pdl, -1, "PDL", bar_index, na, na)
    if pwOk and not na(pwh) and pwh != pwh[1]
        addPool(pwh, 1, "PWH", bar_index, na, na)
        addPool(pwl, -1, "PWL", bar_index, na, na)

    // 3-4. structure breaks
    [mbT, msT, mbL, mbLB, msL, msLB] = majS.breaks(brkBuf, wickMode)
    [ibT, isT, ibL, ibLB, isL, isLB] = intS.breaks(brkBuf, wickMode)
    if mbT > 0
        drawBreak(mbLB, mbL, mbT, 1, true)
        if mbT < 3
            if not na(majS.lastPL)
                protLo := majS.lastPL
                protLoBar := majS.lastPLBar
            bullBrkBar := bar_index
    if msT > 0
        drawBreak(msLB, msL, msT, -1, true)
        if msT < 3
            if not na(majS.lastPH)
                protHi := majS.lastPH
                protHiBar := majS.lastPHBar
            bearBrkBar := bar_index
    if ibT > 0
        drawBreak(ibLB, ibL, ibT, 1, false)
    if isT > 0
        drawBreak(isLB, isL, isT, -1, false)
    evBullBOS := mbT == 1
    evBearBOS := msT == 1
    evBullCH := mbT == 2
    evBearCH := msT == 2
    evFake := mbT == 3 or msT == 3
    bool intBullBrk = ibT == 1 or ibT == 2
    bool intBearBrk = isT == 1 or isT == 2

    // 5. liquidity sweeps
    Pool bslP = na
    Pool sslP = na
    if pools.size() > 0
        for i = pools.size() - 1 to 0
            Pool p = pools.get(i)
            bool rem = false
            if p.created < bar_index
                if p.dir == 1
                    if high > p.price + sweepBuf and close < p.price
                        if na(bslP) or p.price > bslP.price
                            bslP := p
                        rem := true
                    else if close > p.price
                        rem := true
                else
                    if low < p.price - sweepBuf and close > p.price
                        if na(sslP) or p.price < sslP.price
                            sslP := p
                        rem := true
                    else if close < p.price
                        rem := true
                if not rem and bar_index - p.created > poolMax
                    rem := true
            if rem
                if not na(p.ln)
                    p.ln.delete()
                pools.remove(i)
            else if not na(p.ln)
                p.ln.set_x2(bar_index)
    bool sweepAmb = not na(bslP) and not na(sslP)
    int bslSweepId = na
    int sslSweepId = na
    if not sweepAmb and not na(bslP)
        bslSweepId := ctr.next()
        evSweep := true
        if showSwp
            label.new(bar_index, high, "x", style = label.style_none, textcolor = colFake, size = size.small)
    if not sweepAmb and not na(sslP)
        sslSweepId := ctr.next()
        evSweep := true
        if showSwp
            label.new(bar_index, low, "x", style = label.style_none, textcolor = colFake, size = size.small)

    // 6. displacement memory
    if dispBull
        lastDispBull := bar_index
    if dispBear
        lastDispBear := bar_index

    // 7. IDM -> MSS
    bool pLoBroken = not na(protLo) and close < protLo
    bool pHiBroken = not na(protHi) and close > protHi
    float mssRefBull = mssMode == "Internal" ? intS.lastPH : majS.lastPH
    float mssRefBear = mssMode == "Internal" ? intS.lastPL : majS.lastPL
    [bc, bsw, bm] = bullSt.step(protLo, protLoBar, pLoBroken, idmOn ? intPL : na, bar_index - intR, mssRefBull, dispBull, lastDispBull, htfOkBull)
    [sc, ssw, sm] = bearSt.step(protHi, protHiBar, pHiBroken, idmOn ? intPH : na, bar_index - intR, mssRefBear, dispBear, lastDispBear, htfOkBear)
    evIdmCand := bc or sc
    evIdmSwept := bsw or ssw
    evMssBull := bm
    evMssBear := sm

    // 8a. lifecycle of existing zones (before new zones are added)
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            if z.createdBar < bar_index
                bool touched = z.dir == 1 ? low <= z.top : high >= z.bot
                if touched and na(z.firstTouch)
                    z.firstTouch := bar_index
                float h = z.top - z.bot
                float depth = h > 0 ? (z.dir == 1 ? (z.top - low) / h : (high - z.bot) / h) : (touched ? 1.0 : 0.0)
                bool mit = mitMode == "Touch" ? touched : mitMode == "50%" ? depth >= 0.5 : depth >= 1.0
                float buf = z.kind == K_RB ? rbBuf : invBuf
                bool inv = z.dir == 1 ? close < z.invLvl - buf : close > z.invLvl + buf
                bool expd = bar_index - z.createdBar > zoneMax
                if z.state == 0 and mit and not inv
                    z.state := 1
                    if z.kind != K_RB
                        evMitig := true
                    if not na(z.bx)
                        if delMit
                            z.bx.delete()
                            z.bx := na
                        else
                            z.bx.set_bgcolor(color.new(z.dir == 1 ? colBull : colBear, 94))
                if inv or expd
                    string why = inv ? "ZONE_INVALIDATED" : "ZONE_EXPIRED"
                    if not na(z.srcId)
                        if z.dir == 1 and not na(bullSt.mssId) and z.srcId == bullSt.mssId
                            bullSt.zoneEnd := why
                        if z.dir == -1 and not na(bearSt.mssId) and z.srcId == bearSt.mssId
                            bearSt.zoneEnd := why
                    if not na(z.bx)
                        z.bx.set_right(bar_index)
                        if keepInv and inv
                            z.bx.set_bgcolor(color.new(colFake, 88))
                            z.bx.set_border_color(color.new(colFake, 60))
                        else
                            z.bx.delete()
                    zones.remove(i)
                else if not na(z.bx)
                    z.bx.set_right(bar_index + 1)

    // 8b. new OB / FVG
    if dispBull
        int src = na
        for i = 1 to obLook
            if close[i] < open[i]
                src := i
                break
        if not na(src) and bar_index - src != lastObBullLeft
            lastObBullLeft := bar_index - src
            newZone(K_OB, 1, open[src], low[src], bar_index - src, low[src], bar_index, na)
            evNewOB := true
    if dispBear
        int src = na
        for i = 1 to obLook
            if close[i] > open[i]
                src := i
                break
        if not na(src) and bar_index - src != lastObBearLeft
            lastObBearLeft := bar_index - src
            newZone(K_OB, -1, high[src], open[src], bar_index - src, high[src], bar_index, na)
            evNewOB := true
    if low > high[2] and low - high[2] >= atr * fvgMinAtr and (not fvgDisp or dispBull[1])
        newZone(K_FVG, 1, low, high[2], bar_index - 2, high[2], na, bar_index - 1)
        evNewFVG := true
    if high < low[2] and low[2] - high >= atr * fvgMinAtr and (not fvgDisp or dispBear[1])
        newZone(K_FVG, -1, low[2], high, bar_index - 2, low[2], na, bar_index - 1)
        evNewFVG := true

    // 9. SFP (advance pending first, then register new sweeps) + Rejection Blocks
    bool sfpBullNow = false
    bool sfpBearNow = false
    float sfpBullExt = na
    float sfpBearExt = na
    if not na(bearP)
        int r = bearP.adv()
        if r == 1 or r == 2
            evSfpBear := true
            sfpBearNow := true
            sfpBearExt := bearP.ext
            drawSfp(-1, r)
            bearP := na
        else if r >= 3
            bearP := na
    if not na(bullP)
        int r = bullP.adv()
        if r == 1 or r == 2
            evSfpBull := true
            sfpBullNow := true
            sfpBullExt := bullP.ext
            drawSfp(1, r)
            bullP := na
        else if r >= 3
            bullP := na
    if not na(bslSweepId)
        if sfpOn
            float trg = sfpTrig == "Sweep candle" ? low : nz(bslP.oLow, low)
            bearP := Sfp.new(bslSweepId, -1, trg, high, bar_index, na)
            if sfpTrig != "Sweep candle" and close < trg
                evSfpBear := true
                sfpBearNow := true
                sfpBearExt := high
                drawSfp(-1, 1)
                bearP := na
        float rTop = rbMode == "Body" ? math.max(open, close) : high
        float rBot = rbMode == "Full" ? low : rbMode == "Body" ? math.min(open, close) : math.max(open, close)
        if rTop > rBot
            newZone(K_RB, -1, rTop, rBot, bar_index, high, na, na)
    if not na(sslSweepId)
        if sfpOn
            float trg = sfpTrig == "Sweep candle" ? high : nz(sslP.oHigh, high)
            bullP := Sfp.new(sslSweepId, 1, trg, low, bar_index, na)
            if sfpTrig != "Sweep candle" and close > trg
                evSfpBull := true
                sfpBullNow := true
                sfpBullExt := low
                drawSfp(1, 1)
                bullP := na
        float rTop = rbMode == "Full" ? high : rbMode == "Body" ? math.max(open, close) : math.min(open, close)
        float rBot = rbMode == "Body" ? math.min(open, close) : low
        if rTop > rBot
            newZone(K_RB, 1, rTop, rBot, bar_index, low, na, na)

    // 10. link zones to MSS
    if (bullSt.stage == S_MSS or bullSt.stage == S_ZONE) and bar_index <= bullSt.mssBar + 1
        int n = bullSt.link()
        if n > 0 and bullSt.stage == S_MSS
            bullSt.stage := S_ZONE
        else if n == 0 and bullSt.stage == S_MSS and bar_index == bullSt.mssBar + 1
            bullSt.reset("NO_LINKED_ZONE")
    if (bearSt.stage == S_MSS or bearSt.stage == S_ZONE) and bar_index <= bearSt.mssBar + 1
        int n = bearSt.link()
        if n > 0 and bearSt.stage == S_MSS
            bearSt.stage := S_ZONE
        else if n == 0 and bearSt.stage == S_MSS and bar_index == bearSt.mssBar + 1
            bearSt.reset("NO_LINKED_ZONE")

    // 11. SMT
    if smtAvail
        if not na(cPH)
            cHiPrev := cHi
            cHi := cPH
            cHiT := cTm
        if not na(cPL)
            cLoPrev := cLo
            cLo := cPL
            cLoT := cTm
        if not na(majPL) and not na(prevMajPL) and majPL < prevMajPL
            pendBullT := pivTimeMaj
            pendBullBar := bar_index - majR
            pendBullDl := bar_index + smtTol
            pendBullPx := majPL
        if not na(majPH) and not na(prevMajPH) and majPH > prevMajPH
            pendBearT := pivTimeMaj
            pendBearBar := bar_index - majR
            pendBearDl := bar_index + smtTol
            pendBearPx := majPH
        if not na(pendBullT)
            float cn = cmpInv ? cHi : cLo
            float cp = cmpInv ? cHiPrev : cLoPrev
            int ct = cmpInv ? cHiT : cLoT
            if not na(ct) and not na(cp) and math.abs(ct - pendBullT) <= tolMs
                if cmpInv ? cn <= cp : cn >= cp
                    evSmtBull := true
                    lastSmtDir := 1
                    lastSmtBar := bar_index
                    if showSmt
                        label.new(pendBullBar, pendBullPx, "SMT", style = label.style_label_up, color = color.new(colFake, 20), textcolor = color.white, size = size.tiny)
                pendBullT := na
            else if bar_index > pendBullDl
                pendBullT := na
        if not na(pendBearT)
            float cn = cmpInv ? cLo : cHi
            float cp = cmpInv ? cLoPrev : cHiPrev
            int ct = cmpInv ? cLoT : cHiT
            if not na(ct) and not na(cp) and math.abs(ct - pendBearT) <= tolMs
                if cmpInv ? cn >= cp : cn <= cp
                    evSmtBear := true
                    lastSmtDir := -1
                    lastSmtBar := bar_index
                    if showSmt
                        label.new(pendBearBar, pendBearPx, "SMT", style = label.style_label_down, color = color.new(colFake, 20), textcolor = color.white, size = size.tiny)
                pendBearT := na
            else if bar_index > pendBearDl
                pendBearT := na

    // 12. entries
    [fb, zb, tb] = bullSt.entry(pLoBroken, intBullBrk, sfpBullNow, sfpBullExt)
    [fs, zs, ts] = bearSt.entry(pHiBroken, intBearBrk, sfpBearNow, sfpBearExt)
    bool conflict = fb and fs
    if conflict and debugOn
        label.new(bar_index, high, "CONFLICT: both directions", style = label.style_label_down, color = colFake, textcolor = color.white, size = size.tiny)
    string smtB = not smtAvail ? "N/A" : lastSmtDir == 1 and bar_index - lastSmtBar <= 50 ? "yes (bull)" : "no"
    string smtS = not smtAvail ? "N/A" : lastSmtDir == -1 and bar_index - lastSmtBar <= 50 ? "yes (bear)" : "no"
    if fb and not conflict and profile != "Context-only"
        string ck = "HTF: " + (htfActive ? biasTxt(htfBias) + " - pass" : "N/A (off)") + "\nIDM swept: pass\nMSS + displacement: pass\nZone: " + (zb.kind == K_OB ? "OB" : "FVG") + " - pass\nTrigger: " + tb + " - pass\nSMT (info): " + smtB
        label.new(bar_index, low, "BUY", style = label.style_label_up, color = colBull, textcolor = color.black, size = size.normal, tooltip = ck)
        evEntryBull := true
        bullSt.reset("ENTRY_DONE")
    if fs and not conflict and profile != "Context-only"
        string ck = "HTF: " + (htfActive ? biasTxt(htfBias) + " - pass" : "N/A (off)") + "\nIDM swept: pass\nMSS + displacement: pass\nZone: " + (zs.kind == K_OB ? "OB" : "FVG") + " - pass\nTrigger: " + ts + " - pass\nSMT (info): " + smtS
        label.new(bar_index, high, "SELL", style = label.style_label_down, color = colBear, textcolor = color.white, size = size.normal, tooltip = ck)
        evEntryBear := true
        bearSt.reset("ENTRY_DONE")

    // 13. protected swing broken -> clear
    if pLoBroken
        protLo := na
        protLoBar := na
        bullBrkBar := na
    if pHiBroken
        protHi := na
        protHiBar := na
        bearBrkBar := na

    msg := (evEntryBull ? "BUY entry. " : "") + (evEntryBear ? "SELL entry. " : "") + (evMssBull ? "Bull MSS. " : "") + (evMssBear ? "Bear MSS. " : "") + (evSfpBull ? "Bull SFP. " : "") + (evSfpBear ? "Bear SFP. " : "") + (evBullCH ? "Bull CHoCH. " : "") + (evBearCH ? "Bear CHoCH. " : "") + (evBullBOS ? "Bull BOS. " : "") + (evBearBOS ? "Bear BOS. " : "") + (evSmtBull ? "Bull SMT. " : "") + (evSmtBear ? "Bear SMT. " : "")

if msg != ""
    alert(syminfo.ticker + " " + timeframe.period + ": " + msg + "Close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ═══════════════════════════ ALERT CONDITIONS ═══════════════════════════
alertcondition(evBullBOS, "Bullish BOS (major)", "SMC {{ticker}} {{interval}}: bullish BOS")
alertcondition(evBearBOS, "Bearish BOS (major)", "SMC {{ticker}} {{interval}}: bearish BOS")
alertcondition(evBullCH, "Bullish CHoCH (major)", "SMC {{ticker}} {{interval}}: bullish CHoCH")
alertcondition(evBearCH, "Bearish CHoCH (major)", "SMC {{ticker}} {{interval}}: bearish CHoCH")
alertcondition(evFake, "Fake BOS", "SMC {{ticker}} {{interval}}: Fake BOS (wick-only break from neutral)")
alertcondition(evMssBull, "Bullish MSS", "SMC {{ticker}} {{interval}}: bullish MSS after IDM sweep")
alertcondition(evMssBear, "Bearish MSS", "SMC {{ticker}} {{interval}}: bearish MSS after IDM sweep")
alertcondition(evSweep, "Liquidity sweep", "SMC {{ticker}} {{interval}}: liquidity sweep")
alertcondition(evIdmCand, "IDM candidate", "SMC {{ticker}} {{interval}}: new IDM candidate")
alertcondition(evIdmSwept, "IDM swept", "SMC {{ticker}} {{interval}}: IDM swept")
alertcondition(evSfpBull, "Bullish SFP", "SMC {{ticker}} {{interval}}: bullish SFP")
alertcondition(evSfpBear, "Bearish SFP", "SMC {{ticker}} {{interval}}: bearish SFP")
alertcondition(evNewOB, "New OB", "SMC {{ticker}} {{interval}}: new order block")
alertcondition(evNewFVG, "New FVG", "SMC {{ticker}} {{interval}}: new FVG")
alertcondition(evMitig, "Zone mitigation", "SMC {{ticker}} {{interval}}: OB/FVG mitigated")
alertcondition(evSmtBull or evSmtBear, "SMT divergence", "SMC {{ticker}} {{interval}}: SMT divergence")
alertcondition(evEntryBull, "BUY entry", "SMC {{ticker}} {{interval}}: confirmed BUY setup")
alertcondition(evEntryBear, "SELL entry", "SMC {{ticker}} {{interval}}: confirmed SELL setup")

// ═══════════════════════════ DASHBOARD ═══════════════════════════
var table dash = table.new(position.top_right, 2, 14, bgcolor = color.new(#131722, 10), border_color = color.new(#363a45, 0), border_width = 1)
if barstate.islast and showDash
    string htfTxt = not htfOn ? "Off" : not htfTfOk ? "Disabled: TF lower than chart (Phase 2)" : htfTf + " " + biasTxt(htfBias)
    string smtTxt = not smtOn ? "Off" : not smtHasSym ? "N/A (no pair for " + root6 + ", use Manual)" : not smtAvail ? "N/A (" + cmpSym + " not found)" : cmpSym + (cmpInv ? " inverse" : " direct") + " | last: " + (lastSmtDir == 1 ? "bull" : lastSmtDir == -1 ? "bear" : "-")
    bool counter = htfActive and htfBias != 0 and majS.bias != 0 and htfBias != majS.bias
    dashRow(dash, 0, "SMC Suite v1.2.1", profile, color.white)
    dashRow(dash, 1, "Entry trigger", trigMode, color.white)
    dashRow(dash, 2, "Detection TF", "Chart TF (" + timeframe.period + ")", color.white)
    dashRow(dash, 3, "HTF context", htfTxt, htfBias == 1 ? colBull : htfBias == -1 ? colBear : color.white)
    dashRow(dash, 4, "Bias major / internal", biasTxt(majS.bias) + " / " + biasTxt(intS.bias), majS.bias == 1 ? colBull : majS.bias == -1 ? colBear : color.white)
    dashRow(dash, 5, "Protected low / high", (na(protLo) ? "-" : str.tostring(protLo, format.mintick)) + " / " + (na(protHi) ? "-" : str.tostring(protHi, format.mintick)), color.white)
    dashRow(dash, 6, "Bull setup", stageName(bullSt.stage) + " (last: " + bullSt.reason + ")", colBull)
    dashRow(dash, 7, "Bear setup", stageName(bearSt.stage) + " (last: " + bearSt.reason + ")", colBear)
    dashRow(dash, 8, "Active pools / zones", str.tostring(pools.size()) + " / " + str.tostring(zones.size()), color.white)
    dashRow(dash, 9, "SMT", smtTxt, color.white)
    dashRow(dash, 10, "SFP volume", volAvail ? "OK (tick volume)" : "N/A - body break only", color.white)
    dashRow(dash, 11, "PDH/PDL | PWH/PWL", (pdOk ? "on" : "off") + " | " + (pwOk ? "on" : "off"), color.white)
    dashRow(dash, 12, "Countertrend (HTF vs chart)", counter ? "YES" : "no", counter ? colIdmS : color.white)
    dashRow(dash, 13, "Note", "Score/markers are a checklist, not a win rate", color.gray)
