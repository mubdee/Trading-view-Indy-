// ════════════════════════════════════════════════════════════════
// HTF CE0.5 — DEV · 3 เซ็ตอัพ (Hidden / Single / single liQ + ยืนยัน LTF) · 2 ออเดอร์ (Key Level + CE 0.5)  (Pine Script v6)
// ✏️ ไฟล์สำรองสำหรับแก้/ทดลอง (2026-11-20 · กัน Limit ผิดฝั่ง · SL buffer ATR · BE · สถิติแยกเซ็ตอัพ · MSS ต้องยืนยัน · ยังไม่ย้ายเข้า MAIN) · ไฟล์หลัก: indicators/htf-ce05/main/htf-ce05-main.pine
// ════════════════════════════════════════════════════════════════
//@version=6
indicator("HTF CE0.5 DEV", shorttitle = "HTF CE0.5 DEV", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 500)

// ═══════════════════════ INPUTS ═══════════════════════
string G0 = "ทั่วไป"
string htf    = input.timeframe("60", "HTF ของแท่ง Sweep (H1 / H4)", group = G0)
int    swLook = input.int(10, "แท่ง Sweep ต้องกวาด high/low ของ HTF ย้อนหลัง (แท่ง)", minval = 2, maxval = 100, group = G0)
int    evExp  = input.int(300, "เซ็ตอัพหมดอายุ (แท่ง TF กราฟ)", minval = 20, group = G0)
bool   use1   = input.bool(true, "1) Hidden Liquidity", group = G0)
bool   use2   = input.bool(true, "2) Single Liquidity (เข้าที่ CE)", group = G0)
bool   use3   = input.bool(true, "3) single liQ + ยืนยัน MSS บน TF กราฟ", group = G0)

string G1 = "MSS / IDM / LQ (TF กราฟ)"
int    pivLen  = input.int(3, "Swing length (MSS)", minval = 1, group = G1)
int    idmLen  = input.int(2, "Swing length (IDM / LQ)", minval = 1, group = G1)
bool   needFvg = input.bool(true, "แท่ง MSS ต้องมี FVG", group = G1)
int    mssBars = input.int(1, "ยืนยัน MSS: แท่งถัดไปต้องวิ่งต่อภายใน (แท่ง) · 0 = ไม่ต้องยืนยัน", minval = 0, maxval = 5, group = G1)
string mssConf = input.string("ปิดเลย High/Low แท่งทะลุ", "วิ่งต่อ =", options = ["ปิดเลย High/Low แท่งทะลุ", "ปิดเลยระดับ MSS"], group = G1)
bool   needIDM = input.bool(true, "Hidden: ต้องกิน IDM ก่อนเข้า", group = G1)
int    lqMin   = input.int(1, "LQ ก่อนถึง Key อย่างน้อย (swing ย่อย · 0 = ปิด)", minval = 0, group = G1)

string G5 = "Key Level (ออเดอร์ A)"
int    msnrLen = input.int(3, "Swing length (MSNR)", minval = 1, group = G5)
bool   kUse1   = input.bool(true, "ต้องมี MSNR ซ้อนบน TF", inline = "k1", group = G5)
string kTF1    = input.timeframe("15", "", inline = "k1", group = G5)
bool   kUse2   = input.bool(true, "และ TF", inline = "k2", group = G5)
string kTF2    = input.timeframe("30", "", inline = "k2", group = G5)
bool   kZone   = input.bool(false, "ต้องอยู่ในโซน OB / Demand-Supply ของ HTF ด้วย", group = G5)
float  kTol    = input.float(0.5, "ระยะที่นับว่าซ้อนกัน (x ATR)", minval = 0.05, step = 0.05, group = G5)
string kPick   = input.string("โซนสุดท้าย (ลึกสุด)", "เลือก Key", options = ["โซนสุดท้าย (ลึกสุด)", "ใกล้ราคาสุด"], group = G5)

string G6 = "CE 0.5 (ออเดอร์ B)"
bool   ceNeed = input.bool(true, "CE ต้องมี MSNR ซ้อน (QM / SBR-RBS / A-V)", group = G6)
float  ceTol  = input.float(0.5, "ระยะ MSNR จาก CE (x ATR)", minval = 0.05, step = 0.05, group = G6)

string G4 = "ออเดอร์"
bool   showBox  = input.bool(true, "แสดงกล่อง TP / SL ตอนเข้า", group = G4)
string tpMode   = input.string("RR คงที่", "TP ออเดอร์ Key", options = ["RR คงที่", "High/Low ของขา"], group = G4)
float  rr       = input.float(2.0, "RR (ออเดอร์ CE และโหมด RR คงที่)", minval = 0.5, step = 0.5, group = G4)
float  slAtr    = input.float(0.3, "SL เลยปลายไส้ / จุดต่ำสุดอีก (x ATR)", minval = 0, step = 0.05, group = G4)
float  minRisk  = input.float(0.5, "ระยะ SL ขั้นต่ำ (x ATR) · แคบกว่านี้ = ไม่ตั้ง", minval = 0, step = 0.1, group = G4)
bool   useBE    = input.bool(true, "เลื่อน SL มาที่ทุน เมื่อกำไรถึง", inline = "be", group = G4)
float  beR      = input.float(1.0, "R", minval = 0.25, step = 0.25, inline = "be", group = G4)
int    pendMax  = input.int(150, "Limit รอได้ (แท่ง)", minval = 5, group = G4)
int    maxTrade = input.int(100, "ปิดออเดอร์อัตโนมัติหลังเข้า (แท่ง)", minval = 5, group = G4)

string G3 = "การแสดงผล"
color  cBull    = input.color(#2962FF, "Buy", group = G3)
color  cBear    = input.color(#F23645, "Sell", group = G3)
color  cKey     = input.color(#787B86, "ปลายไส้ Sweep", group = G3)
color  cHid     = input.color(#FF9800, "Hidden / Single liQ", group = G3)
color  cIdm     = input.color(#9C27B0, "IDM", group = G3)
color  cCE      = input.color(#00BCD4, "CE 0.5", group = G3)
int    fadeTr   = input.int(75, "ความจางของเซ็ตอัพที่จบแล้ว (0-95)", minval = 0, maxval = 95, group = G3)
bool   showDash = input.bool(true, "แสดง Dashboard", group = G3)
string dashPos  = input.string("Top Right", "ตำแหน่ง Dashboard", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = G3)

color cSL   = #F23645
color cTP   = #089981
color cFade = color.new(color.gray, fadeTr)
color cNone = color.new(color.white, 100)

int   chartSec = timeframe.in_seconds(timeframe.period)
bool  htfOK    = timeframe.in_seconds(htf) > chartSec
bool  kOk1     = kUse1 and timeframe.in_seconds(kTF1) > chartSec
bool  kOk2     = kUse2 and timeframe.in_seconds(kTF2) > chartSec
float atrV     = ta.atr(14)

// ═══════════════════════ HELPERS ═══════════════════════
f_tfStr(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? "M" + str.tostring(s / 60) : s < 86400 ? "H" + str.tostring(s / 3600) : s < 604800 ? "D" + str.tostring(s / 86400) : tf

f_kStr(int k) =>
    k == 0 ? f_tfStr(timeframe.period) : k == 1 ? f_tfStr(kTF1) : f_tfStr(kTF2)

f_fade(array<line> ls, array<label> lbs) =>
    for l in ls
        line.set_color(l, cFade)
    for lb in lbs
        label.set_textcolor(lb, cFade)
    array.clear(ls)
    array.clear(lbs)

// ═══════════════════════ TYPES ═══════════════════════
// เซ็ตอัพ 1 ชุด = แท่ง Sweep บน HTF 1 แท่ง (ใช้ร่วมกันทั้ง 3 เซ็ตอัพ)
type Ev
    bool         bull
    int          sBar
    int          sT
    float        ext
    float        ce
    float        liq
    bool         single
    bool         live   = true
    bool         m1     = false
    int          m1Bar
    float        leg1
    float        idm
    bool         idmS   = false
    int          lq1    = 0
    bool         a1     = false
    bool         z3     = false
    int          z3Bar
    float        low3
    bool         m3     = false
    int          m3Bar
    float        leg3
    int          lq3    = 0
    bool         a3     = false
    bool         ceDone = false
    string       st1    = "—"
    string       st2    = "—"
    string       st3    = "—"
    array<line>  ls
    array<label> lbs

// ออเดอร์ Limit (A = Key Level · B = CE 0.5)
type Ord
    Ev     ev
    int    src
    string tag
    bool   bull
    float  entry
    float  sl
    float  tp
    int    born
    int    fillBar
    float  risk
    float  rrv
    bool   filled = false
    bool   be     = false
    line   ln
    label  lb
    box    bxTP
    box    bxSL

var array<Ord> ords = array.new<Ord>()

// ═══════════════════════ HTF : แท่ง Sweep + CE 0.5 (กลางไส้) + แท่งถัดไป ═══════════════════════
f_sweep(int n) =>
    float pLo = ta.lowest(low, n)[1]
    float pHi = ta.highest(high, n)[1]
    bool  bSw = low < pLo and close > pLo
    bool  sSw = high > pHi and close < pHi
    float bCE = (math.min(open[1], close[1]) + low[1]) / 2
    float sCE = (math.max(open[1], close[1]) + high[1]) / 2
    // [1] = แท่ง Sweep · [0] = แท่งถัดไป (liQ)
    [bSw[1], bCE, low[1], low, sSw[1], sCE, high[1], high, time[1], time]

// ใช้เฉพาะแท่งที่ปิดแล้ว (ไม่ repaint)
f_sweepC(int n) =>
    [a, b, c, d, e, f, g, h, i, j] = f_sweep(n)
    [a[1], b[1], c[1], d[1], e[1], f[1], g[1], h[1], i[1], j[1]]

[hB, hBCE, hBExt, hBLiq, hS, hSCE, hSExt, hSLiq, hSwT, hNxT] = request.security(syminfo.tickerid, htf, f_sweepC(swLook), lookahead = barmerge.lookahead_on)
bool newH = ta.change(hNxT) != 0

// ═══════════════════════ HTF : โซน OB / Demand-Supply (ตัวเลือก) ═══════════════════════
f_zone() =>
    float a    = ta.atr(14)
    bool  base = math.abs(close[1] - open[1]) <= 0.5 * a[1]
    bool  bOB  = close[1] < open[1] and close > open and close > high[1]
    bool  sOB  = close[1] > open[1] and close < open and close < low[1]
    bool  bDS  = base and close - open >= a
    bool  sDS  = base and open - close >= a
    int   bT   = bOB and bDS ? 3 : bOB ? 1 : bDS ? 2 : 0
    int   sT   = sOB and sDS ? 3 : sOB ? 1 : sDS ? 2 : 0
    [bT, sT, high[1], low[1], time]

f_zoneC() =>
    [bT, sT, zh, zl, t] = f_zone()
    [bT[1], sT[1], zh[1], zl[1], t[1]]

[zb, zs, zh, zl, zt] = request.security(syminfo.tickerid, htf, f_zoneC(), lookahead = barmerge.lookahead_on)
bool newZ = ta.change(zt) != 0

var array<float> zT  = array.new<float>()
var array<float> zB  = array.new<float>()
var array<int>   zD  = array.new<int>()
var array<int>   zTy = array.new<int>()

f_addZone(float t, float b, int d, int ty) =>
    zT.push(t)
    zB.push(b)
    zD.push(d)
    zTy.push(ty)
    if zT.size() > 60
        zT.shift()
        zB.shift()
        zD.shift()
        zTy.shift()

if kZone and newZ
    if zb > 0
        f_addZone(zh, zl, 1, zb)
    if zs > 0
        f_addZone(zh, zl, -1, zs)
if zT.size() > 0
    for i = zT.size() - 1 to 0
        if zD.get(i) == 1 ? close < zB.get(i) : close > zT.get(i)
            zT.remove(i)
            zB.remove(i)
            zD.remove(i)
            zTy.remove(i)

f_zoneHas(float p, int d) =>
    bool   ok = false
    string ty = ""
    if zT.size() > 0
        for i = 0 to zT.size() - 1
            if zD.get(i) == d and p <= zT.get(i) and p >= zB.get(i)
                int t = zTy.get(i)
                ok := true
                ty := t == 3 ? "OB+" + (d == 1 ? "Demand" : "Supply") : t == 2 ? (d == 1 ? "Demand" : "Supply") : "OB"
                break
    [ok, ty]

// ═══════════════════════ ระดับ MSNR หลาย TF ═══════════════════════
// V / A = body ของ swing low / high · RBS / SBR = body ของ swing ที่ถูกปิดทะลุ · QML = ไหล่ซ้ายของ Quasimodo (TF กราฟ)
// k: 0 = TF กราฟ · 1 = TF 1 · 2 = TF 2 · ระดับที่ราคาแตะแล้ว = ถูกใช้ ไม่นับอีก
var array<float>  lvP  = array.new<float>()
var array<int>    lvD  = array.new<int>()
var array<string> lvTy = array.new<string>()
var array<int>    lvK  = array.new<int>()
var array<int>    lvC  = array.new<int>()

f_addLv(float p, int d, string ty, int k) =>
    lvP.push(p)
    lvD.push(d)
    lvTy.push(ty)
    lvK.push(k)
    lvC.push(bar_index)
    if lvP.size() > 200
        lvP.shift()
        lvD.shift()
        lvTy.shift()
        lvK.shift()
        lvC.shift()

var array<float> uhP = array.new<float>()
var array<float> uhV = array.new<float>()
var array<int>   uhK = array.new<int>()
var array<float> ulP = array.new<float>()
var array<float> ulV = array.new<float>()
var array<int>   ulK = array.new<int>()

f_onPivot(int k, float ph, float bt, float pl, float bb) =>
    if not na(ph)
        f_addLv(bt, -1, "A", k)
        uhP.push(ph)
        uhV.push(bt)
        uhK.push(k)
        if uhP.size() > 90
            uhP.shift()
            uhV.shift()
            uhK.shift()
    if not na(pl)
        f_addLv(bb, 1, "V", k)
        ulP.push(pl)
        ulV.push(bb)
        ulK.push(k)
        if ulP.size() > 90
            ulP.shift()
            ulV.shift()
            ulK.shift()

f_pv(int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    [ph, math.max(open[len], close[len]), pl, math.min(open[len], close[len]), time]

f_pvC(int len) =>
    [a, b, c, d, t] = f_pv(len)
    [a[1], b[1], c[1], d[1], t[1]]

[p0h, p0t, p0l, p0b, p0T] = f_pvC(msnrLen)
[p1h, p1t, p1l, p1b, p1T] = request.security(syminfo.tickerid, kTF1, f_pvC(msnrLen), lookahead = barmerge.lookahead_on)
[p2h, p2t, p2l, p2b, p2T] = request.security(syminfo.tickerid, kTF2, f_pvC(msnrLen), lookahead = barmerge.lookahead_on)
bool n1 = ta.change(p1T) != 0
bool n2 = ta.change(p2T) != 0

f_onPivot(0, p0h, p0t, p0l, p0b)
if kOk1 and n1
    f_onPivot(1, p1h, p1t, p1l, p1b)
if kOk2 and n2
    f_onPivot(2, p2h, p2t, p2l, p2b)

// swing ที่ถูกปิดทะลุ → SBR / RBS
if uhP.size() > 0
    for i = uhP.size() - 1 to 0
        if close > uhP.get(i)
            f_addLv(uhV.get(i), 1, "RBS", uhK.get(i))
            uhP.remove(i)
            uhV.remove(i)
            uhK.remove(i)
if ulP.size() > 0
    for i = ulP.size() - 1 to 0
        if close < ulP.get(i)
            f_addLv(ulV.get(i), -1, "SBR", ulK.get(i))
            ulP.remove(i)
            ulV.remove(i)
            ulK.remove(i)

// QML (TF กราฟ)
var float qH  = na
var int   qHB = na
var float qL  = na
var int   qLB = na
var float qmS = na
var float qmSTrig = na
var float qmB = na
var float qmBTrig = na
if not na(p0h)
    if not na(qH) and p0h > qH and qLB > qHB
        qmS     := qH
        qmSTrig := qL
    qH  := p0h
    qHB := bar_index
if not na(p0l)
    if not na(qL) and p0l < qL and qHB > qLB
        qmB     := qL
        qmBTrig := qH
    qL  := p0l
    qLB := bar_index
if not na(qmS) and close < qmSTrig
    f_addLv(qmS, -1, "QM", 0)
    qmS := na
if not na(qmB) and close > qmBTrig
    f_addLv(qmB, 1, "QM", 0)
    qmB := na

// มีระดับ MSNR บน TF k อยู่ใกล้ราคา p หรือไม่
f_hasLv(float p, int d, int k, float tol) =>
    bool f = false
    if lvP.size() > 0
        for i = 0 to lvP.size() - 1
            if lvK.get(i) == k and lvD.get(i) == d and math.abs(lvP.get(i) - p) <= tol
                f := true
                break
    f

// ระดับนี้ซ้อนทุก TF ที่เปิด (+ โซน HTF ถ้าเปิด) หรือไม่ → [ผ่าน, ข้อความ]
f_stack(float p, int d) =>
    float  tol = kTol * atrV
    bool   ok  = true
    string tx  = ""
    if kOk1
        if f_hasLv(p, d, 1, tol)
            tx += "+" + f_tfStr(kTF1)
        else
            ok := false
    if kOk2
        if f_hasLv(p, d, 2, tol)
            tx += "+" + f_tfStr(kTF2)
        else
            ok := false
    if kZone
        [zf, zty] = f_zoneHas(p, d)
        if zf
            tx += " · " + zty + " " + f_tfStr(htf)
        else
            ok := false
    [ok, tx]

// Key Level ในช่วงราคา [lo, hi] = ระดับ MSNR บน TF กราฟที่ยังไม่ถูกใช้ + ซ้อนตาม TF ที่เปิด
f_findKey(int d, float lo, float hi) =>
    float  best = na
    string bt   = ""
    float  lo2  = d == 1 ? lo : math.max(lo, close)
    float  hi2  = d == 1 ? math.min(hi, close) : hi
    if lvP.size() > 0
        for i = 0 to lvP.size() - 1
            float p = lvP.get(i)
            if lvK.get(i) == 0 and lvD.get(i) == d and p >= lo2 and p <= hi2 and p != close
                [ok, tx] = f_stack(p, d)
                if ok
                    bool deep = kPick == "โซนสุดท้าย (ลึกสุด)"
                    if na(best) or (deep ? (d == 1 ? p < best : p > best) : (d == 1 ? p > best : p < best))
                        best := p
                        bt   := lvTy.get(i) + " " + f_tfStr(timeframe.period) + tx
    [best, bt]

// CE ต้องมีระดับ MSNR (TF ไหนก็ได้) ซ้อนอยู่ใกล้ ๆ → [มี, ชนิด]
f_ceMsnr(int d, float ce) =>
    float  tol  = ceTol * atrV
    float  bd   = na
    string ty   = ""
    if lvP.size() > 0
        for i = 0 to lvP.size() - 1
            float dist = math.abs(lvP.get(i) - ce)
            if lvD.get(i) == d and dist <= tol and (na(bd) or dist < bd)
                bd := dist
                ty := lvTy.get(i) + " " + f_kStr(lvK.get(i))
    [not na(bd), ty]

// ═══════════════════════ MSS / IDM (TF กราฟ) ═══════════════════════
float ph  = ta.pivothigh(high, pivLen, pivLen)
float pl  = ta.pivotlow(low, pivLen, pivLen)
float iph = ta.pivothigh(high, idmLen, idmLen)
float ipl = ta.pivotlow(low, idmLen, idmLen)
int   ipT = time[idmLen]

var float shP = na
var int   shT = na
var bool  shU = true
var float slP = na
var int   slT = na
var bool  slU = true
if not na(ph)
    shP := ph
    shT := time[pivLen]
    shU := false
if not na(pl)
    slP := pl
    slT := time[pivLen]
    slU := false

bool fvgB = low > high[2] or low[1] > high[3]
bool fvgS = high < low[2] or high[1] < low[3]

// MSS ต้องยืนยัน: หลังแท่งทะลุ แท่งถัดไป (ภายใน mssBars แท่ง) ต้องวิ่งต่อ
// ปิดกลับไปอีกฝั่งของระดับ MSS ก่อน = แค่ sweep → ยกเลิก
bool   strictC = mssConf == "ปิดเลย High/Low แท่งทะลุ"
var bool  bPend = false
var float bPLvl = na
var int   bPFrom = na
var float bPEx  = na
var int   bPBar = na
var bool  bPFvg = false
var bool  sPend = false
var float sPLvl = na
var int   sPFrom = na
var float sPEx  = na
var int   sPBar = na
var bool  sPFvg = false

bool  bMss  = false
float bMssL = na
int   bMssT = na
if not shU and not na(shP) and close > shP
    shU := true
    if mssBars == 0
        if not needFvg or fvgB
            bMss  := true
            bMssL := shP
            bMssT := shT
    else
        bPend  := true
        bPLvl  := shP
        bPFrom := shT
        bPEx   := high
        bPBar  := bar_index
        bPFvg  := fvgB
else if bPend and bar_index > bPBar
    bPFvg := bPFvg or fvgB
    if close < bPLvl
        bPend := false
    else if strictC ? close > bPEx : close > bPLvl
        bPend := false
        if not needFvg or bPFvg
            bMss  := true
            bMssL := bPLvl
            bMssT := bPFrom
    else if bar_index - bPBar >= mssBars
        bPend := false

bool  sMss  = false
float sMssL = na
int   sMssT = na
if not slU and not na(slP) and close < slP
    slU := true
    if mssBars == 0
        if not needFvg or fvgS
            sMss  := true
            sMssL := slP
            sMssT := slT
    else
        sPend  := true
        sPLvl  := slP
        sPFrom := slT
        sPEx   := low
        sPBar  := bar_index
        sPFvg  := fvgS
else if sPend and bar_index > sPBar
    sPFvg := sPFvg or fvgS
    if close > sPLvl
        sPend := false
    else if strictC ? close < sPEx : close < sPLvl
        sPend := false
        if not needFvg or sPFvg
            sMss  := true
            sMssL := sPLvl
            sMssT := sPFrom
    else if bar_index - sPBar >= mssBars
        sPend := false

var int   lbTime = na
var float lbLvl  = na
var int   lbFrom = na
var int   lsTime = na
var float lsLvl  = na
var int   lsFrom = na
if bMss
    lbTime := time
    lbLvl  := bMssL
    lbFrom := bMssT
if sMss
    lsTime := time
    lsLvl  := sMssL
    lsFrom := sMssT

// ═══════════════════════ ออเดอร์ ═══════════════════════
f_name(int src) =>
    src == 1 ? "Hidden" : src == 2 ? "Single" : "LTF"

f_setSt(Ev ev, int src, string s) =>
    if src == 1
        ev.st1 := s
    else if src == 2
        ev.st2 := s
    else
        ev.st3 := s

// ตั้ง Limit → คืน "" ถ้าตั้งได้ · ไม่งั้นคืนเหตุผล
// ไม่ตั้ง: ซ้ำราคาเดิม · ราคาผ่านจุดเข้าไปแล้ว (Limit ผิดฝั่ง) · SL แคบเกิน
f_place(Ev ev, int src, string tag, float entry, float sl0, float tp0) =>
    bool  bull = ev.bull
    float tolD = kTol * atrV
    bool  dup  = false
    if ords.size() > 0
        for o in ords
            if o.bull == bull and math.abs(o.entry - entry) <= tolD
                dup := true
                break
    float  sl   = bull ? sl0 - slAtr * atrV : sl0 + slAtr * atrV
    float  risk = math.abs(entry - sl)
    string why  = dup ? "ซ้ำกับออเดอร์ที่มีแล้ว" : (bull ? entry >= close : entry <= close) ? "ราคาผ่านจุดเข้าแล้ว" : (bull ? entry <= sl : entry >= sl) ? "SL ผิดฝั่ง" : risk < minRisk * atrV ? "SL แคบเกิน" : ""
    if why == ""
        float tp = tp0
        if na(tp) or (bull ? tp <= entry : tp >= entry)
            tp := bull ? entry + risk * rr : entry - risk * rr
        float  rrv = math.abs(tp - entry) / risk
        color  col = bull ? cBull : cBear
        string tx  = f_name(src) + " · " + tag + "\n" + (bull ? "Buy" : "Sell") + " Limit " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " (" + str.tostring(risk, "#.##") + ") | TP " + str.tostring(tp, format.mintick) + " | RR 1:" + str.tostring(rrv, "#.##")
        line   ln  = line.new(bar_index, entry, bar_index + 5, entry, color = col, width = 2, style = line.style_dashed)
        label  lb  = label.new(bar_index + 5, entry, tx, style = label.style_label_left, color = color.new(col, 85), textcolor = col, size = size.small)
        ords.push(Ord.new(ev = ev, src = src, tag = tag, bull = bull, entry = entry, sl = sl, tp = tp, risk = risk, rrv = rrv, born = bar_index, ln = ln, lb = lb))
        alert(syminfo.ticker + " " + timeframe.period + " | " + f_name(src) + " · " + tag + " | " + (bull ? "Buy" : "Sell") + " Limit " + str.tostring(entry, format.mintick) + " SL " + str.tostring(sl, format.mintick) + " TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
    why

// ออเดอร์ A (Key) + B (CE) · Key กับ CE ใกล้กัน = ออเดอร์เดียว ★ → คืนข้อความสถานะ
f_pair(Ev ev, int src, float kp, string kt, float sl, float tp) =>
    int d = ev.bull ? 1 : -1
    [cOk, cTy] = f_ceMsnr(d, ev.ce)
    bool   ceOk = not ev.ceDone and (cOk or not ceNeed) and (ev.bull ? ev.ce > ev.ext : ev.ce < ev.ext)
    string out  = ""
    if ceOk and math.abs(kp - ev.ce) <= kTol * atrV
        string r = f_place(ev, src, "★ Key " + kt + " + CE", kp, sl, tp)
        ev.ceDone := true
        out := r == "" ? "Limit ★ Key+CE" : "Key: " + r
    else
        string r1 = f_place(ev, src, "Key " + kt, kp, sl, tp)
        out := r1 == "" ? "Limit Key" : "Key: " + r1
        if ceOk
            string r2 = f_place(ev, src, "CE" + (cOk ? " + " + cTy : ""), ev.ce, ev.ext, na)
            ev.ceDone := true
            out += r2 == "" ? " + CE" : " · CE: " + r2
    out

// ออเดอร์พร้อมเข้าเมื่อเงื่อนไขของเซ็ตอัพครบ
f_armed(Ord o) =>
    o.src == 1 ? ((not needIDM or o.ev.idmS) and o.ev.lq1 >= lqMin) : o.src == 3 ? o.ev.lq3 >= lqMin : true

// ═══════════════════════ เซ็ตอัพ ═══════════════════════
f_kill(Ev ev, string why) =>
    f_fade(ev.ls, ev.lbs)
    ev.live := false
    if use1 and not ev.a1
        ev.st1 := why
    if use2 and ev.single and not ev.ceDone
        ev.st2 := why
    if use3 and ev.single and not ev.a3
        ev.st3 := why

f_newEv(bool bull, int sT, int nT, float ext, float ce, float liq, bool mssBefore, float mL, int mFrom) =>
    Ev ev = Ev.new(bull = bull, sBar = bar_index, sT = sT, ext = ext, ce = ce, liq = liq, single = bull ? liq > ce : liq < ce, leg1 = bull ? high : low, ls = array.new<line>(), lbs = array.new<label>())
    color  col = bull ? cBull : cBear
    string tfs = f_tfStr(htf)
    ev.ls.push(line.new(sT, ext, time, ext, xloc = xloc.bar_time, color = cKey, style = line.style_dotted))
    ev.lbs.push(label.new(sT, ext, "Sweep " + tfs, xloc = xloc.bar_time, style = bull ? label.style_label_up : label.style_label_down, color = cNone, textcolor = cKey, size = size.tiny))
    ev.ls.push(line.new(sT, ce, time, ce, xloc = xloc.bar_time, color = cCE, width = 2))
    ev.lbs.push(label.new(sT, ce, "CE 0.5", xloc = xloc.bar_time, style = label.style_label_right, color = cNone, textcolor = cCE, size = size.tiny))
    ev.ls.push(line.new(nT, liq, time, liq, xloc = xloc.bar_time, color = cHid, style = line.style_dashed))
    ev.lbs.push(label.new(nT, liq, (ev.single ? "hidden / single liQ " : "hidden liQ ") + tfs, xloc = xloc.bar_time, style = label.style_label_left, color = cNone, textcolor = cHid, size = size.tiny))
    if mssBefore
        ev.m1    := true
        ev.m1Bar := bar_index
        ev.ls.push(line.new(mFrom, mL, time, mL, xloc = xloc.bar_time, color = col, style = line.style_dotted))
        ev.lbs.push(label.new(mFrom, mL, "MSS", xloc = xloc.bar_time, style = bull ? label.style_label_down : label.style_label_up, color = cNone, textcolor = col, size = size.tiny))
    ev.st1 := not use1 ? "ปิด" : ev.m1 ? "รอ Key Level" : "รอ MSS"
    ev.st2 := not use2 ? "ปิด" : ev.single ? "—" : "ไม่ใช่ Single"
    ev.st3 := not use3 ? "ปิด" : ev.single ? "รอราคาถึง CE" : "ไม่ใช่ Single"
    ev

f_ev(Ev ev, bool mssNow, float mssL, int mssFrom, float ipv) =>
    bool  bull = ev.bull
    int   d    = bull ? 1 : -1
    color col  = bull ? cBull : cBear
    for l in ev.ls
        line.set_x2(l, time)
    if bull ? close < ev.ext : close > ev.ext
        f_kill(ev, "Invalid")
    else if bar_index - ev.sBar > evExp
        f_kill(ev, "หมดอายุ")
    else
        // ── 2) Single Liquidity: Limit ที่ CE 0.5 (ต้องมี MSNR ซ้อน) ──
        if use2 and ev.single and not ev.ceDone
            [cOk, cTy] = f_ceMsnr(d, ev.ce)
            if cOk or not ceNeed
                string r = f_place(ev, 2, "CE" + (cOk ? " + " + cTy : ""), ev.ce, ev.ext, na)
                ev.ceDone := true
                ev.st2    := r == "" ? "Limit CE" : "CE: " + r
            else
                ev.st2 := "CE ไม่มี MSNR ซ้อน"
        // ── 1) Hidden Liquidity: MSS → Key Level ระหว่างปลายไส้ sweep กับ hidden liQ ──
        if use1
            ev.leg1 := bull ? math.max(ev.leg1, high) : math.min(ev.leg1, low)
            if not ev.m1 and mssNow
                ev.m1    := true
                ev.m1Bar := bar_index
                ev.ls.push(line.new(mssFrom, mssL, time, mssL, xloc = xloc.bar_time, color = col, style = line.style_dotted))
                ev.lbs.push(label.new(mssFrom, mssL, "MSS", xloc = xloc.bar_time, style = bull ? label.style_label_down : label.style_label_up, color = cNone, textcolor = col, size = size.tiny))
            if ev.m1
                if not na(ipv) and bar_index - idmLen > ev.m1Bar
                    ev.lq1 := ev.lq1 + 1
                    if na(ev.idm) and (bull ? ipv > ev.liq : ipv < ev.liq)
                        ev.idm := ipv
                        ev.ls.push(line.new(ipT, ipv, time, ipv, xloc = xloc.bar_time, color = cIdm, style = line.style_dotted))
                        ev.lbs.push(label.new(ipT, ipv, "IDM", xloc = xloc.bar_time, style = bull ? label.style_label_up : label.style_label_down, color = cNone, textcolor = cIdm, size = size.tiny))
                if not na(ev.idm) and not ev.idmS and (bull ? low < ev.idm : high > ev.idm)
                    ev.idmS := true
            if not ev.a1
                if not ev.m1
                    ev.st1 := "รอ MSS"
                else
                    [kp, kt] = f_findKey(d, math.min(ev.ext, ev.liq), math.max(ev.ext, ev.liq))
                    if na(kp)
                        ev.st1 := "รอ Key Level"
                    else
                        ev.a1  := true
                        ev.st1 := f_pair(ev, 1, kp, kt, ev.ext, tpMode == "RR คงที่" ? na : ev.leg1)
        // ── 3) single liQ + ยืนยัน: ถึงโซน CE → MSS บน TF กราฟ → Key Level ในขา MSS ──
        if use3 and ev.single and not ev.a3
            if not ev.z3
                ev.st3 := "รอราคาถึง CE"
                if bull ? low <= ev.ce : high >= ev.ce
                    ev.z3    := true
                    ev.z3Bar := bar_index
                    ev.low3  := bull ? low : high
                    ev.st3   := "รอ MSS " + f_tfStr(timeframe.period)
            else if not ev.m3
                ev.low3 := bull ? math.min(ev.low3, low) : math.max(ev.low3, high)
                if mssNow and bar_index > ev.z3Bar
                    ev.m3    := true
                    ev.m3Bar := bar_index
                    ev.leg3  := bull ? high : low
                    ev.ls.push(line.new(mssFrom, mssL, time, mssL, xloc = xloc.bar_time, color = col, style = line.style_dotted))
                    ev.lbs.push(label.new(mssFrom, mssL, "MSS (3)", xloc = xloc.bar_time, style = bull ? label.style_label_down : label.style_label_up, color = cNone, textcolor = col, size = size.tiny))
            if ev.m3
                ev.leg3 := bull ? math.max(ev.leg3, high) : math.min(ev.leg3, low)
                if not na(ipv) and bar_index - idmLen > ev.m3Bar
                    ev.lq3 := ev.lq3 + 1
                [kp, kt] = f_findKey(d, math.min(ev.low3, ev.leg3), math.max(ev.low3, ev.leg3))
                if na(kp)
                    ev.st3 := "รอ Key Level"
                else
                    ev.a3  := true
                    float sl3 = bull ? math.max(ev.ext, ev.low3) : math.min(ev.ext, ev.low3)
                    ev.st3 := f_pair(ev, 3, kp, kt, sl3, tpMode == "RR คงที่" ? na : ev.leg3)
    ev

var Ev evB = na
var Ev evS = na

if htfOK and newH
    if hB and hBLiq > hBExt
        if not na(evB) and evB.live
            f_kill(evB, "ถูกแทนที่")
        evB := f_newEv(true, hSwT, hNxT, hBExt, hBCE, hBLiq, not na(lbTime) and lbTime >= hSwT, lbLvl, lbFrom)
    if hS and hSLiq < hSExt
        if not na(evS) and evS.live
            f_kill(evS, "ถูกแทนที่")
        evS := f_newEv(false, hSwT, hNxT, hSExt, hSCE, hSLiq, not na(lsTime) and lsTime >= hSwT, lsLvl, lsFrom)

if not na(evB) and evB.live
    f_ev(evB, bMss, bMssL, bMssT, ipl)
if not na(evS) and evS.live
    f_ev(evS, sMss, sMssL, sMssT, iph)

// ═══════════════════════ จัดการออเดอร์ ═══════════════════════
// สถิติแยกเซ็ตอัพ · index = (เซ็ตอัพ - 1) + (Buy 0 / Sell 3)
var array<int> stW = array.new<int>(6, 0)
var array<int> stL = array.new<int>(6, 0)
var array<int> stB = array.new<int>(6, 0)
var float      sumR = 0.0

f_kind(Ord o) =>
    str.contains(o.tag, "Key") ? "Key" : "CE"

f_done(Ord o, string res, color rc, float y) =>
    line.set_color(o.ln, cFade)
    label.set_color(o.lb, color.new(color.gray, 90))
    label.set_textcolor(o.lb, color.new(color.gray, 40))
    if not na(o.bxTP)
        box.set_right(o.bxTP, bar_index)
        box.set_right(o.bxSL, bar_index)
        box.set_bgcolor(o.bxTP, color.new(color.gray, 90))
        box.set_bgcolor(o.bxSL, color.new(color.gray, 90))
        box.set_border_color(o.bxTP, cFade)
        box.set_border_color(o.bxSL, cFade)
    label.new(bar_index, y, f_name(o.src) + " · " + f_kind(o) + " " + res + (res == "TP ✓" ? " +" + str.tostring(o.rrv, "#.#") + "R" : res == "SL ✗" ? " -1R" : ""), style = label.style_label_left, color = cNone, textcolor = color.new(rc, 30), size = size.small)
    f_setSt(o.ev, o.src, f_kind(o) + " " + res)

if ords.size() > 0
    for i = ords.size() - 1 to 0
        Ord o = ords.get(i)
        if bar_index > o.born
            string res = ""
            color  rc  = color.gray
            float  ry  = close
            bool   b   = o.bull
            if not o.filled
                line.set_x2(o.ln, bar_index + 5)
                label.set_x(o.lb, bar_index + 5)
                if b ? low <= o.entry : high >= o.entry
                    if f_armed(o)
                        o.filled  := true
                        o.fillBar := bar_index
                        line.set_style(o.ln, line.style_solid)
                        if showBox
                            o.bxTP := box.new(bar_index, math.max(o.tp, o.entry), bar_index + 1, math.min(o.tp, o.entry), border_color = color.new(cTP, 40), bgcolor = color.new(cTP, 82))
                            o.bxSL := box.new(bar_index, math.max(o.sl, o.entry), bar_index + 1, math.min(o.sl, o.entry), border_color = color.new(cSL, 40), bgcolor = color.new(cSL, 82))
                        f_setSt(o.ev, o.src, f_kind(o) + " เข้าแล้ว")
                        alert(syminfo.ticker + " " + timeframe.period + " | " + f_name(o.src) + " · " + o.tag + " | เข้าแล้ว @ " + str.tostring(o.entry, format.mintick), alert.freq_once_per_bar_close)
                        if b ? low <= o.sl : high >= o.sl
                            res := "SL ✗"
                            rc  := cSL
                            ry  := o.sl
                    else
                        res := "ยกเลิก · แตะก่อนครบเงื่อนไข"
                        ry  := o.entry
                else if b ? high >= o.tp : low <= o.tp
                    res := "Miss · ไม่ถึง Entry"
                    ry  := o.tp
                else if bar_index - o.born > pendMax
                    res := "หมดเวลา Limit"
                    ry  := o.entry
            else
                bool hitSL = b ? low <= o.sl : high >= o.sl
                bool hitTP = b ? high >= o.tp : low <= o.tp
                if hitSL
                    res := o.be ? "BE" : "SL ✗"
                    rc  := o.be ? color.gray : cSL
                    ry  := o.sl
                else if hitTP
                    res := "TP ✓"
                    rc  := cTP
                    ry  := o.tp
                else if bar_index - o.fillBar >= maxTrade
                    res := "หมดเวลา"
                else
                    if not na(o.bxTP)
                        box.set_right(o.bxTP, bar_index + 1)
                        box.set_right(o.bxSL, bar_index + 1)
                    // กำไรถึง beR → เลื่อน SL มาที่ทุน (มีผลแท่งถัดไป)
                    if useBE and not o.be and (b ? high >= o.entry + o.risk * beR : low <= o.entry - o.risk * beR)
                        o.be := true
                        o.sl := o.entry
                        if not na(o.bxSL)
                            box.set_top(o.bxSL, o.entry)
                            box.set_bottom(o.bxSL, o.entry)
                        label.set_text(o.lb, label.get_text(o.lb) + "\nSL → ทุน")
            if res != ""
                int ix = (o.src - 1) + (o.bull ? 0 : 3)
                if res == "TP ✓"
                    stW.set(ix, stW.get(ix) + 1)
                    sumR += o.rrv
                else if res == "SL ✗"
                    stL.set(ix, stL.get(ix) + 1)
                    sumR -= 1.0
                else if res == "BE"
                    stB.set(ix, stB.get(ix) + 1)
                else if res == "หมดเวลา" and o.filled
                    sumR += (b ? close - o.entry : o.entry - close) / o.risk
                f_done(o, res, rc, ry)
                ords.remove(i)

// ระดับ MSNR ที่ราคาแตะแล้ว = ถูกใช้
if lvP.size() > 0
    for i = lvP.size() - 1 to 0
        if bar_index > lvC.get(i)
            float p = lvP.get(i)
            if lvD.get(i) == 1 ? low <= p : high >= p
                lvP.remove(i)
                lvD.remove(i)
                lvTy.remove(i)
                lvK.remove(i)
                lvC.remove(i)

// ═══════════════════════ DASHBOARD ═══════════════════════
f_pos(string p) =>
    switch p
        "Top Right"    => position.top_right
        "Bottom Right" => position.bottom_right
        "Top Left"     => position.top_left
        => position.bottom_left

f_col(string s) =>
    str.contains(s, "✓") ? cTP : str.contains(s, "✗") ? cSL : (str.contains(s, "ผ่านจุดเข้า") or str.contains(s, "แคบเกิน") or str.contains(s, "ผิดฝั่ง") or s == "BE" or str.contains(s, " BE") or s == "Invalid" or s == "หมดอายุ" or s == "ปิด" or str.contains(s, "ไม่") or str.contains(s, "หมดเวลา") or str.contains(s, "ยกเลิก") or str.contains(s, "แทนที่") or str.contains(s, "Miss") or str.contains(s, "ซ้ำ")) ? color.gray : (str.contains(s, "Limit") or str.contains(s, "เข้าแล้ว")) ? color.yellow : color.white

f_wl(int ix) =>
    str.tostring(stW.get(ix)) + " / " + str.tostring(stL.get(ix)) + " / " + str.tostring(stB.get(ix))

f_st(Ev ev, int k) =>
    na(ev) ? "—" : k == 1 ? ev.st1 : k == 2 ? ev.st2 : ev.st3

f_lv(Ev ev, int k) =>
    na(ev) ? "-" : k == 1 ? "liQ " + str.tostring(ev.liq, format.mintick) : "CE " + str.tostring(ev.ce, format.mintick)

var table dash = table.new(f_pos(dashPos), 4, 10, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(color.gray, 70))

if showDash and barstate.islast
    int nPend = 0
    int nOpen = 0
    for o in ords
        if o.filled
            nOpen += 1
        else
            nPend += 1
    table.cell(dash, 0, 0, "HTF CE0.5 DEV", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, "สถานะ", text_color = color.white, text_size = size.small)
    table.cell(dash, 2, 0, "Level", text_color = color.white, text_size = size.small)
    table.cell(dash, 3, 0, "TP / SL / BE", text_color = color.white, text_size = size.small)
    array<string> nm = array.from("1) Hidden", "2) Single", "3) LTF")
    for k = 1 to 3
        table.cell(dash, 0, k, nm.get(k - 1) + " ▲", text_color = cBull, text_size = size.small, text_halign = text.align_left)
        table.cell(dash, 1, k, f_st(evB, k), text_color = f_col(f_st(evB, k)), text_size = size.small)
        table.cell(dash, 2, k, f_lv(evB, k), text_color = color.gray, text_size = size.small)
        table.cell(dash, 0, k + 3, nm.get(k - 1) + " ▼", text_color = cBear, text_size = size.small, text_halign = text.align_left)
        table.cell(dash, 1, k + 3, f_st(evS, k), text_color = f_col(f_st(evS, k)), text_size = size.small)
        table.cell(dash, 2, k + 3, f_lv(evS, k), text_color = color.gray, text_size = size.small)
        table.cell(dash, 3, k, f_wl(k - 1), text_color = color.white, text_size = size.small)
        table.cell(dash, 3, k + 3, f_wl(k + 2), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 7, "ออเดอร์", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 7, "รอ Limit " + str.tostring(nPend) + " · เปิดอยู่ " + str.tostring(nOpen), text_color = color.white, text_size = size.small)
    table.cell(dash, 2, 7, "", text_size = size.small)
    table.cell(dash, 3, 7, "", text_size = size.small)
    table.cell(dash, 0, 8, "สถิติ", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    int tW = 0
    int tL = 0
    int tB = 0
    for j = 0 to 5
        tW += stW.get(j)
        tL += stL.get(j)
        tB += stB.get(j)
    table.cell(dash, 1, 8, "TP " + str.tostring(tW) + " / SL " + str.tostring(tL) + " / BE " + str.tostring(tB) + (tW + tL > 0 ? " · Win " + str.tostring(tW * 100.0 / (tW + tL), "#") + "%" : ""), text_color = color.white, text_size = size.small)
    table.cell(dash, 3, 8, (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.#") + "R", text_color = sumR > 0 ? cTP : sumR < 0 ? cSL : color.white, text_size = size.small)
    table.cell(dash, 2, 8, "", text_size = size.small)
    string kTx = f_tfStr(timeframe.period) + (kOk1 ? "+" + f_tfStr(kTF1) : "") + (kOk2 ? "+" + f_tfStr(kTF2) : "") + (kZone ? " · โซน " + f_tfStr(htf) : "")
    table.cell(dash, 0, 9, "HTF / Key", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 9, htfOK ? f_tfStr(htf) + " · Key " + kTx : "HTF ต้องสูงกว่า TF กราฟ", text_color = htfOK ? color.gray : cBear, text_size = size.small)
    table.cell(dash, 2, 9, "", text_size = size.small)
    table.cell(dash, 3, 9, "", text_size = size.small)
