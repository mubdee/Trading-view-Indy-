string obDraw     = input.string("Wick", "วาดโซนจาก (TF ชาร์ต)", options=["Wick", "Open"], group=OBG1, display=display.none, tooltip="Wick = ขอบโซนจากไส้แท่ง OB\nOpen = ขอบโซนจากตัวเนื้อแท่ง OB (โซนแคบกว่า)")
string obDrawH    = input.string("Open", "วาดโซนจาก (TF ใหญ่)", options=["Wick", "Open"], group=OBG1, display=display.none, tooltip="โซน H1/H4 จากไส้มักสูงมากบนกราฟเล็ก → ค่าเริ่ม Open (ขอบในจากเนื้อแท่ง · ขอบนอกยังเป็นไส้)")
