string OBG0 = "OB · คัดคุณภาพ"
bool   obReqOpp   = input.bool(false, "แท่ง OB ต้องเป็นสีตรงข้าม (แบบ JP7FX)", display=display.none, group=OBG0, tooltip="เปิด = Demand OB ต้องเป็นแท่งแดง / Supply OB ต้องเป็นแท่งเขียว\nปิด = แท่ง OB เป็นสีอะไรก็ได้")
bool   obPrevOn   = input.bool(true, "แท่งก่อนหน้าห้ามทำไส้เกินแท่ง OB", display=display.none, group=OBG0, inline="obp", tooltip="Demand: แท่งก่อนหน้าห้ามมีไส้ต่ำกว่า Low ของแท่ง OB\nSupply: แท่งก่อนหน้าห้ามมีไส้สูงกว่า High ของแท่ง OB")
int    obPrevN    = input.int(2, "แท่ง", minval=1, maxval=10, group=OBG0, inline="obp", display=display.none)
bool   obSweep    = input.bool(true, "แท่ง OB ต้องกวาดไส้แท่งก่อนหน้า", display=display.none, group=OBG0, tooltip="Demand: Low แท่ง OB < Low แท่งก่อนหน้า · Supply: High แท่ง OB > High แท่งก่อนหน้า")
