bool   obShowMid  = input.bool(false, "เส้น 50%", display=display.none, group=OBG1, inline="obmid", tooltip="ค่าเริ่ม = ปิด เพื่อไม่ให้เส้นเต็มเพดาน 500 เส้น (TradingView จะลบเส้นเก่าสุดของสคริปต์ทิ้งเอง เช่น เส้น MSNR / SMT)")
