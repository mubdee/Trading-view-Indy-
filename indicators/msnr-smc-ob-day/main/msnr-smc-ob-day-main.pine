// ════════════════════════════════════════════════════════════════
// MSNR × SMC + OB DAY — MAIN · แยกจาก MSNR × SMC + OB PRO (2026-11-27 MAIN) (Pine Script v6)
// ⭐ ไฟล์หลัก · ไฟล์สำรองสำหรับแก้: indicators/msnr-smc-ob-day/msnr-smc-ob-day-dev.pine
// ตัวเดิม (MSNR × SMC + OB PRO) ไม่แก้
// DAY (5) 2026-11-28: ตัวคอนเฟิมเพิ่ม 2 ตัว (คำนวณบน TF กราฟ · ไม่เพิ่ม request.security)
//   1. qCISD / tCISD: Score +1 เมื่อเกิด CISD ตรงทิศระหว่าง Sweep → MSS · เส้นสีฟ้าบนกราฟ (qCISD เส้นทึบ · tCISD เส้นประ)
//      tCISD = ชุดแท่งสวนทาง (≥ n แท่ง) แล้วแท่งปิดทะลุ Open แท่งแรกของชุด · qCISD = tCISD ที่ขาทำ High/Low ของ Quarter และกวาด Quarter ก่อนหน้า
//   2. SSMT (Sequential SMT ตาม Quarter วัน / 90m / Micro): แยกเป็นแต้มของตัวเอง (เดิมรวมอยู่ในแต้ม SMT)
//   3. Dashboard แถว CISD ล่าสุด
//   4. CISD เกิดเฉพาะที่จุดสำคัญ (ติ๊กเลือกได้): OB · FVG TF ใหญ่ (TF A / B) · เลเวล MSNR HTF · Liquidity ที่ถูกกวาด (PDH/PDL · Asia H/L · EQH/EQL · swing)
//   5. qCISD ต้องมี SSMT ตรงทิศ (แบบสาย Quarterly Theory · ปิดได้) · เส้น CISD เป็นสีฟ้า
// DAY (4) 2026-11-27: QT Micro บนกราฟ — แถบ Quarter แถวที่ 3 (22.5 นาที × 4 ของ 90 นาทีปัจจุบัน · TF ≤ M5) + เส้น TO Micro (เปิด/ปิดได้)
// DAY (3) 2026-11-27: QT แม่นขึ้น (ทั้ง วัน · 90m · Micro)
//   1. Efficiency Ratio (Kaufman) ของ Q1: กรอบแคบ หรือ ER < 0.3 = ไซด์เวย์ (A ↔) · Q1 วิ่งแรง (D) ต้อง ER ≥ 0.5
//   2. หลอก (M) ต้องกวาดเกินกรอบเก่าอย่างน้อย 0.15 × เกณฑ์กรอบแคบ (ไส้จิ้ม 1-2 จุดไม่นับ) · Q1 ไซด์เวย์ปิดเกินนิดเดียว = ยัง A · ใช้กับการกวาดของ Q2 ด้วย
//   3. Q1 หลอกแต่ Q2 ปิดทะลุต่อทางเดียวกัน → นับ Q1 เป็น X (กวาดแล้ววิ่งต่อ) แล้วหาแบบกลุ่ม X แทน "ไม่ชัด"
//   4. แตะแถว QT ใน Dashboard = ดูเหตุผล (ชนิด Q1 · ER · กรอบเทียบเกณฑ์ · ความลึกที่กวาด)
// DAY (2) 2026-11-27:
//   1. ช่วงอุ่นเครื่องเก็บ swing อย่างเดียว ไม่วาดป้าย Sweep / SMT (ไม่มีป้ายของเมื่อวานโผล่)
//   2. ระยะโซน (Sweep ใกล้เลเวล 0.3 · ยกเลิกเมื่อวิ่งออก 1.0) ใช้ ATR H1 → เท่ากันทุก TF กราฟ ≤ H1
//   3. แท่งอุ่นเครื่องข้ามช่วงพัก 17:00-18:00 NY และเสาร์-อาทิตย์ · ย้อนหลังหลายวันข้ามวันที่ไม่มีเทรด
//   4. ขึ้นวันเทรดใหม่ (18:00 NY) ขณะเปิดกราฟ → ล้างจุดเข้า / ป้าย Sweep SMT MSS / โซนค้าง ของวันที่เกินช่วง
//   5. QT: "ไม่ชัด → ข้ามรอบนี้" (แทน "ลุ้น ไม่ชัด") · แถบ Quarter ไม่วาดช่วงอนาคต (ทับ Dashboard น้อยลง)
//   6. ป้ายขอบขวา: ระยะเริ่ม 3.5% + กลุ่มป้ายที่ติดกันจัดกึ่งกลางตรงเส้นจริง (ไม่ลอยขึ้นทางเดียว)
// DAY (1) 2026-11-27:
//   1. Engine (โซนรอ Sweep · Sweep · MSS · จุดเข้า · Flip · SMT บนกราฟ) คำนวณเฉพาะวันเทรดปัจจุบัน (เริ่ม 18:00 NY) → เบา + ทุก TF เริ่มนับพร้อมกัน
//   2. เลเวล MSNR H1/H4 + OB H1/H4 คำนวณใน TF นั้นเอง (ย้อนหลังตาม 'TF ใหญ่: ขอข้อมูลย้อนหลัง') → เลเวลชุดเดียวกันทุก TF กราฟ
//   3. รวม request TF ใหญ่: เลเวล + Storyline + OB + Sweep + SMT ของ HTF 1/2 อยู่ใน request เดียวต่อ TF (16 → 10 request)
//   4. โซนที่กำลังรอ Sweep แสดงเส้นเสมอ (◎ โซน) แม้เลเวลถูกแตะแล้ว
//   5. โซนรอ Sweep หมดอายุเป็นชั่วโมง + ยกเลิกเมื่อราคาวิ่งออกจากโซนเกิน x ATR
//   6. Flip จากจุดเข้าที่จาง = จางด้วย (ไม่ส่ง Alert)
//   7. ป้ายขอบขวา: ระยะห่างปรับได้ + ป้ายข้อความซ้ำที่ติดกันแสดงอันเดียว · Dashboard จุดเข้าล่าสุดสั้นลง
// ════════════════════════════════════════════════════════════════
//@version=6
indicator("MSNR × SMC + OB DAY", shorttitle="MSNR OB DAY", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=500, calc_bars_count=3000)



// ═══════════════════════════════════════════════════════════════
// Flow: เลเวล MSNR ของ HTF (H1/H4) ที่ยัง Fresh = POI
//       → ราคาเข้าโซน → Sweep บน TF ชาร์ต → MSS (ปิดเนื้อเทียนทะลุ)
//       → ตั้ง Limit ที่เลเวล MSNR ในขา MSS (RBS/SBR ของแท่ง swing, V/A, QM, OCL)
// เงื่อนไข Sweep / MSS อ้างอิงจาก Sweep + MSS และ SFP SBR/RBS ใน repo
// ═══════════════════════════════════════════════════════════════

// ───────── Inputs ─────────
string GP = "ความเร็ว (แก้ error สคริปต์ช้า)"
int    dayN     = input.int(1, "วิเคราะห์ย้อนหลัง (วันเทรด · เริ่ม 18:00 NY)", minval=1, maxval=3, group=GP, display=display.none, tooltip="Engine (โซนรอ Sweep · Sweep · MSS · จุดเข้า · SMT บนกราฟ) คำนวณเฉพาะวันเทรดนี้ (+ แท่งอุ่นเครื่องเล็กน้อย)\n1 = วันนี้ (เริ่ม 18:00 NY ≈ 06:00 ไทย ฤดูหนาว US)\nเลเวล / OB TF ใหญ่ ไม่ได้ใช้ค่านี้ (คำนวณใน TF นั้นเองตาม 'TF ใหญ่: ขอข้อมูลย้อนหลัง')")
int    winMin   = input.int(150, "กราฟ ≥ M30: คำนวณอย่างน้อย (แท่ง)", minval=30, maxval=1000, step=10, group=GP, display=display.none, tooltip="1 วันบนกราฟ M30 / H1 / H4 มีแท่งน้อยเกินไป → ใช้อย่างน้อยจำนวนนี้")
int    htfN     = input.int(800, "TF ใหญ่: ขอข้อมูลย้อนหลัง (แท่งของ TF นั้น)", minval=100, maxval=5000, step=100, group=GP, display=display.none, tooltip="เลเวล MSNR · OB · Storyline · Sweep · SMT ของ H1 / H4 (และ M15 / M30 / D) คำนวณใน TF นั้นเองจากจำนวนแท่งนี้ → ทุก TF กราฟได้เลเวลชุดเดียวกัน\nH1 800 แท่ง ≈ 33 วัน · น้อย = เร็วขึ้น")

string G0 = "Higher Timeframe (POI)"
string tf1      = input.timeframe("60",  "HTF 1 (เลเวล)", group=G0, display=display.none)
string tf2      = input.timeframe("240", "HTF 2 (เลเวล + Storyline)", group=G0, display=display.none)
int    pvLH     = input.int(3, "HTF Pivot ซ้าย", minval=1, group=G0, display=display.none)
int    pvRH     = input.int(2, "HTF Pivot ขวา", minval=1, group=G0, display=display.none)
bool   useGapH  = input.bool(true, "HTF Gap / OCL level", display=display.none, group=G0)
int    nShowH   = input.int(2, "แสดงเลเวล HTF ใกล้ราคา (ฝั่งละ)", minval=1, maxval=10, group=G0, display=display.none)
bool   htfAuto  = input.bool(true, "เลื่อน HTF ขึ้นอัตโนมัติถ้าไม่ใหญ่กว่า TF กราฟ", display=display.none, group=G0, tooltip="กราฟ H1 → ใช้ H4 + D · กราฟ H4 → ใช้ D + W\nปิด = ไม่ใช้เลเวล HTF ที่ไม่ใหญ่กว่ากราฟ (กัน H1 บนกราฟ H4 อ่านข้อมูลผิด)")

string G1 = "เลเวล MSNR บน TF ชาร์ต"
int   pvL     = input.int(5, "Pivot ซ้าย", minval=1, group=G1, display=display.none)
int   pvR     = input.int(3, "Pivot ขวา", minval=1, group=G1, display=display.none)
bool  useAV   = input.bool(true, "A / V", display=display.none, group=G1)
bool  useFlip = input.bool(true, "RBS / SBR", display=display.none, group=G1)
bool  useQM   = input.bool(true, "QM", display=display.none, group=G1)
bool  useOCL  = input.bool(true, "OCL / Gap", display=display.none, group=G1)
bool  ltfNear = input.bool(true, "แสดงเส้น LTF เฉพาะในโซนรอบเลเวล HTF", display=display.none, group=G1)
float zoneA   = input.float(1.5, "ขนาดโซนแสดงผลรอบ HTF (x ATR)", minval=0.1, step=0.1, group=G1, display=display.none)

string G2 = "SMC: Sweep → MSS (TF ชาร์ต)"
float zoneSw  = input.float(0.3, "Sweep ต้องเกิดใกล้เลเวล HTF ไม่เกิน (x ATR H1)", minval=0.0, step=0.05, group=G2, display=display.none, tooltip="ใช้ ATR H1 → ระยะเท่ากันทุก TF กราฟ (0.3 ATR H1 ≈ 1 ATR M5)\nกราฟใหญ่กว่า H1 ใช้ ATR ของกราฟ")
float zoneH   = input.float(3.0, "โซนรอ Sweep หลังแตะเลเวล HTF (ชั่วโมง)", minval=0.25, step=0.25, group=G2, display=display.none, tooltip="นับเป็นเวลา → เท่ากันทุก TF กราฟ (เดิมนับแท่ง: M5 36 แท่ง = 3 ชม.)")
float zAway   = input.float(1.0, "ยกเลิกโซนเมื่อราคาวิ่งออกจากเลเวลเกิน (x ATR H1)", minval=0.1, step=0.1, group=G2, display=display.none, tooltip="Buy: ราคาปิดสูงกว่าเลเวล + x ATR H1 · Sell: ปิดต่ำกว่าเลเวล − x ATR H1 → ไม่ได้อยู่ในโซนแล้ว\nATR H1 → ยกเลิกพร้อมกันทุก TF กราฟ (1 ATR H1 ≈ 3 ATR M5)")
int   sLen    = input.int(3, "Swing length (liquidity)", minval=1, group=G2, display=display.none)
int   mssLen  = input.int(0, "MSS: swing ที่ใช้หาระดับ (แท่ง) · 0 = เท่า Swing length", minval=0, maxval=10, group=G2, display=display.none, tooltip="ใช้ตอน Sweep Key liquidity (PDH/PDL · Asia) ที่ไม่มี swing ติดมา: ระดับ MSS = swing ฝั่งตรงข้ามล่าสุด\n1-2 = swing ย่อย → MSS ใกล้ราคาขึ้น (เหมาะกับ TF ใหญ่ เช่น H4)")
int   liqAge  = input.int(25, "Sweep เฉพาะ swing ที่เกิดภายใน (แท่ง)", minval=5, group=G2, display=display.none)
int   sGap    = input.int(1, "แท่ง Sweep ต้องห่าง swing อย่างน้อย (แท่งคั่น)", minval=0, group=G2, display=display.none)
int   mssWin  = input.int(20, "MSS ต้องเกิดภายใน (แท่งหลัง Sweep)", minval=2, group=G2, display=display.none)
bool  reqDisp = input.bool(false, "แท่ง MSS ต้องมี Displacement", display=display.none, group=G2)
float dispAtr = input.float(0.8, "Displacement: body ≥ (x ATR)", minval=0.1, step=0.1, group=G2, display=display.none)
bool  reqFvg  = input.bool(false, "แท่ง MSS ต้องสร้าง FVG", display=display.none, group=G2)

string GQ = "คุณภาพ Setup (Score เต็ม 8 + OB · AMDX · PSP)"
bool   useKey   = input.bool(true, "นับ Key liquidity: PDH/PDL · Asia H/L · EQH/EQL", display=display.none, group=GQ)
float  eqTol    = input.float(0.1, "EQH/EQL tolerance (x ATR)", minval=0.01, step=0.01, group=GQ, display=display.none)
string asiaSess = input.session("1900-0200", "Asia session (เวลา NY · DST อัตโนมัติ)", group=GQ, display=display.none, tooltip="ใช้หา Asia High/Low (Key liquidity) · 19:00-02:00 NY ≈ 07:00-14:00 ไทย (ฤดูหนาว US)\nใช้เฉพาะกราฟ ≤ H1")
string kzLon    = input.session("0200-0500", "London killzone (เวลา NY)", group=GQ, display=display.none, tooltip="02:00-05:00 NY ≈ 14:00-17:00 ไทย (ฤดูหนาว US) · ปรับตาม DST อัตโนมัติ")
string kzNy     = input.session("0700-1000", "New York killzone (เวลา NY)", group=GQ, display=display.none, tooltip="07:00-10:00 NY ≈ 19:00-22:00 ไทย (ฤดูหนาว US) · ปรับตาม DST อัตโนมัติ")
int    minMiss  = input.int(3, "จุดเข้าเข้ม (ไม่จาง) เมื่อขาดแต้มไม่เกิน", minval=0, maxval=8, group=GQ, display=display.none, tooltip="นับจาก Score เต็ม (ปรับตาม TF และตัวเลือกที่เปิด)\nเกรด: ขาด ≤1 = A+ · 2 = A · 3 = B · ≥4 = C\nค่าเริ่ม 3 = เข้มเฉพาะเกรด B ขึ้นไป (เช่น 10/13)\nแต้ม: Key · Disp · FVG · ทับ HTF · PD · Killzone (≤ M30) · SMT · SSMT · PO3 · OB · AMDX (QT) · PSP · CISD")
bool   useSMT   = input.bool(true, "SMT divergence (เทียบสินทรัพย์ที่วิ่งตามกัน)", display=display.none, group=GQ)
string smtSym   = input.symbol("OANDA:XAGUSD", "สัญลักษณ์เทียบ SMT", group=GQ, display=display.none, tooltip="ทอง → เงิน (XAGUSD) · ทองกวาด Low แต่เงินไม่ทำ Low ใหม่ = Bullish SMT · ทองกวาด High แต่เงินไม่ทำ High ใหม่ = Bearish SMT")
bool   showSMT  = input.bool(true, "วาดเส้น SMT บนกราฟ", display=display.none, group=GQ)
bool   smtU1    = input.bool(true, "SMT HTF 1 (TF เดียวกับเลเวล)", display=display.none, group=GQ)
bool   smtU2    = input.bool(true, "SMT HTF 2 (TF เดียวกับเลเวล)", display=display.none, group=GQ)
bool   smtU3    = false      // ลด SMT TF ใหญ่เหลือ 2 TF (H1 + H4)
string smtTf3   = "30"
bool   smtU4    = false
string smtTf4   = "120"
bool   pspOn    = input.bool(true, "PSP: Score +1 เมื่อแท่ง Sweep ทองกับเงินปิดคนละสี (±1 แท่ง)", display=display.none, group=GQ, tooltip="Precision Swing Point (Daye) · ใช้สัญลักษณ์เทียบ SMT")
bool   smtRT    = input.bool(true, "SMT เรียลไทม์ (ขึ้นทันที ไม่รอ swing ยืนยัน)", display=display.none, group=GQ, tooltip="ทองทะลุ swing ล่าสุดที่ยืนยันแล้ว แต่เงินยังไม่ทะลุ swing เดียวกัน → เส้นจาง + ป้าย \"SMT?\" ขยับตามราคาทุก tick\nเงินทะลุตาม = เส้นหายเอง · swing ยืนยันแล้ว = เปลี่ยนเป็นเส้น SMT จริง (ไม่หาย)")
int    smtLenH  = input.int(2, "SMT TF ใหญ่: Swing length (แท่งของ TF นั้น)", minval=1, group=GQ, display=display.none)
int    smtLive  = input.int(3, "SMT TF ใหญ่ยังนับ (แท่งของ TF นั้น)", minval=1, group=GQ, display=display.none, tooltip="SMT ของ TF ใหญ่ที่เกิดไม่เกินกี่แท่ง (ของ TF นั้น) ยังนับเป็นแต้ม SMT และขึ้น ▲/▼ ใน Dashboard")
bool   reqPD    = input.bool(false, "บังคับ Entry อยู่ Discount (Buy) / Premium (Sell)", display=display.none, group=GQ)
bool   ssmtOn   = input.bool(true, "SSMT: Score +1 แยกจาก SMT (Sequential SMT ตาม Quarter)", display=display.none, group=GQ, tooltip="Quarter ปัจจุบัน (วัน · 90m · Micro) ทองทะลุ High/Low ของ Quarter ก่อน แต่เงินไม่ทะลุของตัวเอง\nใช้ข้อมูลเงินชุดเดียวกับ SMT (ไม่เพิ่ม request)\nปิด = SSMT นับรวมในแต้ม SMT แบบเดิม")
bool   cisdOn   = input.bool(true, "qCISD / tCISD: Score +1 เมื่อเกิด CISD ตรงทิศหลัง Sweep (ก่อน/ที่แท่ง MSS)", display=display.none, group=GQ, tooltip="CISD (Change in State of Delivery) บน TF กราฟ\nBullish: ชุดแท่งแดงติดกัน แล้วแท่งปิดเหนือ Open ของแท่งแรกในชุด · Bearish กลับกัน\nqCISD = ขาของ CISD ทำ High/Low ของ Quarter (QT 90m · กราฟ > M30 ใช้ QT วัน) และกวาด Quarter ก่อนหน้า (+ ต้องมี SSMT ถ้าเปิด)\ntCISD = CISD บน TF กราฟที่เกิด ณ จุดสำคัญ")
int    cdMin    = input.int(1, "CISD: ชุดแท่งสวนทางอย่างน้อย (แท่ง)", minval=1, maxval=5, group=GQ, display=display.none)
bool   cdKeyOn  = input.bool(true, "CISD เกิดเฉพาะที่จุดสำคัญ (ติ๊กชนิดด้านล่าง)", display=display.none, group=GQ, tooltip="ขาของ CISD (ไส้ต่ำสุด/สูงสุดก่อนกลับตัว) ต้องแตะ/กวาดจุดสำคัญก่อน ถึงจะนับเป็น qCISD / tCISD\nCISD ▲ ใช้ฝั่งล่าง (Demand · แนวรับ · Sell-side liquidity) · CISD ▼ ใช้ฝั่งบน\nโซน / เลเวล: ทะลุลงไปได้ไม่เกินระยะ 'Sweep ต้องเกิดใกล้เลเวล HTF' (x ATR H1)\nปิด = ไม่กรอง (ทุกที่)")
bool   cdKOB    = input.bool(true, "จุดสำคัญ: OB (ทุก TF ในกราฟ)", inline="ck1", display=display.none, group=GQ)
bool   cdKFvg   = input.bool(true, "FVG TF ใหญ่ (TF A / B)", inline="ck1", display=display.none, group=GQ, tooltip="FVG ของแท่ง TF A / TF B (ค่าเริ่ม H4 / H1 · ตั้งในกลุ่ม 'แท่งเทียน TF ใหญ่') ที่ยังไม่ถูกปิดทะลุ · ดูย้อนหลัง 25 แท่งของ TF นั้น")
bool   cdKLvl   = input.bool(true, "จุดสำคัญ: เลเวล MSNR HTF", inline="ck2", display=display.none, group=GQ)
bool   cdKLiq   = input.bool(true, "Liquidity ที่ถูกกวาด", inline="ck2", display=display.none, group=GQ, tooltip="ไส้กวาดแล้วปิดกลับ: PDH/PDL · Asia H/L · EQH/EQL · swing ล่าสุด (ชุดเดียวกับที่ Engine ใช้หา Sweep)\nจุดที่กวาดต้องเป็นจุดสุดของขา CISD (หลังกวาดไม่ทำจุดใหม่ที่ลึกกว่า)")
bool   cdQSs    = input.bool(true, "qCISD ต้องมี SSMT ตรงทิศ (Quarter วัน / 90m / Micro)", display=display.none, group=GQ, tooltip="แบบที่เครื่องมือสาย Quarterly Theory ใช้: เกิด SSMT ก่อน แล้ว CISD ที่ Quarter นั้นจึงเป็น qCISD\nไม่มี SSMT = นับเป็น tCISD")
bool   showCD   = input.bool(true, "วาดเส้น CISD บนกราฟ (สีฟ้า)", display=display.none, group=GQ, tooltip="qCISD = เส้นทึบ (วาดทุกครั้งที่เกิด) · tCISD = เส้นประ (วาดเฉพาะตัวที่ใช้ใน Setup)")
bool   cdAll    = input.bool(false, "วาด tCISD ทุกตัว (ไม่ใช่เฉพาะใน Setup)", display=display.none, group=GQ, tooltip="กราฟเล็ก (M1 / M5) จะมี tCISD ถี่มาก → ค่าเริ่มปิด")
int    cdKeep   = input.int(12, "จำนวนเส้น CISD ที่แสดง", minval=1, maxval=40, group=GQ, display=display.none)

string G3 = "Entry (MSNR)"
bool   needStory = input.bool(true, "เทรดเฉพาะทิศ Storyline", display=display.none, group=G3)
string entryAt   = input.string("Nearest", "เข้าที่เลเวล", options=["Nearest", "Deepest", "ใกล้ HTF ที่สุด"], group=G3, display=display.none, tooltip="Nearest = เลเวลใกล้ราคาที่สุด (โดนง่าย) | Deepest = ใกล้ไส้ sweep (RR ดีกว่า) | ใกล้ HTF ที่สุด = เลเวลที่ทับเส้น HTF")
float  confA     = input.float(0.5, "ระยะที่นับว่าทับเส้น HTF (x ATR)", minval=0.0, step=0.05, group=G3, display=display.none)
float  slA       = input.float(0.1, "SL เลยปลายไส้ sweep (x ATR)", minval=0.0, step=0.05, group=G3, display=display.none)
float  minRR     = input.float(1.5, "TP ต้องห่างอย่างน้อย (R)", minval=0.5, step=0.1, group=G3, display=display.none)
float  fbR       = input.float(2.0, "TP สำรองถ้าไม่มีเลเวล (R)", minval=0.5, step=0.1, group=G3, display=display.none)
int    enExpH    = input.int(72, "จุดเข้าหมดอายุหลัง (ชั่วโมง)", minval=1, maxval=720, group=G3, display=display.none, tooltip="ยังไม่ถึง TP/SL ภายในเวลานี้ = หมดอายุ (นับเป็นชั่วโมง ใช้ได้เท่ากันทุก TF)")
bool   useSess   = input.bool(false, "หา Setup เฉพาะใน Session", display=display.none, group=G3)
int    enKeep    = input.int(10, "จำนวนจุดเข้าที่แสดงย้อนหลัง", minval=1, maxval=40, group=G3, display=display.none, tooltip="โหมดดูจุดเข้า: มาร์กจุดเข้า + เส้น SL/TP อ้างอิงจาง แล้วหาจุดต่อไปทันที (ไม่รอผลไม้)")
bool   trackEn   = input.bool(true, "ติดตามผลจุดเข้า (✓ ถึง TP · ✗ โดน SL · ✗ ล้ม)", display=display.none, group=G3, tooltip="จุดที่จบแล้วจะจางลง + ต่อท้ายผล · ✗ ล้ม = เกิด MSS ฝั่งตรงข้ามก่อนถึง TP/SL")
bool   flipOn    = input.bool(true, "Flip: จุดเข้ากลับทิศเมื่อจุดเข้าเดิมโดน SL (Breaker)", display=display.none, group=G3, tooltip="Buy โดน SL → โซนเดิมกลายเป็นแนวต้าน → มาร์ก Sell ที่ราคาเข้าเดิม · SL เหนือ High ตั้งแต่จุดเข้าเดิม\nสวน Storyline = แสดงจาง")
bool   showWeak  = input.bool(true, "แสดงจุดเข้าที่ Score ต่ำแบบจาง", display=display.none, group=G3)
string sess      = input.session("1400-0200", "Session (เวลาไทย)", group=G3, display=display.none)

string G4 = "ทั่วไป"
float  tolA      = input.float(0.05, "Tolerance แตะ/ทะลุ (x ATR)", minval=0.0, step=0.01, group=G4, display=display.none)
float  mrgA      = input.float(0.25, "รวมเลเวลที่ใกล้กัน (x ATR)", minval=0.0, step=0.05, group=G4, display=display.none)
float  mrgHA     = input.float(0.1, "รวมเลเวล HTF ที่ใกล้กัน (x ATR ของ HTF 1)", minval=0.0, step=0.05, group=G4, display=display.none, tooltip="ใช้ ATR ของ TF ใหญ่ → รวมเลเวลเหมือนกันทุก TF กราฟ")
float  labPct    = input.float(3.5, "ระยะห่างป้ายขอบขวาขั้นต่ำ (% ของกรอบราคา 300 แท่ง)", minval=1.0, maxval=8.0, step=0.5, group=G4, display=display.none, tooltip="ป้ายยังทับกัน (ซูมออกมาก) → เพิ่ม · ป้ายห่างเส้นเกิน → ลด")
float  gapA      = input.float(0.05, "Gap ขั้นต่ำ (x ATR)", minval=0.0, step=0.01, group=G4, display=display.none)
bool   freshOnly = input.bool(true, "แสดงเฉพาะเลเวล Fresh", display=display.none, group=G4)
bool   showSM    = input.bool(true, "แสดง Sweep / MSS", display=display.none, group=G4)
bool   showHSw   = input.bool(true, "แสดงเส้น Sweep ของ TF ใหญ่", display=display.none, group=G4, tooltip="แท่ง M15 / M30 / H1 / H4 ที่ไส้ทะลุ swing ล่าสุดของ TF นั้นแล้วปิดกลับ → วาดเส้นประจาก swing ถึงไส้บนกราฟเล็ก + ป้าย \"Sweep M15\" … \"Sweep H4\" (ขึ้นตอนแท่ง TF นั้นปิด)")
bool   hsU1      = input.bool(true, "Sweep TF 1", inline="w1", display=display.none, group=G4)
string hsTf1     = input.timeframe("15", "", inline="w1", group=G4, display=display.none)
bool   hsU2      = input.bool(true, "Sweep TF 2", inline="w2", display=display.none, group=G4)
string hsTf2     = input.timeframe("30", "", inline="w2", group=G4, display=display.none)
bool   hsU3      = input.bool(true, "Sweep HTF 1 (TF เดียวกับเลเวล)", display=display.none, group=G4)
bool   hsU4      = input.bool(true, "Sweep HTF 2 (TF เดียวกับเลเวล)", display=display.none, group=G4)
int    hswLen    = input.int(2, "Sweep TF ใหญ่: Swing length (แท่งของ TF นั้น)", minval=1, group=G4, display=display.none)
int    hswAge    = input.int(20, "Sweep TF ใหญ่: swing ที่เกิดภายใน (แท่งของ TF นั้น)", minval=3, group=G4, display=display.none)
int    lw        = input.int(1, "ความหนาเส้น (ทุกเส้นเท่ากัน)", minval=1, maxval=3, group=G4, display=display.none)
int    offs      = input.int(10, "ยื่นเส้นไปทางขวา (แท่ง)", minval=2, maxval=60, group=G4, display=display.none)
string txtSz     = input.string(size.tiny, "ขนาดตัวอักษร", options=[size.tiny, size.small, size.normal], group=G4, display=display.none)
bool   showDash  = input.bool(true, "Dashboard", display=display.none, group=G4)
string dashPos   = input.string("ล่างขวา", "ตำแหน่ง Dashboard", options=["ล่างขวา", "บนขวา", "ล่างซ้าย", "บนซ้าย"], group=G4, display=display.none)

string GC = "แท่งเทียน TF ใหญ่ (ด้านขวาของกราฟ)"
bool   showC   = input.bool(true, "แสดงแท่งเทียน TF ใหญ่", display=display.none, group=GC)
string cTfA    = input.timeframe("240", "TF A", inline="ca", group=GC, display=display.none)
int    cNA     = input.int(4, "จำนวนแท่ง", minval=1, maxval=20, inline="ca", group=GC, display=display.none)
string cTfB    = input.timeframe("60", "TF B", inline="cb", group=GC, display=display.none)
int    cNB     = input.int(6, "จำนวนแท่ง", minval=0, maxval=20, inline="cb", group=GC, display=display.none)
int    cGap    = input.int(8, "เริ่มห่างจากแท่งปัจจุบันอย่างน้อย (แท่ง)", minval=2, maxval=80, group=GC, display=display.none, tooltip="ระยะจริงคำนวณเองจากป้ายขอบขวาที่ยาวที่สุด (ป้ายเลเวล / OB / TDO) ไม่ให้แท่งเทียน TF ใหญ่ทับป้าย\nค่านี้ = ระยะขั้นต่ำ")
float  cChar   = input.float(1.8, "ความกว้างตัวอักษรป้าย (แท่งต่อ 1 ตัว)", minval=0.5, maxval=5, step=0.1, group=GC, display=display.none, tooltip="ใช้คำนวณระยะเว้นให้ป้าย · ป้ายยังโดนแท่งเทียนทับ → เพิ่ม · เว้นห่างเกิน → ลด")
int    cW      = input.int(3, "ความกว้างแท่ง (แท่งกราฟ)", minval=1, maxval=10, group=GC, display=display.none)
bool   cOpen   = input.bool(true, "เส้น Open ของแท่ง TF ใหญ่ปัจจุบัน", display=display.none, group=GC)
bool   cSwp    = input.bool(true, "มาร์ก Sweep บนแท่ง TF ใหญ่ (ไส้เลยแท่งก่อนแล้วปิดกลับ)", display=display.none, group=GC)
bool   cTime   = input.bool(true, "เวลาที่เหลือก่อนแท่งปิด", display=display.none, group=GC)

string G5 = "สี"
color colR   = input.color(#ef5350, "Resistance / SBR / Sell", display=display.none, group=G5)
color colS   = input.color(#26a69a, "Support / RBS / Buy", display=display.none, group=G5)
color colQM  = input.color(#ff9800, "QM", display=display.none, group=G5)
color colOCL = input.color(#ab47bc, "OCL", display=display.none, group=G5)
color colSw  = input.color(#9598a1, "Sweep", display=display.none, group=G5)
color colSMT = input.color(#7e57c2, "SMT", display=display.none, group=G5)
color colCD  = input.color(#29b6f6, "CISD (qCISD / tCISD)", display=display.none, group=G5)

// ───────── Types ─────────
type Lvl
    float  price
    int    t0
    int    born
    int    kind      // 1 = แนวรับ, -1 = แนวต้าน
    string base
    string tag
    int    src       // 0 = ชาร์ต, 1 = HTF1, 2 = HTF2
    string tf
    bool   fresh
    int    ftouch
    line   ln
    label  lb

// ───────── Common ─────────
float atr    = ta.atr(14)
float tol    = atr * tolA
int   barMs  = timeframe.in_seconds() * 1000
bool  inSess = not useSess or not na(time(timeframe.period, sess, "Asia/Bangkok"))
color cNone  = color.new(color.black, 100)
int   chSec  = timeframe.in_seconds()
// ช่วงที่คำนวณ: วันเทรดปัจจุบัน (เริ่ม 18:00 NY) · inDay = เปิดโซน / มาร์กจุดเข้าได้ · inCalc = รวมแท่งอุ่นเครื่อง (swing / เลเวล LTF ก่อนเริ่มวัน)
// ย้อนวันเทรด n วัน (วันเทรดเริ่ม 18:00 NY วันอา.-พฤ. · ไม่มีวันที่เริ่มศุกร์/เสาร์)
f_dayBack(int t, int n) =>
    int r = t
    if n > 0
        for k = 1 to n
            r -= 86400000
            while dayofweek(r, "America/New_York") == dayofweek.friday or dayofweek(r, "America/New_York") == dayofweek.saturday
                r -= 86400000
    r
int   lbMin  = (hour(last_bar_time, "America/New_York") * 60 + minute(last_bar_time, "America/New_York") + 360) % 1440
int   dayT0  = f_dayBack(last_bar_time - lbMin * 60000, dayN - 1)
int   warmN  = liqAge + pvL + pvR + 10
// แท่งอุ่นเครื่อง (นับจากแท่งที่มีจริง): ข้ามช่วงพักตลาด 17:00-18:00 NY (1 ชม.) · เริ่มวันอาทิตย์ (วันจันทร์) → ข้ามไปก่อนตลาดปิดวันศุกร์ 17:00 NY (49 ชม.)
int   warmMs = warmN * chSec * 1000 + (dayofweek(dayT0, "America/New_York") == dayofweek.sunday ? 176400000 : 3600000)
bool  bigTf  = chSec >= 1800
bool  inDay  = time >= dayT0 or (bigTf and bar_index > last_bar_index - winMin)
bool  inCalc = time >= dayT0 - warmMs or (bigTf and bar_index > last_bar_index - winMin - warmN)
int   winBars = math.min(5000, (chSec > 0 ? int(86400 / chSec) : 1) * (dayN + 3) + 300)
// เงื่อนไขที่มีความหมายเฉพาะ TF เล็ก
bool  kzOn    = chSec <= 1800                                 // Killzone: กราฟ ≤ M30
bool  asiaOn  = chSec <= 3600                                 // Asia H/L: กราฟ ≤ H1
bool  pdhOn   = chSec < 86400                                 // PDH/PDL: กราฟเล็กกว่า D
bool  qtDayOk = chSec <= 3600 and 21600 % chSec == 0          // QT วัน: แท่งต้องตรงขอบ 6 ชม.
bool  qt90Ok  = chSec <= 1800 and 5400 % chSec == 0           // QT 90m: แท่งต้องตรงขอบ 90 นาที
bool  qtUOk   = chSec <= 300                                  // QT Micro 22.5m
// ระยะห่างขั้นต่ำของป้าย (กันป้ายทับกัน) · อิงกรอบราคาล่าสุด
float rg300  = ta.highest(high, 300) - ta.lowest(low, 300)
float labSep = math.max(atr * 0.6, nz(rg300) * labPct / 100)

f_tfTxt(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 2419200 ? "MN" : s >= 604800 ? "W" + str.tostring(s / 604800) : s >= 86400 ? "D" + str.tostring(s / 86400) : s >= 3600 ? "H" + str.tostring(s / 3600) : "M" + str.tostring(s / 60)

// แปลงเวลา → bar_index (วาดด้วย bar_index เพื่อไม่ให้เส้นอนาคตไปกองรวมกันตอนตลาดปิด/เสาร์-อาทิตย์)
// เก่ากว่า 500 แท่ง → ประมาณจากเวลา (ไม่ไปกองที่แท่ง -499)
f_barAt(int t) =>
    int r = na
    for j = 0 to 499
        if time[j] <= t
            r := bar_index - j
            break
    if na(r)
        r := math.max(bar_index - int((time - t) / math.max(barMs, 1)), bar_index - 4900, 0)
    r

// TF ถัดไปที่ใหญ่กว่า s วินาที
f_tfAbove(int s) =>
    s < 900 ? "15" : s < 1800 ? "30" : s < 3600 ? "60" : s < 14400 ? "240" : s < 86400 ? "D" : s < 604800 ? "W" : "M"

// HTF ที่ใช้จริง: ต้องใหญ่กว่ากราฟ (ไม่งั้น request.security ได้ข้อมูลผิด / ซ้ำกับเลเวลกราฟ)
string tf1E = timeframe.in_seconds(tf1) > chSec ? tf1 : htfAuto ? f_tfAbove(chSec) : tf1
string tf2E = timeframe.in_seconds(tf2) > timeframe.in_seconds(tf1E) ? tf2 : htfAuto ? f_tfAbove(timeframe.in_seconds(tf1E)) : tf2
bool   h1On = timeframe.in_seconds(tf1E) > chSec
bool   h2On = timeframe.in_seconds(tf2E) > chSec and timeframe.in_seconds(tf2E) > timeframe.in_seconds(tf1E)
string tf1T = f_tfTxt(tf1E)
string tf2T = f_tfTxt(tf2E)

// TF ใหญ่ที่ผูกกับ HTF 1 / 2 (อยู่ใน request เดียวกับเลเวล → ประหยัด request)
string smtTf1 = tf1E
string smtTf2 = tf2E
string hsTf3  = tf1E
string hsTf4  = tf2E

bool nb1 = h1On and timeframe.change(tf1E)
bool nb2 = h2On and timeframe.change(tf2E)

// ───────── LTF series ─────────
float ph  = ta.pivothigh(close, pvL, pvR)        // MSNR: จาก Close
float pl  = ta.pivotlow(close, pvL, pvR)
float sph = ta.pivothigh(high, sLen, sLen)       // Liquidity: จากไส้
float spl = ta.pivotlow(low, sLen, sLen)
float gapSz   = math.abs(open - close[1])
bool  bearOCL = close[1] < open[1] and close < open and gapSz >= math.max(gapA * atr, syminfo.mintick)
bool  bullOCL = close[1] > open[1] and close > open and gapSz >= math.max(gapA * atr, syminfo.mintick)

// ───────── Key liquidity: PDH/PDL · Asia H/L ─────────
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
bool inAsia = not na(time(timeframe.period, asiaSess, "America/New_York"))
bool inKz   = kzOn and (not na(time(timeframe.period, kzLon, "America/New_York")) or not na(time(timeframe.period, kzNy, "America/New_York")))
var float aH   = na
var float aL   = na
var float curH = na
var float curL = na
if inAsia
    curH := inAsia[1] ? math.max(curH, high) : high
    curL := inAsia[1] ? math.min(curL, low) : low
else if inAsia[1]
    aH := curH
    aL := curL
var float usedPDH = na
var float usedPDL = na

// ───────── SMT: ทองกวาด แต่สินทรัพย์เทียบไม่ยืนยัน ─────────
[xLo, xHi, xOp, xCl] = request.security(smtSym, timeframe.period, [low, high, open, close], ignore_invalid_symbol=true, calc_bars_count=winBars)
// จุดต่ำสุด/สูงสุดของสินทรัพย์เทียบรอบ swing (ดูก่อน-หลัง swing ของทอง sLen แท่ง)
float xVal = ta.lowest(xLo, 2 * sLen + 1)
float xPk  = ta.highest(xHi, 2 * sLen + 1)
var float pGL = na
var int   pGT = na
var float pXL = na
var float pGH = na
var int   pHT = na
var float pXH = na
var int   smtUBar = -1000
var int   smtDBar = -1000

// ───────── SMT หลายทามเฟรม (แท่ง TF ใหญ่ที่ปิดแล้วเท่านั้น = ไม่ repaint) ─────────
type SmtTF
    string name
    float  gl
    int    glt
    float  xl
    float  gh
    int    ght
    float  xh
    int    ub = -100000
    int    db = -100000
    float  rgl
    int    rglt
    float  rxl
    float  rgh
    int    rght
    float  rxh
    line   lu
    line   ld

f_gSw(int L) =>
    [ta.pivotlow(low, L, L)[1], ta.pivothigh(high, L, L)[1], time[L + 1]]
f_xSw(int L) =>
    [ta.lowest(low, 2 * L + 1)[1], ta.highest(high, 2 * L + 1)[1]]

// ───────── Sweep ของ TF ใหญ่ (คำนวณใน TF นั้น · ส่งเฉพาะแท่งที่ปิดแล้ว = ไม่ repaint) ─────────
// ไส้ทะลุ swing ล่าสุด (เว้น ≥ 1 แท่งคั่น · swing ไม่เก่าเกิน age แท่ง) แล้วปิดกลับ = Sweep · ปิดทะลุ = swing นั้นใช้แล้ว
f_hSw(int L, int age) =>
    var float hP = na
    var int   hT = na
    var int   hB = na
    var float lP = na
    var int   lT = na
    var int   lB = na
    float sH  = na
    int   sHT = na
    float sL  = na
    int   sLT = na
    float p1  = ta.pivothigh(high, L, L)
    float p2  = ta.pivotlow(low, L, L)
    if not na(hP) and high > hP
        if close < hP and bar_index - hB <= age and bar_index - hB >= 2
            sH  := hP
            sHT := hT
        hP := na
    if not na(lP) and low < lP
        if close > lP and bar_index - lB <= age and bar_index - lB >= 2
            sL  := lP
            sLT := lT
        lP := na
    if not na(p1)
        hP := p1
        hT := time[L]
        hB := bar_index - L
    if not na(p2)
        lP := p2
        lT := time[L]
        lB := bar_index - L
    [sH[1], sHT[1], high[1], sL[1], sLT[1], low[1], time[1]]

[x1L, x1H]      = request.security(smtSym, smtTf1, f_xSw(smtLenH), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=htfN)
[x2L, x2H]      = request.security(smtSym, smtTf2, f_xSw(smtLenH), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=htfN)
float g3L = na
float g3H = na
int   g3T = na
float x3L = na
float x3H = na
bool sn1 = timeframe.change(smtTf1)
bool sn2 = timeframe.change(smtTf2)
float g4L = na
float g4H = na
int   g4T = na
float x4L = na
float x4H = na
[w1H, w1HT, w1WH, w1L, w1LT, w1WL, w1T] = request.security(syminfo.tickerid, hsTf1, f_hSw(hswLen, hswAge), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[w2H, w2HT, w2WH, w2L, w2LT, w2WL, w2T] = request.security(syminfo.tickerid, hsTf2, f_hSw(hswLen, hswAge), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
bool hn1 = timeframe.change(hsTf1)
bool hn2 = timeframe.change(hsTf2)
bool hn3 = timeframe.change(hsTf3)
bool hn4 = timeframe.change(hsTf4)
bool sn3 = timeframe.change(smtTf3)
bool sn4 = timeframe.change(smtTf4)
var SmtTF st1 = SmtTF.new("")
var SmtTF st2 = SmtTF.new("")
var SmtTF st3 = SmtTF.new("")
var SmtTF st4 = SmtTF.new("")
var SmtTF st0 = SmtTF.new("")   // SMT เรียลไทม์ของ TF ชาร์ต

// ───────── สร้างแท่ง TF ใหญ่จากข้อมูลกราฟ (live ทุก tick) ─────────
f_htfCandles(string tf) =>
    var array<float> O = array.new<float>()
    var array<float> H = array.new<float>()
    var array<float> L = array.new<float>()
    var array<float> C = array.new<float>()
    var array<int>   T = array.new<int>()
    if timeframe.change(tf) or O.size() == 0
        O.push(open)
        H.push(high)
        L.push(low)
        C.push(close)
        T.push(time)
        if O.size() > 25
            O.shift()
            H.shift()
            L.shift()
            C.shift()
            T.shift()
    else
        int k = O.size() - 1
        H.set(k, math.max(H.get(k), high))
        L.set(k, math.min(L.get(k), low))
        C.set(k, close)
    [O, H, L, C, T]

[cAO, cAH, cAL, cAC, cAT] = f_htfCandles(cTfA)
[cBO, cBH, cBL, cBC, cBT] = f_htfCandles(cTfB)

var array<box>   pX = array.new<box>()
var array<line>  pL = array.new<line>()
var array<label> pB = array.new<label>()

// เกรดตามแต้มที่ขาดจาก Score เต็ม (ตรงกับเกณฑ์จาง/เข้ม minMiss)
f_grade(int sc, int mx) =>
    int m = mx - sc
    m <= 1 ? "A+" : m == 2 ? "A" : m == 3 ? "B" : "C"

// ───────── Helpers ─────────
var array<Lvl> lvL = array.new<Lvl>()
var array<Lvl> lvH = array.new<Lvl>()
var bool       lvBuilt = false
var array<line>  hL = array.new<line>()
var array<label> hB = array.new<label>()

f_keepL(line x) =>
    hL.push(x)
    if hL.size() > 40
        line.delete(hL.shift())

f_keepB(label x) =>
    hB.push(x)
    if hB.size() > 40
        label.delete(hB.shift())

f_col(string base, int kind) =>
    base == "QM" ? colQM : base == "OCL" ? colOCL : kind == 1 ? colS : colR

f_add(array<Lvl> arr, float p, int t0, int kind, string tag, int src, string tfs, int cap) =>
    bool  merged = false
    float mt     = math.max(atr * mrgA, syminfo.mintick)
    for l in arr
        if l.kind == kind and math.abs(l.price - p) <= mt
            if not str.contains(l.tag, tag)
                l.tag := l.tag + "·" + tag
            if src > 0 and not str.contains(l.tf, tfs)
                l.tf  := src > l.src ? tfs + "·" + l.tf : l.tf + "·" + tfs
                l.src := math.max(l.src, src)
            merged := true
            break
    if not merged
        color c  = f_col(tag, kind)
        line  ln = line.new(f_barAt(t0), p, bar_index + offs, p, color=c, width=lw)
        label lb = label.new(bar_index + 2, p, "", style=label.style_label_lower_left, color=cNone, textcolor=c, size=txtSz)
        arr.push(Lvl.new(p, t0, bar_index, kind, tag, tag, src, tfs, true, -1, ln, lb))
        if arr.size() > cap
            Lvl o = arr.shift()
            o.ln.delete()
            o.lb.delete()

// โหลดเลเวล HTF จากสถานะที่คำนวณใน TF นั้น (ชุดเดียวกันทุก TF กราฟ) · เส้นวาดตอนแท่งสุดท้ายเฉพาะเส้นที่แสดง
// old = ชุดก่อนโหลด: เลเวลที่ถูกแตะบนกราฟระหว่างแท่ง TF ใหญ่ที่ยังไม่ปิด → คงสถานะแตะแล้ว
f_lvLoad(string sP, string sK, string sB, string sG, string sT, string sF, int src, string tfs, float mt, array<Lvl> old) =>
    if not na(sP) and str.length(sP) > 0
        array<string> aP = str.split(sP, ",")
        array<string> aK = str.split(sK, ",")
        array<string> aB = str.split(sB, ",")
        array<string> aG = str.split(sG, ",")
        array<string> aT = str.split(sT, ",")
        array<string> aF = str.split(sF, ",")
        int n = math.min(aP.size(), aK.size(), aB.size(), aG.size(), aT.size(), aF.size())
        if n > 0
            for i = 0 to n - 1
                float p  = str.tonumber(aP.get(i))
                float kf = str.tonumber(aK.get(i))
                float tf = str.tonumber(aT.get(i))
                if not na(p) and not na(kf) and not na(tf)
                    int    k  = int(kf)
                    string g  = aG.get(i)
                    bool   fr = aF.get(i) == "1"
                    if fr
                        for o in old
                            if o.kind == k and o.src == src and math.abs(o.price - p) <= syminfo.mintick and not o.fresh
                                fr := false
                                break
                    bool merged = false
                    for l in lvH
                        if l.src != src and l.kind == k and math.abs(l.price - p) <= mt
                            if not str.contains(l.tag, g)
                                l.tag := l.tag + "·" + g
                            if not str.contains(l.tf, tfs)
                                l.tf := src > l.src ? tfs + "·" + l.tf : l.tf + "·" + tfs
                            merged := true
                            break
                    if not merged
                        lvH.push(Lvl.new(p, int(tf), bar_index - 1, k, aB.get(i), g, src, tfs, fr, -1, na, na))

// 0 = ไม่มีอะไร, 1 = กลายเป็น RBS, -1 = กลายเป็น SBR, 2 = ทะลุ (ลบทิ้ง)
f_break(Lvl l, float c) =>
    int r = 0
    if l.kind == -1 and c > l.price + tol
        if useFlip and l.base == "A"
            l.kind  := 1
            l.base  := "RBS"
            l.tag   := "RBS"
            l.fresh := true
            l.born  := bar_index
            r := 1
        else
            r := 2
    else if l.kind == 1 and c < l.price - tol
        if useFlip and l.base == "V"
            l.kind  := -1
            l.base  := "SBR"
            l.tag   := "SBR"
            l.fresh := true
            l.born  := bar_index
            r := -1
        else
            r := 2
    r

// true = ไส้แตะเลเวล Fresh ครั้งแรก
f_touch(Lvl l) =>
    bool hit = false
    if l.fresh and bar_index > l.born
        if (l.kind == -1 and high >= l.price - tol) or (l.kind == 1 and low <= l.price + tol)
            l.fresh  := false
            l.ftouch := bar_index
            hit := true
    hit

f_conf(Lvl h) =>
    string s  = ""
    float  ct = math.max(atr * confA, syminfo.mintick)
    for m in lvL
        if m.kind == h.kind and math.abs(m.price - h.price) <= ct
            s := m.tag
            break
    s

// TP: เลเวล HTF Fresh ฝั่งตรงข้ามที่ห่างจาก Entry อย่างน้อย md
f_target(int dir, float md, float ref) =>
    float t = na
    for m in lvH
        if m.fresh and m.kind == -dir and math.abs(m.price - ref) >= md
            if dir == 1 and m.price > ref and (na(t) or m.price < t)
                t := m.price
            if dir == -1 and m.price < ref and (na(t) or m.price > t)
                t := m.price
    t

// Entry: เลือกเลเวล MSNR ในขา MSS (ระหว่างไส้ sweep กับราคาปัจจุบัน)
f_entry(int d, float wick, float rbs, float zp, float eq) =>
    array<float>  cp = array.new<float>()
    array<string> cn = array.new<string>()
    cp.push(rbs)
    cn.push(d == 1 ? "RBS" : "SBR")
    for m in lvL
        if m.kind == d and m.fresh and ((d == 1 and m.price > wick and m.price < close) or (d == -1 and m.price < wick and m.price > close))
            cp.push(m.price)
            cn.push(m.tag)
    float  best = na
    string bt   = ""
    for i = 0 to cp.size() - 1
        float p    = cp.get(i)
        bool  inPD = d == 1 ? p <= eq : p >= eq
        bool  pick = na(best)
        if reqPD and not inPD
            continue
        if not pick
            if entryAt == "Nearest"
                pick := d == 1 ? p > best : p < best
            else if entryAt == "Deepest"
                pick := d == 1 ? p < best : p > best
            else
                pick := math.abs(p - zp) < math.abs(best - zp)
        if pick
            best := p
            bt   := cn.get(i)
    float ct = math.max(atr * confA, syminfo.mintick)
    bool  ov = not na(best) and math.abs(best - zp) <= ct
    [best, bt + (ov ? " ✦" : ""), ov]

// วาดแท่ง TF ใหญ่ทางขวา · คืน [ตำแหน่ง x ถัดไป, ระดับป้ายหัวกลุ่ม] · yMin = หัวกลุ่มต้องสูงกว่าระดับนี้ (ไม่ทับหัวกลุ่มก่อนหน้า)
f_drawC(array<float> O, array<float> H, array<float> L, array<float> C, array<int> T, int n, int x0, string tf, float yMin) =>
    int   x  = x0
    int   k  = O.size()
    float yH = yMin
    if n > 0 and k > 0 and timeframe.in_seconds(tf) > timeframe.in_seconds()
        int   cnt = math.min(n, k)
        float top = na
        for i = k - cnt to k - 1
            float o   = O.get(i)
            float h   = H.get(i)
            float l   = L.get(i)
            float c   = C.get(i)
            color col = c >= o ? colS : colR
            int   xl  = bar_index + x
            int   xr  = bar_index + x + cW - 1
            int   xc  = bar_index + x + int((cW - 1) / 2)
            pL.push(line.new(xc, h, xc, l, color=col, width=1))
            pX.push(box.new(xl, math.max(o, c), xr, math.min(o, c), border_color=col, bgcolor=col, border_width=1))
            if cSwp and i > 0
                float hp = H.get(i - 1)
                float lp = L.get(i - 1)
                if h > hp and c < hp
                    pB.push(label.new(xc, h, "S", style=label.style_label_down, color=cNone, textcolor=colR, size=size.tiny))
                if l < lp and c > lp
                    pB.push(label.new(xc, l, "S", style=label.style_label_up, color=cNone, textcolor=colS, size=size.tiny))
            top := na(top) ? h : math.max(top, h)
            x += cW + 1
        // หัวกลุ่ม: ชื่อ TF + เวลาที่เหลือ
        int    rem = time_close(tf) - timenow
        string cd  = cTime and not na(rem) and rem > 0 ? "  " + (rem >= 3600000 ? str.tostring(math.floor(rem / 3600000)) + "h" : "") + str.tostring(math.floor((rem % 3600000) / 60000)) + "m" : ""
        yH := na(yMin) ? top + atr : math.max(top + atr, yMin + labSep)
        pB.push(label.new(bar_index + x0, yH, f_tfTxt(tf) + cd, style=label.style_label_lower_left, color=cNone, textcolor=color.new(chart.fg_color, 30), size=txtSz))
        // เส้น Open ของแท่งปัจจุบัน
        if cOpen
            float oNow = O.get(k - 1)
            pL.push(line.new(f_barAt(T.get(k - 1)), oNow, bar_index + x - 1, oNow, color=color.new(chart.fg_color, 60), width=1, style=line.style_dotted))
        x += 3
    [x, yH]

// วาด SMT · ถ้ามี SMT ที่ swing เดียวกันอยู่แล้ว (ราคาใกล้กัน + เวลาอยู่ในแท่ง TF ใหญ่เดียวกัน) → ต่อชื่อ TF ในป้ายเดิม ไม่วาดซ้ำ
var array<label> smL = array.new<label>()
var array<float> smP = array.new<float>()
var array<int>   smT = array.new<int>()
var array<int>   smW = array.new<int>()
// เส้นของ Sweep / SMT ผูกกับป้าย: ป้ายถูกลบเมื่อไร เส้นที่อยู่ช่วงเวลาเดียวกันลบตาม (ไม่มีเส้นค้างไร้ป้าย)
var array<line>  evL = array.new<line>()
var array<int>   evT = array.new<int>()
int labWin = chSec * 1000 * 8          // ป้ายห่างกันไม่ถึง 8 แท่ง + ราคาใกล้ = รวมเป็นป้ายเดียว
f_evLine(line x, int t) =>
    evL.push(x)
    evT.push(t)
    if evL.size() > 90
        line.delete(evL.shift())
        evT.shift()
f_smDrop() =>
    label.delete(smL.shift())
    smP.shift()
    int t = smT.shift()
    int w = math.max(smW.shift(), labWin)
    int n = evL.size()
    if n > 0
        for i = n - 1 to 0
            if math.abs(evT.get(i) - t) <= w
                line.delete(evL.get(i))
                evL.remove(i)
                evT.remove(i)
f_smtMark(int t1, float p1, int t2, float p2, string nm, bool up, int win, bool htf) =>
    bool  merged = false
    float tl     = math.max(labSep, syminfo.mintick)
    int   n      = smL.size()
    if n > 0
        for i = n - 1 to 0
            if math.abs(smP.get(i) - p2) <= tl and math.abs(smT.get(i) - t2) <= math.max(win, smW.get(i), labWin)
                label lb  = smL.get(i)
                string tx = label.get_text(lb)
                if not str.contains(tx, "SMT")
                    label.set_text(lb, tx + " · SMT " + nm)
                    label.set_textcolor(lb, colSMT)
                else if not str.contains(tx, " " + nm)
                    label.set_text(lb, tx + (str.endswith(tx, "SMT") ? " " : " · ") + nm)
                merged := true
                break
    if not merged
        f_evLine(line.new(t1, p1, t2, p2, xloc=xloc.bar_time, color=colSMT, width=lw, style=htf ? line.style_dashed : line.style_dotted), t2)
        label lb = label.new(t2, p2, "SMT " + nm, xloc=xloc.bar_time, style=up ? label.style_label_up : label.style_label_down, color=cNone, textcolor=colSMT, size=txtSz)
        smL.push(lb)
        smP.push(p2)
        smT.push(t2)
        smW.push(win)
        if smL.size() > 30
            f_smDrop()

// ป้าย Sweep: ถ้ามีป้าย SMT ที่จุดเดียวกันอยู่แล้ว → ใส่ "Sweep ..." ไว้หน้าป้ายเดิม
f_sweepMark(int t, float p, string txt, bool up, color col) =>
    bool  merged = false
    float tl     = math.max(labSep, syminfo.mintick)
    int   n      = smL.size()
    if n > 0
        for i = n - 1 to 0
            if math.abs(smP.get(i) - p) <= tl and math.abs(smT.get(i) - t) <= math.max(chSec * 1000 * (sLen + 1), smW.get(i), labWin)
                label lb  = smL.get(i)
                string tx = label.get_text(lb)
                if not str.contains(tx, "Sweep")
                    label.set_text(lb, str.replace(txt, " · SMT", "") + " · " + tx)
                    label.set_textcolor(lb, colSMT)
                merged := true
                break
    if not merged
        label lb = label.new(t, p, txt, xloc=xloc.bar_time, style=up ? label.style_label_up : label.style_label_down, color=cNone, textcolor=col, size=txtSz)
        smL.push(lb)
        smP.push(p)
        smT.push(t)
        smW.push(chSec * 1000 * (sLen + 1))
        if smL.size() > 30
            f_smDrop()

// หาแท่งบนกราฟที่ทำ High/Low จริงภายในแท่ง TF ใหญ่ (เปิดที่เวลา t ยาว ms) → คืนเวลาแท่งนั้น
f_exactT(int t, int ms, bool lo, float p) =>
    int   r = t
    float e = syminfo.mintick / 2
    for j = 0 to 499
        int tj = time[j]
        if na(tj) or tj < t
            break
        if tj < t + ms and (lo ? low[j] <= p + e : high[j] >= p - e)
            r := tj
    r

// ป้าย Sweep TF ใหญ่: ถ้ามีป้าย Sweep / SMT ที่ไส้เดียวกันอยู่แล้ว → ใส่ "Sweep H4" ไว้หน้าป้ายเดิม (ไม่ซ้อน)
f_hswMark(int t, float p, string nm, bool up, int win) =>
    bool   merged = false
    float  tl     = math.max(labSep, syminfo.mintick)
    string tx0    = "Sweep " + nm
    int    n      = smL.size()
    if n > 0
        for i = n - 1 to 0
            if math.abs(smP.get(i) - p) <= tl and math.abs(smT.get(i) - t) <= math.max(win, smW.get(i), labWin)
                label  lb = smL.get(i)
                string tx = label.get_text(lb)
                if not str.contains(tx, tx0)
                    label.set_text(lb, tx0 + " · " + tx)
                merged := true
                break
    if not merged
        label lb = label.new(t, p, tx0, xloc=xloc.bar_time, style=up ? label.style_label_up : label.style_label_down, color=cNone, textcolor=colSw, size=txtSz)
        smL.push(lb)
        smP.push(p)
        smT.push(t)
        smW.push(win)
        if smL.size() > 30
            f_smDrop()

// วาด Sweep ของ TF ใหญ่บนกราฟเล็ก: เส้นประจาก swing → แท่งที่ไส้ทะลุ (ชี้แท่งกราฟเล็กที่ทำ High/Low จริง)
f_hswDraw(string tf, float sH, int sHT, float wH, float sL, int sLT, float wL, int bt) =>
    if timeframe.in_seconds(tf) > chSec
        string nm = f_tfTxt(tf)
        int    ms = timeframe.in_seconds(tf) * 1000
        if not na(sH) and not na(sHT)
            int a = f_exactT(sHT, ms, false, sH)
            int b = f_exactT(bt, ms, false, wH)
            f_evLine(line.new(a, sH, b, sH, xloc=xloc.bar_time, color=colSw, width=lw, style=line.style_dashed), b)
            f_hswMark(b, wH, nm, false, ms)
        if not na(sL) and not na(sLT)
            int a = f_exactT(sLT, ms, true, sL)
            int b = f_exactT(bt, ms, true, wL)
            f_evLine(line.new(a, sL, b, sL, xloc=xloc.bar_time, color=colSw, width=lw, style=line.style_dashed), b)
            f_hswMark(b, wL, nm, true, ms)

// SMT ของ TF ใหญ่: ทอง LL + เงิน HL = Bullish · ทอง HH + เงิน LH = Bearish → วาดเส้นบนกราฟเล็ก
f_smtTF(SmtTF s, bool on, string tf, bool nw, float gl, float gh, int gt, float xl, float xh) =>
    if on and nw and timeframe.in_seconds(tf) > chSec
        string nm = f_tfTxt(tf)
        int    ms = timeframe.in_seconds(tf) * 1000
        if not na(gl) and not na(xl)
            int tL = f_exactT(gt, ms, true, gl)
            if not na(s.gl) and not na(s.xl) and gl < s.gl and xl > s.xl
                s.ub := bar_index
                if showSMT and inDay
                    f_smtMark(s.glt, s.gl, tL, gl, nm, true, ms, true)
            s.gl  := gl
            s.glt := tL
            s.xl  := xl
            s.rgl := na
            s.rxl := na
        if not na(gh) and not na(xh)
            int tH = f_exactT(gt, ms, false, gh)
            if not na(s.gh) and not na(s.xh) and gh > s.gh and xh < s.xh
                s.db := bar_index
                if showSMT and inDay
                    f_smtMark(s.ght, s.gh, tH, gh, nm, false, ms, true)
            s.gh  := gh
            s.ght := tH
            s.xh  := xh
            s.rgh := na
            s.rxh := na

// SMT ของ TF ใหญ่ยังสด (เกิดไม่เกิน smtLive แท่งของ TF นั้น) · คืน 1 / -1 / 0 (ล่าสุดชนะ)
f_smtAct(SmtTF s, bool on, string tf) =>
    int  w  = math.round(smtLive * timeframe.in_seconds(tf) / math.max(chSec, 1))
    bool ok = on and useSMT and timeframe.in_seconds(tf) > chSec
    bool u  = ok and bar_index - s.ub <= w
    bool d  = ok and bar_index - s.db <= w
    u and d ? (s.ub >= s.db ? 1 : -1) : u ? 1 : d ? -1 : 0

// SMT เรียลไทม์: ทองทะลุ swing ล่าสุดที่ยืนยันแล้ว แต่เงินยังไม่ทะลุ swing เดียวกัน
// เก็บ Low/High ต่ำสุด/สูงสุดตั้งแต่ swing ยืนยัน (คำนวณใหม่ทุก tick) · วาดเส้นจาง อัปเดตตามราคา · เงินทะลุตาม = ลบเส้น
f_smtLive(SmtTF s, bool ok, float rL, int rLT, float rXL, float rH, int rHT, float rXH, bool htf) =>
    bool u = false
    bool d = false
    if ok
        if na(s.rgl) or low < s.rgl
            s.rgl  := low
            s.rglt := time
        if not na(xLo)
            s.rxl := na(s.rxl) ? xLo : math.min(s.rxl, xLo)
        if na(s.rgh) or high > s.rgh
            s.rgh  := high
            s.rght := time
        if not na(xHi)
            s.rxh := na(s.rxh) ? xHi : math.max(s.rxh, xHi)
        u := not na(rL) and not na(rXL) and not na(s.rxl) and s.rgl < rL and s.rxl > rXL
        d := not na(rH) and not na(rXH) and not na(s.rxh) and s.rgh > rH and s.rxh < rXH
    color c = color.new(colSMT, 50)
    if u and smtRT and showSMT
        if na(s.lu)
            s.lu := line.new(rLT, rL, s.rglt, s.rgl, xloc=xloc.bar_time, color=c, width=lw, style=htf ? line.style_dashed : line.style_dotted)
        else
            line.set_xy1(s.lu, rLT, rL)
            line.set_xy2(s.lu, s.rglt, s.rgl)
    else if not na(s.lu)
        line.delete(s.lu)
        s.lu := na
    if d and smtRT and showSMT
        if na(s.ld)
            s.ld := line.new(rHT, rH, s.rght, s.rgh, xloc=xloc.bar_time, color=c, width=lw, style=htf ? line.style_dashed : line.style_dotted)
        else
            line.set_xy1(s.ld, rHT, rH)
            line.set_xy2(s.ld, s.rght, s.rgh)
    else if not na(s.ld)
        line.delete(s.ld)
        s.ld := na
    [u, d]

// SMT เรียลไทม์ ณ ตอนนี้ของ TF ใหญ่ (ใช้นับแต้มตอน Sweep) · 1 / -1 / 0
f_smtNow(SmtTF s, bool on, string tf) =>
    int r = 0
    if on and useSMT and smtRT and timeframe.in_seconds(tf) > chSec
        float gl = na(s.rgl) ? low : math.min(s.rgl, low)
        float gh = na(s.rgh) ? high : math.max(s.rgh, high)
        float xl = na(s.rxl) ? xLo : math.min(s.rxl, xLo)
        float xh = na(s.rxh) ? xHi : math.max(s.rxh, xHi)
        r := not na(s.gl) and not na(s.xl) and not na(xl) and gl < s.gl and xl > s.xl ? 1 : not na(s.gh) and not na(s.xh) and not na(xh) and gh > s.gh and xh < s.xh ? -1 : 0
    r

// เลือกจุดที่ไกลสุด (Low ต่ำสุด / High สูงสุด) ของ TF ที่มี SMT เรียลไทม์ → ไว้วางป้ายเดียว
f_pk(bool on, float p, int t, float bp, int bt, bool lo) =>
    bool tk = on and not na(p) and (na(bp) or (lo ? p < bp : p > bp))
    [tk ? p : bp, tk ? t : bt]

// ───────── State ─────────
// MSS: swing ฝั่งตรงข้ามล่าสุด (ความยาว mssLen หรือเท่า sLen)
int   mL   = mssLen > 0 ? mssLen : sLen
float msPH = ta.pivothigh(high, mL, mL)
float msPL = ta.pivotlow(low, mL, mL)
var int lsHT = na        // เวลา swing high ล่าสุด (ไส้) → ใช้หาระดับ MSS ตอน Sweep Key liquidity
var int lsLT = na

var float hiP = na
var int   hiT = na
var int   hiB = na
var float loP = na
var int   loT = na
var int   loB = na
var float bqLvl = na
var int   bqT   = na
var float bqBrk = na
var float bqInv = na
var float uqLvl = na
var int   uqT   = na
var float uqBrk = na
var float uqInv = na

// liquidity swings (ไส้)
var array<float> sLP = array.new<float>()
var array<int>   sLB = array.new<int>()
var array<int>   sLT = array.new<int>()
var array<bool>  sLE = array.new<bool>()
var array<bool>  sHE = array.new<bool>()
var array<float> sLX = array.new<float>()
var array<float> sHX = array.new<float>()
var array<float> sHP = array.new<float>()
var array<int>   sHB = array.new<int>()
var array<int>   sHT = array.new<int>()

// ════════════════════════════════════════════════════════════════
// ███ MODULE OB PRO: Supply & Demand / Orderblocks (TF ชาร์ต + H1 + H4) ███
