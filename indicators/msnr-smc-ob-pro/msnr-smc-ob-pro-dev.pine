int    htfN     = input.int(800, "TF ใหญ่: ขอข้อมูลย้อนหลัง (แท่งของ TF นั้น)", minval=100, maxval=5000, step=100, group=GP, display=display.none, tooltip="จำนวนแท่ง H1 / H4 / M15 / M30 / D และ SMT ที่ดึงมาคำนวณ · M15 800 แท่ง ≈ 2400 แท่ง M5 (ครอบช่วง 'คำนวณย้อนหลัง')\nน้อย = เร็วขึ้น")

