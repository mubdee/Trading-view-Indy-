// ───────── Types ─────────
type Lvl
    float  price
    int    t0
    int    born
    int    kind      // 1 = แนวรับ, -1 = แนวต้าน
    string base
    string tag
    int    src       // 0 = ชาร์ต, 1 = HTF1, 2 = HTF2
    string tf
    bool   fresh
    int    ftouch
    line   ln
    label  lb

// ───────── Common ─────────
float atr    = ta.atr(14)
float tol    = atr * tolA
int   barMs  = timeframe.in_seconds() * 1000
bool  inSess = not useSess or not na(time(timeframe.period, sess, "Asia/Bangkok"))
color cNone  = color.new(color.black, 100)
// ช่วงที่คำนวณ: เฉพาะ calcN แท่งสุดท้ายของกราฟ (+ realtime)
bool  inCalc = bar_index > last_bar_index - calcN

f_tfTxt(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 604800 ? "W" + str.tostring(s / 604800) : s >= 86400 ? "D" + str.tostring(s / 86400) : s >= 3600 ? "H" + str.tostring(s / 3600) : "M" + str.tostring(s / 60)

// แปลงเวลา → bar_index (วาดด้วย bar_index เพื่อไม่ให้เส้นอนาคตไปกองรวมกันตอนตลาดปิด/เสาร์-อาทิตย์)
f_barAt(int t) =>
    int r = bar_index - 499
    for j = 0 to 499
        if time[j] <= t
            r := bar_index - j
            break
    r

string tf1T = f_tfTxt(tf1)
string tf2T = f_tfTxt(tf2)

// ───────── HTF data (แท่งที่ปิดแล้วเท่านั้น = ไม่ repaint) ─────────
f_htf(int L, int R, float gk) =>
    float a  = ta.atr(14)
    float h  = ta.pivothigh(close, L, R)
    float l  = ta.pivotlow(close, L, R)
    bool  bg = close[1] < open[1] and close < open and math.abs(open - close[1]) >= math.max(gk * a, syminfo.mintick)
    bool  ug = close[1] > open[1] and close > open and math.abs(open - close[1]) >= math.max(gk * a, syminfo.mintick)
    float g  = bg or ug ? close[1] : na
    int   gd = bg ? -1 : ug ? 1 : 0
    [h[1], l[1], time[R + 1], g[1], gd[1], time[2], close[1]]

[h1H, h1L, h1T, h1G, h1D, h1GT, h1C] = request.security(syminfo.tickerid, tf1, f_htf(pvLH, pvRH, gapA), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[h2H, h2L, h2T, h2G, h2D, h2GT, h2C] = request.security(syminfo.tickerid, tf2, f_htf(pvLH, pvRH, gapA), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
bool nb1 = timeframe.change(tf1)
bool nb2 = timeframe.change(tf2)

// ───────── LTF series ─────────
float ph  = ta.pivothigh(close, pvL, pvR)        // MSNR: จาก Close
float pl  = ta.pivotlow(close, pvL, pvR)
float sph = ta.pivothigh(high, sLen, sLen)       // Liquidity: จากไส้
float spl = ta.pivotlow(low, sLen, sLen)
float gapSz   = math.abs(open - close[1])
bool  bearOCL = close[1] < open[1] and close < open and gapSz >= math.max(gapA * atr, syminfo.mintick)
bool  bullOCL = close[1] > open[1] and close > open and gapSz >= math.max(gapA * atr, syminfo.mintick)

// ───────── Key liquidity: PDH/PDL · Asia H/L ─────────
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
bool inAsia = not na(time(timeframe.period, asiaSess, "Asia/Bangkok"))
bool inKz   = not na(time(timeframe.period, kzLon, "Asia/Bangkok")) or not na(time(timeframe.period, kzNy, "Asia/Bangkok"))
var float aH   = na
var float aL   = na
var float curH = na
var float curL = na
if inAsia
    curH := inAsia[1] ? math.max(curH, high) : high
    curL := inAsia[1] ? math.min(curL, low) : low
else if inAsia[1]
    aH := curH
    aL := curL
var float usedPDH = na
var float usedPDL = na

// ───────── SMT: ทองกวาด แต่สินทรัพย์เทียบไม่ยืนยัน ─────────
[xLo, xHi] = request.security(smtSym, timeframe.period, [low, high], ignore_invalid_symbol=true, calc_bars_count=calcN + 100)
// จุดต่ำสุด/สูงสุดของสินทรัพย์เทียบรอบ swing (ดูก่อน-หลัง swing ของทอง sLen แท่ง)
float xVal = ta.lowest(xLo, 2 * sLen + 1)
float xPk  = ta.highest(xHi, 2 * sLen + 1)
var float pGL = na
var int   pGT = na
var float pXL = na
var float pGH = na
var int   pHT = na
var float pXH = na
var int   smtUBar = -1000
var int   smtDBar = -1000

// ───────── SMT หลายทามเฟรม (แท่ง TF ใหญ่ที่ปิดแล้วเท่านั้น = ไม่ repaint) ─────────
type SmtTF
    string name
    float  gl
    int    glt
    float  xl
    float  gh
    int    ght
    float  xh
    int    ub = -100000
    int    db = -100000
    float  rgl
    int    rglt
    float  rxl
    float  rgh
    int    rght
    float  rxh
    line   lu
    line   ld

f_gSw(int L) =>
    [ta.pivotlow(low, L, L)[1], ta.pivothigh(high, L, L)[1], time[L + 1]]
f_xSw(int L) =>
    [ta.lowest(low, 2 * L + 1)[1], ta.highest(high, 2 * L + 1)[1]]

// ───────── Sweep ของ TF ใหญ่ (คำนวณใน TF นั้น · ส่งเฉพาะแท่งที่ปิดแล้ว = ไม่ repaint) ─────────
// ไส้ทะลุ swing ล่าสุด (เว้น ≥ 1 แท่งคั่น · swing ไม่เก่าเกิน age แท่ง) แล้วปิดกลับ = Sweep · ปิดทะลุ = swing นั้นใช้แล้ว
f_hSw(int L, int age) =>
    var float hP = na
    var int   hT = na
    var int   hB = na
    var float lP = na
    var int   lT = na
    var int   lB = na
    float sH  = na
    int   sHT = na
    float sL  = na
    int   sLT = na
    float p1  = ta.pivothigh(high, L, L)
    float p2  = ta.pivotlow(low, L, L)
    if not na(hP) and high > hP
        if close < hP and bar_index - hB <= age and bar_index - hB >= 2
            sH  := hP
            sHT := hT
        hP := na
    if not na(lP) and low < lP
        if close > lP and bar_index - lB <= age and bar_index - lB >= 2
            sL  := lP
            sLT := lT
        lP := na
    if not na(p1)
        hP := p1
        hT := time[L]
        hB := bar_index - L
    if not na(p2)
        lP := p2
        lT := time[L]
        lB := bar_index - L
    [sH[1], sHT[1], high[1], sL[1], sLT[1], low[1], time[1]]

[g1L, g1H, g1T] = request.security(syminfo.tickerid, smtTf1, f_gSw(smtLenH), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[x1L, x1H]      = request.security(smtSym, smtTf1, f_xSw(smtLenH), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=htfN)
[g2L, g2H, g2T] = request.security(syminfo.tickerid, smtTf2, f_gSw(smtLenH), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[x2L, x2H]      = request.security(smtSym, smtTf2, f_xSw(smtLenH), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=htfN)
[g3L, g3H, g3T] = request.security(syminfo.tickerid, smtTf3, f_gSw(smtLenH), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[x3L, x3H]      = request.security(smtSym, smtTf3, f_xSw(smtLenH), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=htfN)
bool sn1 = timeframe.change(smtTf1)
bool sn2 = timeframe.change(smtTf2)
[g4L, g4H, g4T] = request.security(syminfo.tickerid, smtTf4, f_gSw(smtLenH), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[x4L, x4H]      = request.security(smtSym, smtTf4, f_xSw(smtLenH), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=htfN)
[w1H, w1HT, w1WH, w1L, w1LT, w1WL, w1T] = request.security(syminfo.tickerid, hsTf1, f_hSw(hswLen, hswAge), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[w2H, w2HT, w2WH, w2L, w2LT, w2WL, w2T] = request.security(syminfo.tickerid, hsTf2, f_hSw(hswLen, hswAge), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[w3H, w3HT, w3WH, w3L, w3LT, w3WL, w3T] = request.security(syminfo.tickerid, hsTf3, f_hSw(hswLen, hswAge), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[w4H, w4HT, w4WH, w4L, w4LT, w4WL, w4T] = request.security(syminfo.tickerid, hsTf4, f_hSw(hswLen, hswAge), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
bool hn1 = timeframe.change(hsTf1)
bool hn2 = timeframe.change(hsTf2)
bool hn3 = timeframe.change(hsTf3)
bool hn4 = timeframe.change(hsTf4)
bool sn3 = timeframe.change(smtTf3)
bool sn4 = timeframe.change(smtTf4)
var SmtTF st1 = SmtTF.new("")
var SmtTF st2 = SmtTF.new("")
var SmtTF st3 = SmtTF.new("")
var SmtTF st4 = SmtTF.new("")
var SmtTF st0 = SmtTF.new("")   // SMT เรียลไทม์ของ TF ชาร์ต
int chSec = timeframe.in_seconds()

// ───────── สร้างแท่ง TF ใหญ่จากข้อมูลกราฟ (live ทุก tick) ─────────
f_htfCandles(string tf) =>
    var array<float> O = array.new<float>()
    var array<float> H = array.new<float>()
    var array<float> L = array.new<float>()
    var array<float> C = array.new<float>()
    var array<int>   T = array.new<int>()
    if timeframe.change(tf) or O.size() == 0
        O.push(open)
        H.push(high)
        L.push(low)
        C.push(close)
        T.push(time)
        if O.size() > 25
            O.shift()
            H.shift()
            L.shift()
            C.shift()
            T.shift()
    else
        int k = O.size() - 1
        H.set(k, math.max(H.get(k), high))
        L.set(k, math.min(L.get(k), low))
        C.set(k, close)
    [O, H, L, C, T]

[cAO, cAH, cAL, cAC, cAT] = f_htfCandles(cTfA)
[cBO, cBH, cBL, cBC, cBT] = f_htfCandles(cTfB)

var array<box>   pX = array.new<box>()
var array<line>  pL = array.new<line>()
var array<label> pB = array.new<label>()

f_grade(int sc, int mx) =>
    sc >= mx - 1 ? "A+" : sc == mx - 2 ? "A" : sc == mx - 3 ? "B" : "C"

// ───────── Helpers ─────────
var array<Lvl> lvL = array.new<Lvl>()
var array<Lvl> lvH = array.new<Lvl>()
var array<line>  hL = array.new<line>()
var array<label> hB = array.new<label>()

f_keepL(line x) =>
    hL.push(x)
    if hL.size() > 40
        line.delete(hL.shift())

f_keepB(label x) =>
    hB.push(x)
    if hB.size() > 40
        label.delete(hB.shift())

f_col(string base, int kind) =>
    base == "QM" ? colQM : base == "OCL" ? colOCL : kind == 1 ? colS : colR

f_add(array<Lvl> arr, float p, int t0, int kind, string tag, int src, string tfs, int cap) =>
    bool  merged = false
    float mt     = math.max(atr * mrgA, syminfo.mintick)
    for l in arr
        if l.kind == kind and math.abs(l.price - p) <= mt
            if not str.contains(l.tag, tag)
                l.tag := l.tag + "·" + tag
            if src > 0 and not str.contains(l.tf, tfs)
                l.tf  := src > l.src ? tfs + "·" + l.tf : l.tf + "·" + tfs
                l.src := math.max(l.src, src)
            merged := true
            break
    if not merged
        color c  = f_col(tag, kind)
        line  ln = line.new(f_barAt(t0), p, bar_index + offs, p, color=c, width=lw)
        label lb = label.new(bar_index + 2, p, "", style=label.style_label_lower_left, color=cNone, textcolor=c, size=txtSz)
        arr.push(Lvl.new(p, t0, bar_index, kind, tag, tag, src, tfs, true, -1, ln, lb))
        if arr.size() > cap
            Lvl o = arr.shift()
            o.ln.delete()
            o.lb.delete()

// 0 = ไม่มีอะไร, 1 = กลายเป็น RBS, -1 = กลายเป็น SBR, 2 = ทะลุ (ลบทิ้ง)
f_break(Lvl l, float c) =>
    int r = 0
    if l.kind == -1 and c > l.price + tol
        if useFlip and l.base == "A"
            l.kind  := 1
            l.base  := "RBS"
            l.tag   := "RBS"
            l.fresh := true
            l.born  := bar_index
            r := 1
        else
            r := 2
    else if l.kind == 1 and c < l.price - tol
        if useFlip and l.base == "V"
            l.kind  := -1
            l.base  := "SBR"
            l.tag   := "SBR"
            l.fresh := true
            l.born  := bar_index
            r := -1
        else
            r := 2
    r

// true = ไส้แตะเลเวล Fresh ครั้งแรก
f_touch(Lvl l) =>
    bool hit = false
    if l.fresh and bar_index > l.born
        if (l.kind == -1 and high >= l.price - tol) or (l.kind == 1 and low <= l.price + tol)
            l.fresh  := false
            l.ftouch := bar_index
            hit := true
    hit

// เช็กเลเวล HTF ตอนแท่ง HTF ปิด: ทะลุ / flip / rejection → คืนทิศ Storyline
f_htfClose(int k, float c, int since) =>
    int st = 0
    int n  = lvH.size()
    if n > 0 and not na(c)
        for i = n - 1 to 0
            Lvl l = lvH.get(i)
            if l.src == k and bar_index > l.born
                int r = f_break(l, c)
                if r == 2
                    st := l.kind
                    l.ln.delete()
                    l.lb.delete()
                    lvH.remove(i)
                else if r != 0
                    st := r
                else if l.ftouch >= since and l.ftouch < bar_index
                    st := l.kind
    st

f_conf(Lvl h) =>
    string s  = ""
    float  ct = math.max(atr * confA, syminfo.mintick)
    for m in lvL
        if m.kind == h.kind and math.abs(m.price - h.price) <= ct
            s := m.tag
            break
    s

// TP: เลเวล HTF Fresh ฝั่งตรงข้ามที่ห่างจาก Entry อย่างน้อย md
f_target(int dir, float md, float ref) =>
    float t = na
    for m in lvH
        if m.fresh and m.kind == -dir and math.abs(m.price - ref) >= md
            if dir == 1 and m.price > ref and (na(t) or m.price < t)
                t := m.price
            if dir == -1 and m.price < ref and (na(t) or m.price > t)
                t := m.price
    t

// Entry: เลือกเลเวล MSNR ในขา MSS (ระหว่างไส้ sweep กับราคาปัจจุบัน)
f_entry(int d, float wick, float rbs, float zp, float eq) =>
    array<float>  cp = array.new<float>()
    array<string> cn = array.new<string>()
    cp.push(rbs)
    cn.push(d == 1 ? "RBS" : "SBR")
    for m in lvL
        if m.kind == d and m.fresh and ((d == 1 and m.price > wick and m.price < close) or (d == -1 and m.price < wick and m.price > close))
            cp.push(m.price)
            cn.push(m.tag)
    float  best = na
    string bt   = ""
    for i = 0 to cp.size() - 1
        float p    = cp.get(i)
        bool  inPD = d == 1 ? p <= eq : p >= eq
        bool  pick = na(best)
        if reqPD and not inPD
            continue
        if not pick
            if entryAt == "Nearest"
                pick := d == 1 ? p > best : p < best
            else if entryAt == "Deepest"
                pick := d == 1 ? p < best : p > best
            else
                pick := math.abs(p - zp) < math.abs(best - zp)
        if pick
            best := p
            bt   := cn.get(i)
    float ct = math.max(atr * confA, syminfo.mintick)
    bool  ov = not na(best) and math.abs(best - zp) <= ct
    [best, bt + (ov ? " ✦" : ""), ov]

// วาดแท่ง TF ใหญ่ทางขวา · คืนตำแหน่ง x ถัดไป (นับเป็นแท่งกราฟจากแท่งปัจจุบัน)
f_drawC(array<float> O, array<float> H, array<float> L, array<float> C, array<int> T, int n, int x0, string tf) =>
    int x = x0
    int k = O.size()
    if n > 0 and k > 0 and timeframe.in_seconds(tf) > timeframe.in_seconds()
        int   cnt = math.min(n, k)
        float top = na
        for i = k - cnt to k - 1
            float o   = O.get(i)
            float h   = H.get(i)
            float l   = L.get(i)
            float c   = C.get(i)
            color col = c >= o ? colS : colR
            int   xl  = bar_index + x
            int   xr  = bar_index + x + cW - 1
            int   xc  = bar_index + x + int((cW - 1) / 2)
            pL.push(line.new(xc, h, xc, l, color=col, width=1))
            pX.push(box.new(xl, math.max(o, c), xr, math.min(o, c), border_color=col, bgcolor=col, border_width=1))
            if cSwp and i > 0
                float hp = H.get(i - 1)
                float lp = L.get(i - 1)
                if h > hp and c < hp
                    pB.push(label.new(xc, h, "S", style=label.style_label_down, color=cNone, textcolor=colR, size=size.tiny))
                if l < lp and c > lp
                    pB.push(label.new(xc, l, "S", style=label.style_label_up, color=cNone, textcolor=colS, size=size.tiny))
            top := na(top) ? h : math.max(top, h)
            x += cW + 1
        // หัวกลุ่ม: ชื่อ TF + เวลาที่เหลือ
        int    rem = time_close(tf) - timenow
        string cd  = cTime and not na(rem) and rem > 0 ? "  " + (rem >= 3600000 ? str.tostring(math.floor(rem / 3600000)) + "h" : "") + str.tostring(math.floor((rem % 3600000) / 60000)) + "m" : ""
        pB.push(label.new(bar_index + x0, top + atr, f_tfTxt(tf) + cd, style=label.style_label_lower_left, color=cNone, textcolor=color.new(chart.fg_color, 30), size=txtSz))
        // เส้น Open ของแท่งปัจจุบัน
        if cOpen
            float oNow = O.get(k - 1)
            pL.push(line.new(f_barAt(T.get(k - 1)), oNow, bar_index + x - 1, oNow, color=color.new(chart.fg_color, 60), width=1, style=line.style_dotted))
        x += 3
    x

// วาด SMT · ถ้ามี SMT ที่ swing เดียวกันอยู่แล้ว (ราคาใกล้กัน + เวลาอยู่ในแท่ง TF ใหญ่เดียวกัน) → ต่อชื่อ TF ในป้ายเดิม ไม่วาดซ้ำ
var array<label> smL = array.new<label>()
var array<float> smP = array.new<float>()
var array<int>   smT = array.new<int>()
var array<int>   smW = array.new<int>()
f_smtMark(int t1, float p1, int t2, float p2, string nm, bool up, int win, bool htf) =>
    bool  merged = false
    float tl     = math.max(atr * 0.5, syminfo.mintick)
    int   n      = smL.size()
    if n > 0
        for i = n - 1 to 0
            if math.abs(smP.get(i) - p2) <= tl and math.abs(smT.get(i) - t2) <= math.max(win, smW.get(i))
                label lb  = smL.get(i)
                string tx = label.get_text(lb)
                if not str.contains(tx, "SMT")
                    label.set_text(lb, tx + " · SMT " + nm)
                    label.set_textcolor(lb, colSMT)
                else if not str.contains(tx, " " + nm)
                    label.set_text(lb, tx + (str.endswith(tx, "SMT") ? " " : " · ") + nm)
                merged := true
                break
    if not merged
        f_keepL(line.new(t1, p1, t2, p2, xloc=xloc.bar_time, color=colSMT, width=lw, style=htf ? line.style_dashed : line.style_dotted))
        label lb = label.new(t2, p2, "SMT " + nm, xloc=xloc.bar_time, style=up ? label.style_label_up : label.style_label_down, color=cNone, textcolor=colSMT, size=txtSz)
        smL.push(lb)
        smP.push(p2)
        smT.push(t2)
        smW.push(win)
        if smL.size() > 20
            label.delete(smL.shift())
            smP.shift()
            smT.shift()
            smW.shift()

// ป้าย Sweep: ถ้ามีป้าย SMT ที่จุดเดียวกันอยู่แล้ว → ใส่ "Sweep ..." ไว้หน้าป้ายเดิม
f_sweepMark(int t, float p, string txt, bool up, color col) =>
    bool  merged = false
    float tl     = math.max(atr * 0.5, syminfo.mintick)
    int   n      = smL.size()
    if n > 0
        for i = n - 1 to 0
            if math.abs(smP.get(i) - p) <= tl and math.abs(smT.get(i) - t) <= math.max(chSec * 1000 * (sLen + 1), smW.get(i))
                label lb  = smL.get(i)
                string tx = label.get_text(lb)
                if not str.contains(tx, "Sweep")
                    label.set_text(lb, str.replace(txt, " · SMT", "") + " · " + tx)
                    label.set_textcolor(lb, colSMT)
                merged := true
                break
    if not merged
        label lb = label.new(t, p, txt, xloc=xloc.bar_time, style=up ? label.style_label_up : label.style_label_down, color=cNone, textcolor=col, size=txtSz)
        smL.push(lb)
        smP.push(p)
        smT.push(t)
        smW.push(chSec * 1000 * (sLen + 1))
        if smL.size() > 20
            label.delete(smL.shift())
            smP.shift()
            smT.shift()
            smW.shift()

// หาแท่งบนกราฟที่ทำ High/Low จริงภายในแท่ง TF ใหญ่ (เปิดที่เวลา t ยาว ms) → คืนเวลาแท่งนั้น
f_exactT(int t, int ms, bool lo, float p) =>
    int   r = t
    float e = syminfo.mintick / 2
    for j = 0 to 499
        int tj = time[j]
        if na(tj) or tj < t
            break
        if tj < t + ms and (lo ? low[j] <= p + e : high[j] >= p - e)
            r := tj
    r

// ป้าย Sweep TF ใหญ่: ถ้ามีป้าย Sweep / SMT ที่ไส้เดียวกันอยู่แล้ว → ใส่ "Sweep H4" ไว้หน้าป้ายเดิม (ไม่ซ้อน)
f_hswMark(int t, float p, string nm, bool up, int win) =>
    bool   merged = false
    float  tl     = math.max(atr * 0.5, syminfo.mintick)
    string tx0    = "Sweep " + nm
    int    n      = smL.size()
    if n > 0
        for i = n - 1 to 0
            if math.abs(smP.get(i) - p) <= tl and math.abs(smT.get(i) - t) <= math.max(win, smW.get(i))
                label  lb = smL.get(i)
                string tx = label.get_text(lb)
                if not str.contains(tx, tx0)
                    label.set_text(lb, tx0 + " · " + tx)
                merged := true
                break
    if not merged
        label lb = label.new(t, p, tx0, xloc=xloc.bar_time, style=up ? label.style_label_up : label.style_label_down, color=cNone, textcolor=colSw, size=txtSz)
        smL.push(lb)
        smP.push(p)
        smT.push(t)
        smW.push(win)
        if smL.size() > 20
            label.delete(smL.shift())
            smP.shift()
            smT.shift()
            smW.shift()

// วาด Sweep ของ TF ใหญ่บนกราฟเล็ก: เส้นประจาก swing → แท่งที่ไส้ทะลุ (ชี้แท่งกราฟเล็กที่ทำ High/Low จริง)
f_hswDraw(string tf, float sH, int sHT, float wH, float sL, int sLT, float wL, int bt) =>
    if timeframe.in_seconds(tf) > chSec
        string nm = f_tfTxt(tf)
        int    ms = timeframe.in_seconds(tf) * 1000
        if not na(sH) and not na(sHT)
            int a = f_exactT(sHT, ms, false, sH)
            int b = f_exactT(bt, ms, false, wH)
            f_keepL(line.new(a, sH, b, sH, xloc=xloc.bar_time, color=colSw, width=lw, style=line.style_dashed))
            f_hswMark(b, wH, nm, false, ms)
        if not na(sL) and not na(sLT)
            int a = f_exactT(sLT, ms, true, sL)
            int b = f_exactT(bt, ms, true, wL)
            f_keepL(line.new(a, sL, b, sL, xloc=xloc.bar_time, color=colSw, width=lw, style=line.style_dashed))
            f_hswMark(b, wL, nm, true, ms)

// SMT ของ TF ใหญ่: ทอง LL + เงิน HL = Bullish · ทอง HH + เงิน LH = Bearish → วาดเส้นบนกราฟเล็ก
f_smtTF(SmtTF s, bool on, string tf, bool nw, float gl, float gh, int gt, float xl, float xh) =>
    if on and nw and timeframe.in_seconds(tf) > chSec
        string nm = f_tfTxt(tf)
        int    ms = timeframe.in_seconds(tf) * 1000
        if not na(gl) and not na(xl)
            int tL = f_exactT(gt, ms, true, gl)
            if not na(s.gl) and not na(s.xl) and gl < s.gl and xl > s.xl
                s.ub := bar_index
                if showSMT
                    f_smtMark(s.glt, s.gl, tL, gl, nm, true, ms, true)
            s.gl  := gl
            s.glt := tL
            s.xl  := xl
            s.rgl := na
            s.rxl := na
        if not na(gh) and not na(xh)
            int tH = f_exactT(gt, ms, false, gh)
            if not na(s.gh) and not na(s.xh) and gh > s.gh and xh < s.xh
                s.db := bar_index
                if showSMT
                    f_smtMark(s.ght, s.gh, tH, gh, nm, false, ms, true)
            s.gh  := gh
            s.ght := tH
            s.xh  := xh
            s.rgh := na
            s.rxh := na

// SMT ของ TF ใหญ่ยังสด (เกิดไม่เกิน smtLive แท่งของ TF นั้น) · คืน 1 / -1 / 0 (ล่าสุดชนะ)
f_smtAct(SmtTF s, bool on, string tf) =>
    int  w  = math.round(smtLive * timeframe.in_seconds(tf) / math.max(chSec, 1))
    bool ok = on and useSMT and timeframe.in_seconds(tf) > chSec
    bool u  = ok and bar_index - s.ub <= w
    bool d  = ok and bar_index - s.db <= w
    u and d ? (s.ub >= s.db ? 1 : -1) : u ? 1 : d ? -1 : 0

// SMT เรียลไทม์: ทองทะลุ swing ล่าสุดที่ยืนยันแล้ว แต่เงินยังไม่ทะลุ swing เดียวกัน
// เก็บ Low/High ต่ำสุด/สูงสุดตั้งแต่ swing ยืนยัน (คำนวณใหม่ทุก tick) · วาดเส้นจาง อัปเดตตามราคา · เงินทะลุตาม = ลบเส้น
f_smtLive(SmtTF s, bool ok, float rL, int rLT, float rXL, float rH, int rHT, float rXH, bool htf) =>
    bool u = false
    bool d = false
    if ok
        if na(s.rgl) or low < s.rgl
            s.rgl  := low
            s.rglt := time
        if not na(xLo)
            s.rxl := na(s.rxl) ? xLo : math.min(s.rxl, xLo)
        if na(s.rgh) or high > s.rgh
            s.rgh  := high
            s.rght := time
        if not na(xHi)
            s.rxh := na(s.rxh) ? xHi : math.max(s.rxh, xHi)
        u := not na(rL) and not na(rXL) and not na(s.rxl) and s.rgl < rL and s.rxl > rXL
        d := not na(rH) and not na(rXH) and not na(s.rxh) and s.rgh > rH and s.rxh < rXH
    color c = color.new(colSMT, 50)
    if u and smtRT and showSMT
        if na(s.lu)
            s.lu := line.new(rLT, rL, s.rglt, s.rgl, xloc=xloc.bar_time, color=c, width=lw, style=htf ? line.style_dashed : line.style_dotted)
        else
            line.set_xy1(s.lu, rLT, rL)
            line.set_xy2(s.lu, s.rglt, s.rgl)
    else if not na(s.lu)
        line.delete(s.lu)
        s.lu := na
    if d and smtRT and showSMT
        if na(s.ld)
            s.ld := line.new(rHT, rH, s.rght, s.rgh, xloc=xloc.bar_time, color=c, width=lw, style=htf ? line.style_dashed : line.style_dotted)
        else
            line.set_xy1(s.ld, rHT, rH)
            line.set_xy2(s.ld, s.rght, s.rgh)
    else if not na(s.ld)
        line.delete(s.ld)
        s.ld := na
    [u, d]

// SMT เรียลไทม์ ณ ตอนนี้ของ TF ใหญ่ (ใช้นับแต้มตอน Sweep) · 1 / -1 / 0
f_smtNow(SmtTF s, bool on, string tf) =>
    int r = 0
    if on and useSMT and smtRT and timeframe.in_seconds(tf) > chSec
        float gl = na(s.rgl) ? low : math.min(s.rgl, low)
        float gh = na(s.rgh) ? high : math.max(s.rgh, high)
        float xl = na(s.rxl) ? xLo : math.min(s.rxl, xLo)
        float xh = na(s.rxh) ? xHi : math.max(s.rxh, xHi)
        r := not na(s.gl) and not na(s.xl) and not na(xl) and gl < s.gl and xl > s.xl ? 1 : not na(s.gh) and not na(s.xh) and not na(xh) and gh > s.gh and xh < s.xh ? -1 : 0
    r

// เลือกจุดที่ไกลสุด (Low ต่ำสุด / High สูงสุด) ของ TF ที่มี SMT เรียลไทม์ → ไว้วางป้ายเดียว
f_pk(bool on, float p, int t, float bp, int bt, bool lo) =>
    bool tk = on and not na(p) and (na(bp) or (lo ? p < bp : p > bp))
    [tk ? p : bp, tk ? t : bt]

// ───────── State ─────────
var int story1 = 0
var int story2 = 0
var int start1 = 0
var int start2 = 0

var float hiP = na
var int   hiT = na
var int   hiB = na
var float loP = na
var int   loT = na
var int   loB = na
var float bqLvl = na
var int   bqT   = na
var float bqBrk = na
var float bqInv = na
var float uqLvl = na
var int   uqT   = na
var float uqBrk = na
var float uqInv = na

// liquidity swings (ไส้)
var array<float> sLP = array.new<float>()
var array<int>   sLB = array.new<int>()
var array<int>   sLT = array.new<int>()
var array<bool>  sLE = array.new<bool>()
var array<bool>  sHE = array.new<bool>()
var array<float> sLX = array.new<float>()
var array<float> sHX = array.new<float>()
var array<float> sHP = array.new<float>()
var array<int>   sHB = array.new<int>()
var array<int>   sHT = array.new<int>()

// ════════════════════════════════════════════════════════════════
// ███ MODULE OB PRO: Supply & Demand / Orderblocks (TF ชาร์ต + H1 + H4) ███
// · คัดคุณภาพ: กวาดแท่งก่อนหน้า · ถูกแท่งถัดไปกลืน · Displacement · ความสูงโซนไม่เกิน x ATR
// · ใช้ใน Engine: Entry ทับ OB = +1 Score · OB TF ใหญ่เป็น POI ได้ (รอ Sweep → MSS เหมือนเลเวล MSNR)
// · วางก่อน Engine เพื่อให้ Engine เห็นโซน OB ของแท่งนั้น · ชื่อตัวแปรขึ้นต้น ob*
// ════════════════════════════════════════════════════════════════
string OBG1 = "OB · การวาด & ป้าย"
bool   obOn       = input.bool(true, "เปิดโซน OB (Supply / Demand)", group=OBG1)
string obCreate   = input.string("Wick to Wick", "Imbalance (การเกิดโซน)", options=["Wick to Wick", "Wick to Open"], group=OBG1, display=display.none, tooltip="Wick to Wick = ไส้แท่ง 3 ต้องไม่แตะไส้แท่ง OB (FVG เต็ม)\nWick to Open = ใช้ตัวเนื้อแท่ง 3 เทียบกับไส้แท่ง OB (หลวมกว่า)")
string obDraw     = input.string("Wick", "วาดโซนจาก", options=["Wick", "Open"], group=OBG1, display=display.none, tooltip="Wick = ขอบโซนจากไส้แท่ง OB\nOpen = ขอบโซนจากตัวเนื้อแท่ง OB (โซนแคบกว่า)")
bool   obShowLbl  = input.bool(true, "แสดงป้ายในโซน (เช่น H4 Demand OB)", group=OBG1)
bool   obShowSt   = input.bool(false, "แสดงสถานะ Fresh / Mitigated ในป้าย", group=OBG1)
int    obExt      = input.int(15, "ยื่นโซนไปทางขวา (แท่ง)", minval=0, maxval=200, group=OBG1, display=display.none)
bool   obShowMid  = input.bool(false, "เส้น 50%", group=OBG1, inline="obmid", tooltip="ค่าเริ่ม = ปิด เพื่อไม่ให้เส้นเต็มเพดาน 500 เส้น (TradingView จะลบเส้นเก่าสุดของสคริปต์ทิ้งเอง เช่น เส้น MSNR / SMT)")
color  obMidCol   = input.color(color.new(color.gray, 20), "", group=OBG1, inline="obmid")
string obMidStIn  = input.string("Dashed", "สไตล์", options=["Solid", "Dashed", "Dotted"], group=OBG1, inline="obmid", display=display.none)
bool   obMidDel   = input.bool(true, "ลบเส้น 50% เมื่อราคาแตะ", group=OBG1)

string OBG0 = "OB · คัดคุณภาพ"
bool   obReqOpp   = input.bool(false, "แท่ง OB ต้องเป็นสีตรงข้าม (แบบ JP7FX)", group=OBG0, tooltip="เปิด = Demand OB ต้องเป็นแท่งแดง / Supply OB ต้องเป็นแท่งเขียว\nปิด = แท่ง OB เป็นสีอะไรก็ได้")
bool   obPrevOn   = input.bool(true, "แท่งก่อนหน้าห้ามทำไส้เกินแท่ง OB", group=OBG0, inline="obp", tooltip="Demand: แท่งก่อนหน้าห้ามมีไส้ต่ำกว่า Low ของแท่ง OB\nSupply: แท่งก่อนหน้าห้ามมีไส้สูงกว่า High ของแท่ง OB")
int    obPrevN    = input.int(2, "แท่ง", minval=1, maxval=10, group=OBG0, inline="obp", display=display.none)
bool   obSweep    = input.bool(true, "แท่ง OB ต้องกวาดไส้แท่งก่อนหน้า", group=OBG0, tooltip="Demand: Low แท่ง OB < Low แท่งก่อนหน้า · Supply: High แท่ง OB > High แท่งก่อนหน้า")
bool   obEngulf   = input.bool(true, "แท่งถัดไปต้องปิดกลืนแท่ง OB", group=OBG0, tooltip="Demand: แท่ง 2 ปิดเหนือ High แท่ง OB · Supply: แท่ง 2 ปิดใต้ Low แท่ง OB")
float  obDispA    = input.float(0.0, "Displacement: เนื้อแท่ง 2 ≥ (x ATR) · 0 = ปิด", minval=0.0, step=0.1, group=OBG0, display=display.none)
float  obMaxHA    = input.float(3.0, "ความสูงโซนไม่เกิน (x ATR) · 0 = ปิด", minval=0.0, step=0.5, group=OBG0, display=display.none, tooltip="ตัดโซนที่สูงเกิน (SL จะกว้างเกินไป) · ATR ของ TF นั้น")
string obRemove   = input.string("Wick fully through", "ลบโซนเมื่อ", options=["Wick fully through", "Close beyond"], group=OBG0, display=display.none, tooltip="Wick = ไส้ทะลุทั้งโซน\nClose = แท่งปิดเลยขอบโซน")
string obFilter   = input.string("All Active", "แสดงโซน", options=["All Active", "Fresh Only"], group=OBG0, display=display.none)

string OBG2 = "OB · Timeframe & ใช้ใน Setup"
bool   obUseC     = input.bool(true, "โซน TF ชาร์ต", group=OBG2, inline="obc")
int    obMaxC     = input.int(5, "สูงสุด/ฝั่ง", minval=1, maxval=30, group=OBG2, inline="obc", display=display.none)
bool   obUseA     = input.bool(true, "โซน TF ใหญ่ 1", group=OBG2, inline="oba1")
string obTfA      = input.timeframe("60", "", group=OBG2, inline="oba1", display=display.none)
bool   obUseB     = input.bool(true, "โซน TF ใหญ่ 2", group=OBG2, inline="obb1")
string obTfB      = input.timeframe("240", "", group=OBG2, inline="obb1", display=display.none)
int    obMaxH     = input.int(4, "TF ใหญ่: สูงสุด/ฝั่ง/TF", minval=1, maxval=30, group=OBG2, display=display.none)
bool   obScore    = input.bool(true, "Score +1 เมื่อ Entry ทับโซน OB", group=OBG2, tooltip="โซน OB ที่ยังไม่ถูกลบ (Fresh หรือ Mitigated) ทิศเดียวกับไม้ · Dashboard บอก TF ของ OB ที่ทับ")
string obPoi      = input.string("OB TF ใหญ่", "OB เป็น POI (เปิดโซนรอ Sweep)", options=["ปิด", "OB TF ใหญ่", "ทุก OB"], group=OBG2, display=display.none, tooltip="ราคาแตะโซน OB → เปิดโซนรอ Sweep → MSS เหมือนแตะเลเวล MSNR HTF (ใช้ Storyline เหมือนกัน)")
color  obCSupF    = input.color(color.new(color.red, 88),    "TF ชาร์ต Supply Fresh / Mitigated", group=OBG2, inline="obcs")
color  obCSupM    = input.color(color.new(color.gray, 88),   "", group=OBG2, inline="obcs")
color  obCDemF    = input.color(color.new(color.green, 88),  "TF ชาร์ต Demand Fresh / Mitigated", group=OBG2, inline="obcd")
color  obCDemM    = input.color(color.new(color.gray, 88),   "", group=OBG2, inline="obcd")
color  obHSupF    = input.color(color.new(color.purple, 80), "TF ใหญ่ Supply Fresh / Mitigated", group=OBG2, inline="obhs")
color  obHSupM    = input.color(color.new(color.gray, 85),   "", group=OBG2, inline="obhs")
color  obHDemF    = input.color(color.new(color.teal, 80),   "TF ใหญ่ Demand Fresh / Mitigated", group=OBG2, inline="obhd")
color  obHDemM    = input.color(color.new(color.gray, 85),   "", group=OBG2, inline="obhd")
bool   obBars     = input.bool(true, "ระบายสีแท่ง OB (หลังแท่ง 3 ปิดยืนยัน)", group=OBG2)
color  obBarSup   = input.color(color.red,   "แท่ง Supply / Demand", group=OBG2, inline="obb")
color  obBarDem   = input.color(color.green, "", group=OBG2, inline="obb")
bool   obAlNew    = input.bool(true, "Alert: OB ใหม่", group=OBG2, inline="obal")
bool   obAlMit    = input.bool(true, "Alert: OB ถูกแตะ", group=OBG2, inline="obal")

obMidSt = switch obMidStIn
    "Solid"  => line.style_solid
    "Dotted" => line.style_dotted
    => line.style_dashed

// แท่ง OB = [o+2], แท่ง 2 = [o+1], แท่ง 3 = [o] (แท่งยืนยัน) · แท่งก่อนหน้า OB = [o+3] … [o+2+obPrevN]
ob_detect(int o) =>
    float a    = ta.atr(14)
    bool  wickMode = obCreate == "Wick to Wick"
    float bTop = math.max(open[o + 2], close[o + 2])
    float bBot = math.min(open[o + 2], close[o + 2])
    bool  pSup = true
    bool  pDem = true
    if obPrevOn
        for k = 1 to obPrevN
            if high[o + 2 + k] > high[o + 2]
                pSup := false
            if low[o + 2 + k] < low[o + 2]
                pDem := false
    bool  dispOk = obDispA <= 0 or math.abs(close[o + 1] - open[o + 1]) >= obDispA * a[o + 1]
    // ---- Supply
    bool  c1S  = obReqOpp ? close[o + 2] > open[o + 2] : true
    float c3T  = wickMode ? high[o] : math.max(open[o], close[o])
    float sTop = math.max(high[o + 2], high[o + 1])
    float sBot = obDraw == "Wick" ? low[o + 2] : bBot
    bool  qS   = (not obSweep or high[o + 2] > high[o + 3]) and (not obEngulf or close[o + 1] < low[o + 2]) and (obMaxHA <= 0 or sTop - sBot <= obMaxHA * a[o + 1])
    bool  sup  = c1S and close[o + 1] < open[o + 1] and c3T < low[o + 2] and pSup and dispOk and qS
    // ---- Demand
    bool  c1D  = obReqOpp ? close[o + 2] < open[o + 2] : true
    float c3B  = wickMode ? low[o] : math.min(open[o], close[o])
    float dBot = math.min(low[o + 2], low[o + 1])
    float dTop = obDraw == "Wick" ? high[o + 2] : bTop
    bool  qD   = (not obSweep or low[o + 2] < low[o + 3]) and (not obEngulf or close[o + 1] > high[o + 2]) and (obMaxHA <= 0 or dTop - dBot <= obMaxHA * a[o + 1])
    bool  dem  = c1D and close[o + 1] > open[o + 1] and c3B > high[o + 2] and pDem and dispOk and qD
    [sup, sTop, sBot, dem, dTop, dBot, time[o + 2]]

[obcS, obcSTop, obcSBot, obcD, obcDTop, obcDBot, obcT1] = ob_detect(0)
[obaS, obaSTop, obaSBot, obaD, obaDTop, obaDBot, obaT1] = request.security(syminfo.tickerid, obTfA, ob_detect(1), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)
[obbS, obbSTop, obbSBot, obbD, obbDTop, obbDBot, obbT1] = request.security(syminfo.tickerid, obTfB, ob_detect(1), lookahead=barmerge.lookahead_on, calc_bars_count=htfN)

bool   obAOk  = obOn and obUseA and timeframe.in_seconds(obTfA) > timeframe.in_seconds(timeframe.period)
bool   obBOk  = obOn and obUseB and timeframe.in_seconds(obTfB) > timeframe.in_seconds(timeframe.period) and obTfB != obTfA
bool   obANew = timeframe.change(obTfA)
bool   obBNew = timeframe.change(obTfB)
int    obExtMs = int(timeframe.in_seconds(timeframe.period) * 1000 * obExt)
string obCTxt  = f_tfTxt(timeframe.period)
string obATxt  = f_tfTxt(obTfA)
string obBTxt  = f_tfTxt(obTfB)

type ObZone
    box    bx
    line   mid
    bool   isSup
    int    src        // 0 = TF ชาร์ต · 1 = TF ใหญ่ 1 · 2 = TF ใหญ่ 2
    bool   mitigated
    float  top
    float  bot
    int    createdBar
    int    touchBar   // แท่งที่ราคาแตะครั้งแรก (ใช้เปิด POI)
    string tfTxt

var array<ObZone> obZones = array.new<ObZone>()

ob_color(ObZone z) =>
    z.isSup ? (z.src > 0 ? (z.mitigated ? obHSupM : obHSupF) : (z.mitigated ? obCSupM : obCSupF)) : (z.src > 0 ? (z.mitigated ? obHDemM : obHDemF) : (z.mitigated ? obCDemM : obCDemF))

ob_text(ObZone z) =>
    string t = obShowLbl ? z.tfTxt + (z.isSup ? " Supply OB" : " Demand OB") : ""
    if obShowSt
        t := t + (z.mitigated ? " · Mitigated" : " · Fresh")
    t

method obKill(ObZone z) =>
    z.bx.delete()
    if not na(z.mid)
        z.mid.delete()

ob_trim(bool isSup, int src, int maxN) =>
    int n = 0
    for z in obZones
        if z.isSup == isSup and z.src == src
            n += 1
    if n > maxN
        for i = 0 to obZones.size() - 1
            ObZone z = obZones.get(i)
            if z.isSup == isSup and z.src == src
                z.obKill()
                obZones.remove(i)
                break

ob_create(bool isSup, int src, float top, float bot, int t1, string tfTxt) =>
    ObZone z = ObZone.new(na, na, isSup, src, false, top, bot, bar_index, na, tfTxt)
    z.bx := box.new(left=t1, top=top, right=time + obExtMs, bottom=bot, xloc=xloc.bar_time, border_color=color(na), border_width=0, bgcolor=ob_color(z), text=ob_text(z), text_color=isSup ? colR : colS, text_size=txtSz, text_halign=text.align_right, text_valign=text.align_top)
    if obShowMid
        float m = (top + bot) / 2
        z.mid := line.new(t1, m, time + obExtMs, m, xloc=xloc.bar_time, color=obMidCol, style=obMidSt, width=1)
    obZones.push(z)
    ob_trim(isSup, src, src == 0 ? obMaxC : obMaxH)
    if obAlNew and barstate.isrealtime
        alert("MSNR×SMC OB: New " + tfTxt + (isSup ? " Supply OB " : " Demand OB ") + str.tostring(bot, format.mintick) + " - " + str.tostring(top, format.mintick) + " | " + syminfo.ticker, alert.freq_once_per_bar)

method obMitigate(ObZone z) =>
    z.touchBar := bar_index
    if obFilter == "Fresh Only"
        z.bx.set_bgcolor(color(na))
        z.bx.set_text("")
        if not na(z.mid)
            z.mid.delete()
            z.mid := na
    else
        z.bx.set_bgcolor(ob_color(z))
        z.bx.set_text(ob_text(z))
    if obAlMit and barstate.isrealtime
        alert("MSNR×SMC OB: " + z.tfTxt + (z.isSup ? " Supply OB" : " Demand OB") + " mitigated @ " + str.tostring(close, format.mintick) + " | " + syminfo.ticker, alert.freq_once_per_bar)

// Entry ทับโซน OB ทิศเดียวกัน (Buy = Demand · Sell = Supply) → คืนชื่อ TF ของ OB (TF ใหญ่ก่อน) · "" = ไม่ทับ
ob_hit(int d, float e) =>
    string r = ""
    int    best = -1
    if not na(e)
        for z in obZones
            if z.isSup == (d == -1) and e <= z.top + tol and e >= z.bot - tol and z.src > best
                best := z.src
                r    := z.tfTxt
    r

// ───────── สร้างโซน (เฉพาะช่วงคำนวณ) ─────────
if obOn and inCalc
    if obUseC and barstate.isconfirmed
        if obcS
            ob_create(true, 0, obcSTop, obcSBot, obcT1, obCTxt)
        if obcD
            ob_create(false, 0, obcDTop, obcDBot, obcT1, obCTxt)
    if obAOk and obANew
        if obaS
            ob_create(true, 1, obaSTop, obaSBot, obaT1, obATxt)
        if obaD
            ob_create(false, 1, obaDTop, obaDBot, obaT1, obATxt)
    if obBOk and obBNew
        if obbS
            ob_create(true, 2, obbSTop, obbSBot, obbT1, obBTxt)
        if obbD
            ob_create(false, 2, obbDTop, obbDBot, obbT1, obBTxt)

// ───────── อัปเดต / Mitigated / ลบ ─────────
if obZones.size() > 0
    for i = obZones.size() - 1 to 0
        ObZone z = obZones.get(i)
        bool rm = false
        if bar_index > z.createdBar
            float m = (z.top + z.bot) / 2
            if z.isSup
                rm := obRemove == "Wick fully through" ? high > z.top : close > z.top
                if not rm and not z.mitigated and high >= z.bot
                    z.mitigated := true
                    z.obMitigate()
                if obMidDel and not na(z.mid) and high >= m
                    z.mid.delete()
                    z.mid := na
            else
                rm := obRemove == "Wick fully through" ? low < z.bot : close < z.bot
                if not rm and not z.mitigated and low <= z.top
                    z.mitigated := true
                    z.obMitigate()
                if obMidDel and not na(z.mid) and low <= m
                    z.mid.delete()
                    z.mid := na
        if rm
            z.obKill()
            obZones.remove(i)
        else
            z.bx.set_right(time + obExtMs)
            if not na(z.mid)
                z.mid.set_x2(time + obExtMs)

// ───────── สีแท่ง OB ─────────
bool obBarOk = obOn and obBars and obUseC and inCalc and barstate.isconfirmed
barcolor(obBarOk and obcS ? obBarSup : obBarOk and obcD ? obBarDem : na, offset=-2, title="OB candle")

// ════════════════════════════════════════════════════════════════
// ███ MODULE QT / AMDX: Quarterly Theory (Daye) จาก KA PRO DEV v9.10-9.12 ███
// วัน (เวลา New York · เริ่ม 18:00): Q1 A Asia 18-00 · Q2 M London 00-06 · Q3 D NY AM 06-12 · Q4 X NY PM 12-18 · แต่ละ Q แบ่ง 90 นาที × 4
// True Open 90m = open ต้น Q2 (90 นาที) ของเซสชัน · True Day Open = open 00:00 NY
// AMDX ตรง = Q1 ของเซสชันถูกกวาดฝั่งตรงข้าม (Manipulation) + Entry อยู่ฝั่งถูกของ True Open
// ════════════════════════════════════════════════════════════════
string QTG = "QT · Quarterly Theory (AMDX)"
string QT_OFF = "ปิด"
string QT_SC  = "ให้คะแนน (+1)"
string QT_REQ = "บังคับ (ต้องตรง AMDX)"
string qtMode  = input.string(QT_SC, "AMDX: Manipulation + True Open", options=[QT_OFF, QT_SC, QT_REQ], group=QTG, tooltip="Buy: กวาด Low Q1 + Entry ใต้ True Open · Sell: กวาด High Q1 + Entry เหนือ True Open\n(เซสชัน 90 นาที หรือ Q1 ของวัน + True Day Open)")
bool   qtNoA   = input.bool(true, "ไม่ตั้ง Limit ใหม่ช่วง Q1 ของวัน (Asia 18:00-00:00 NY = Accumulation)", group=QTG, tooltip="เวลาไทย ≈ 06:00-12:00 (ฤดูหนาว US) / 05:00-11:00 (ฤดูร้อน US)")
bool   qtLines = input.bool(true, "เส้น True Open 90m · True Day Open · High/Low Q1 เซสชัน", group=QTG)
bool   qtShow  = input.bool(true, "แถบ Quarter ใต้กราฟ (บน 90 นาที · ล่าง วัน)", group=QTG, tooltip="สี: Q1 เทา (A) · Q2 แดง (M) · Q3 เขียว (D) · Q4 ฟ้า (X) · กรอบเข้ม = ช่วงปัจจุบัน")
int    qtDays  = input.int(2, "แถบ Quarter: ย้อนหลัง (วัน)", minval=1, maxval=5, group=QTG, display=display.none)
bool   qtBg    = input.bool(false, "แรเงา Quarter ของวันบนกราฟ", group=QTG, display=display.none)

int qtMin = (hour(time, "America/New_York") * 60 + minute(time, "America/New_York") + 360) % 1440
int qtDQ  = math.floor(qtMin / 360)              // 0..3 = Q1 Asia · Q2 London · Q3 NY AM · Q4 NY PM
int qtMQ  = math.floor((qtMin % 360) / 90)       // 0..3 = 90 นาที ในเซสชัน

var float qsH  = na      // Q1 ของเซสชัน
var float qsL  = na
var int   qsHT = na
var int   qsLT = na
var float qsTO = na      // True Open 90 นาที
var int   qsTOT = na
var bool  qsMH = false   // Q1 High ถูกกวาด → หา SELL
var bool  qsML = false   // Q1 Low ถูกกวาด → หา BUY
var float qdH  = na      // Q1 ของวัน (Asia)
var float qdL  = na
var bool  qdMH = false
var bool  qdML = false
var float qdTO = na      // True Day Open (00:00 NY)
var int   qdTOT = na
if qtDQ != qtDQ[1]
    qsH  := high
    qsL  := low
    qsHT := time
    qsLT := time
    qsTO := na
    qsMH := false
    qsML := false
    if qtDQ == 0
        qdH  := high
        qdL  := low
        qdMH := false
        qdML := false
    if qtDQ == 1
        qdTO  := open
        qdTOT := time
else if qtMQ == 0
    if high > qsH
        qsH  := high
        qsHT := time
    if low < qsL
        qsL  := low
        qsLT := time
else
    if qtMQ == 1 and qtMQ[1] == 0
        qsTO  := open
        qsTOT := time
    if high > qsH
        qsMH := true
    if low < qsL
        qsML := true
if qtDQ == 0 and qtDQ[1] == 0
    qdH := math.max(qdH, high)
    qdL := math.min(qdL, low)
if qtDQ > 0 and not na(qdH)
    if high > qdH
        qdMH := true
    if low < qdL
        qdML := true

f_qtOk(int d, float e) =>
    bool sOk = d == 1 ? qsML and (na(qsTO) or e <= qsTO) : qsMH and (na(qsTO) or e >= qsTO)
    bool dOk = qtDQ > 0 and (d == 1 ? qdML and (na(qdTO) or e <= qdTO) : qdMH and (na(qdTO) or e >= qdTO))
    sOk or dOk

// ───────── Score เต็ม (Engine เดิม 8 + OB + AMDX) ─────────
int scMax = 8 + (obOn and obScore ? 1 : 0) + (qtMode == QT_SC ? 1 : 0)

bgcolor(qtBg ? (qtDQ == 0 ? color.new(color.gray, 94) : qtDQ == 1 ? color.new(colR, 95) : qtDQ == 2 ? color.new(colS, 95) : color.new(color.blue, 95)) : na, title="Quarter ของวัน")


// Setup state: 0 ว่าง · 1 อยู่ในโซน HTF รอ Sweep · 2 Sweep แล้วรอ MSS · 3 รอเช็ก FVG · 4 ตั้ง Limit · 5 อยู่ในไม้
var int    ss    = 0
var int    dir   = 0
var float  zP    = na
var string zTxt  = ""
var int    zBar  = 0
var float  swWk  = na
var int    swBar = 0
var float  mLvl  = na
var int    mT    = na
var float  mBody = na
var float  enP   = na
var float  slP   = na
var float  tpP   = na
var float  rrV   = na
var float  tp1P  = na
var bool   tp1H  = false
var float  slNow = na
var float  rlz   = 0.0
var float  lotV  = na
var line   t1L   = na
var label  t1B   = na
var string enTxt = ""
var int    stBar = 0
var line   msL   = na
var line   eL    = na
var line   sL    = na
var line   tL    = na
var label  eB    = na
var label  sB    = na
var label  tB    = na

var bool   swKey = false
var string swTag = ""
var bool   kzHit = false
var bool   smtHit = false
var float  mDisp = na
var int    tSc   = 0
var string ckTxt = ""
var string skip  = ""

var int   nW   = 0
var int   nL   = 0
var int   nT   = 0
var float sumR = 0.0
var int   aW   = 0
var int   aL2  = 0
var float aR   = 0.0

int sigMss  = 0
int sigFill = 0

// ───────── Engine ─────────
if barstate.isconfirmed and inCalc
    // ── SMT หลายทามเฟรม
    if useSMT
        f_smtTF(st1, smtU1, smtTf1, sn1, g1L, g1H, g1T, x1L, x1H)
        f_smtTF(st2, smtU2, smtTf2, sn2, g2L, g2H, g2T, x2L, x2H)
        f_smtTF(st3, smtU3, smtTf3, sn3, g3L, g3H, g3T, x3L, x3H)
        f_smtTF(st4, smtU4, smtTf4, sn4, g4L, g4H, g4T, x4L, x4H)
    // ── Sweep ของ TF ใหญ่ (M15 / M30 / H1 / H4) → เส้นบนกราฟเล็ก
    if showHSw and hsU1 and hn1
        f_hswDraw(hsTf1, w1H, w1HT, w1WH, w1L, w1LT, w1WL, w1T)
    if showHSw and hsU2 and hn2
        f_hswDraw(hsTf2, w2H, w2HT, w2WH, w2L, w2LT, w2WL, w2T)
    if showHSw and hsU3 and hn3
        f_hswDraw(hsTf3, w3H, w3HT, w3WH, w3L, w3LT, w3WL, w3T)
    if showHSw and hsU4 and hn4
        f_hswDraw(hsTf4, w4H, w4HT, w4WH, w4L, w4LT, w4WL, w4T)
    // ── HTF levels
    if nb2
        int s2 = f_htfClose(2, h2C, start2)
        story2 := s2 != 0 ? s2 : story2
        start2 := bar_index
        if not na(h2H)
            f_add(lvH, h2H, h2T, -1, "A", 2, tf2T, 40)
        if not na(h2L)
            f_add(lvH, h2L, h2T, 1, "V", 2, tf2T, 40)
        if useGapH and not na(h2G) and h2D != 0
            f_add(lvH, h2G, h2GT, h2D, "OCL", 2, tf2T, 40)
    if nb1
        int s1 = f_htfClose(1, h1C, start1)
        story1 := s1 != 0 ? s1 : story1
        start1 := bar_index
        if not na(h1H)
            f_add(lvH, h1H, h1T, -1, "A", 1, tf1T, 40)
        if not na(h1L)
            f_add(lvH, h1L, h1T, 1, "V", 1, tf1T, 40)
        if useGapH and not na(h1G) and h1D != 0
            f_add(lvH, h1G, h1GT, h1D, "OCL", 1, tf1T, 40)

    // ── LTF MSNR levels
    if not na(ph)
        if not na(hiP) and not na(loP) and loB > hiB and ph > hiP
            bqLvl := hiP
            bqT   := hiT
            bqBrk := loP
            bqInv := ph
        hiP := ph
        hiT := time[pvR]
        hiB := bar_index - pvR
        if useAV
            f_add(lvL, ph, hiT, -1, "A", 0, "", 60)
    if not na(pl)
        if not na(loP) and not na(hiP) and hiB > loB and pl < loP
            uqLvl := loP
            uqT   := loT
            uqBrk := hiP
            uqInv := pl
        loP := pl
        loT := time[pvR]
        loB := bar_index - pvR
        if useAV
            f_add(lvL, pl, loT, 1, "V", 0, "", 60)
    if not na(bqLvl)
        if close > bqInv
            bqLvl := na
        else if close < bqBrk
            if useQM
                f_add(lvL, bqLvl, bqT, -1, "QM", 0, "", 60)
            bqLvl := na
    if not na(uqLvl)
        if close < uqInv
            uqLvl := na
        else if close > uqBrk
            if useQM
                f_add(lvL, uqLvl, uqT, 1, "QM", 0, "", 60)
            uqLvl := na
    if useOCL and bearOCL
        f_add(lvL, close[1], time[1], -1, "OCL", 0, "", 60)
    if useOCL and bullOCL
        f_add(lvL, close[1], time[1], 1, "OCL", 0, "", 60)

    int nL0 = lvL.size()
    if nL0 > 0
        for i = nL0 - 1 to 0
            Lvl l = lvL.get(i)
            if bar_index > l.born
                int r = f_break(l, close)
                if r == 2
                    l.ln.delete()
                    l.lb.delete()
                    lvL.remove(i)
                else if r == 0
                    f_touch(l)

    int sty = story2 != 0 ? story2 : story1

    // ── จัดการไม้ / Limit
    if ss == 5 and bar_index > stBar
        float res   = na
        bool  tout  = false
        float risk  = math.abs(enP - slP)
        float pt    = mgMode == "SL / TP ตายตัว" or na(tp1P) ? 0.0 : partPct / 100
        bool  slHit = dir == 1 ? low <= slNow : high >= slNow
        if slHit
            res := rlz + (1 - (tp1H ? pt : 0.0)) * dir * (slNow - enP) / risk
        else
            if not tp1H and pt > 0 and (dir == 1 ? high >= tp1P : low <= tp1P)
                tp1H  := true
                rlz   := pt * math.abs(tp1P - enP) / risk
                slNow := enP + dir * bePts * ptSize
            if dir == 1 ? high >= tpP : low <= tpP
                res := rlz + (1 - (tp1H ? pt : 0.0)) * math.abs(tpP - enP) / risk
        if na(res) and bar_index - stBar >= maxHold
            res  := rlz + (1 - (tp1H ? pt : 0.0)) * dir * (close - enP) / risk
            tout := true
        if not na(res)
            if tout
                nT += 1
            else if res > 0
                nW += 1
            else
                nL += 1
            sumR += res
            if tSc >= scMax - 2 and not tout
                aW  += res > 0 ? 1 : 0
                aL2 += res > 0 ? 0 : 1
                aR  += res
            ss := 0
    if ss == 4 and bar_index > stBar
        bool filled = dir == 1 ? low <= enP : high >= enP
        bool missed = dir == 1 ? high >= tpP : low <= tpP
        if filled
            ss      := 5
            stBar   := bar_index
            sigFill := dir
            if (dir == 1 and low <= slP) or (dir == -1 and high >= slP)
                nL   += 1
                sumR -= 1.0
                if tSc >= scMax - 2
                    aL2 += 1
                    aR  -= 1.0
                ss   := 0
        else if missed or (fillBars > 0 and bar_index - stBar > fillBars)
            line.delete(eL)
            line.delete(sL)
            line.delete(tL)
            label.delete(eB)
            label.delete(sB)
            label.delete(tB)
            line.delete(t1L)
            label.delete(t1B)
            ss := 0

    // ── รอ MSS / เช็ก FVG
    bool zoneAlive = bar_index - zBar <= zoneBar
    if ss == 3
        bool fvgOk = dir == 1 ? low > high[2] : high < low[2]
        if fvgOk
            ss := 31
        else
            line.delete(msL)
            ss := zoneAlive ? 1 : 0
    if ss == 2 and bar_index > swBar
        if (dir == 1 and low < swWk) or (dir == -1 and high > swWk)
            line.delete(msL)
            ss := zoneAlive ? 1 : 0
        else if (dir == 1 and close > mLvl) or (dir == -1 and close < mLvl)
            bool dispOk = not reqDisp or math.abs(close - open) >= dispAtr * atr
            if dispOk
                mDisp := math.abs(close - open)
                kzHit := kzHit or inKz
                ss := reqFvg ? 3 : 31
            else
                line.delete(msL)
                ss := zoneAlive ? 1 : 0
        else if bar_index - swBar > mssWin
            line.delete(msL)
            ss := zoneAlive ? 1 : 0
        else
            line.set_x2(msL, time)

    // ── MSS ยืนยัน → ตั้ง Limit ที่เลเวล MSNR
    if ss == 31
        int mx = reqFvg ? time[1] : time
        if showSM
            line.set_x2(msL, mx)
            line.set_style(msL, line.style_solid)
            line.set_color(msL, dir == 1 ? colS : colR)
            f_keepL(msL)
            f_keepB(label.new(mx, mLvl, "MSS", xloc=xloc.bar_time, style=label.style_label_lower_right, color=cNone, textcolor=dir == 1 ? colS : colR, size=txtSz))
        msL := na
        // ขาของ MSS: ไส้ sweep → จุดสุดหลัง sweep · 50% = เส้นแบ่ง Premium / Discount
        float legX = swWk
        for j = 0 to math.min(bar_index - swBar, 300)
            legX := dir == 1 ? math.max(legX, high[j]) : math.min(legX, low[j])
        float eq = (swWk + legX) / 2
        [ep, et, ov] = f_entry(dir, swWk, mBody, zP, eq)
        bool  inPD  = not na(ep) and (dir == 1 ? ep <= eq : ep >= eq)
        bool  dOk   = mDisp >= dispAtr * atr
        bool  fOk   = reqFvg or (dir == 1 ? low > high[2] : high < low[2])
        // PO3: Buy ใต้ Open ของแท่ง TF A (H4) ปัจจุบัน / Sell เหนือ Open
        float oA    = cAO.size() > 0 ? cAO.get(cAO.size() - 1) : na
        bool  po3   = not na(ep) and not na(oA) and (dir == 1 ? ep < oA : ep > oA)
        int   sc    = (swKey ? 1 : 0) + (dOk ? 1 : 0) + (fOk ? 1 : 0) + (ov ? 1 : 0) + (inPD ? 1 : 0) + (kzHit ? 1 : 0) + (smtHit ? 1 : 0) + (po3 ? 1 : 0)
        // PRO: OB ทับ Entry · AMDX
        string obTf  = obOn and obScore ? ob_hit(dir, ep) : ""
        bool   obOk  = obTf != ""
        bool   amdx  = qtMode != QT_OFF and not na(ep) and f_qtOk(dir, ep)
        sc += (obOk ? 1 : 0) + (qtMode == QT_SC and amdx ? 1 : 0)
        string qtWhy = qtNoA and qtDQ == 0 ? "AMDX: Q1 Asia (สะสม)" : qtMode == QT_REQ and not amdx ? "AMDX: ยังไม่กวาด Q1 / ผิดฝั่ง True Open" : ""
        ckTxt := (swKey ? "✓" : "✗") + "Key " + (dOk ? "✓" : "✗") + "Disp " + (fOk ? "✓" : "✗") + "FVG " + (ov ? "✓" : "✗") + "HTF " + (inPD ? "✓" : "✗") + "PD " + (kzHit ? "✓" : "✗") + "KZ " + (smtHit ? "✓" : "✗") + "SMT " + (po3 ? "✓" : "✗") + "PO3" + (obOn and obScore ? " " + (obOk ? "✓OB " + obTf : "✗OB") : "") + (qtMode != QT_OFF ? " " + (amdx ? "✓" : "✗") + "AMDX" : "")
        tSc := sc
        if na(ep) or sc < minScore or qtWhy != ""
            skip := (dir == 1 ? "▲ " : "▼ ") + "ข้าม · Score " + str.tostring(sc) + "/" + str.tostring(scMax) + (na(ep) ? " · ไม่มีเลเวลใน Discount/Premium" : "") + (qtWhy != "" ? " · " + qtWhy : "")
            ss   := 0
        else
            skip  := ""
            enP   := ep
            enTxt := et
            ss    := 41
    if ss == 41
        float ep   = enP
        string et  = enTxt
        sigMss := dir
        float sl   = dir == 1 ? swWk - slA * atr : swWk + slA * atr
        if slCap > 0 and math.abs(ep - sl) > slCap * ptSize
            sl := ep - dir * slCap * ptSize
        float risk = math.max(math.abs(ep - sl), syminfo.mintick)
        float tp   = f_target(dir, risk * minRR, ep)
        if na(tp)
            tp := ep + dir * risk * fbR
        // TP1: Roadblock = เลเวล MSNR ฝั่งตรงข้ามตัวแรกระหว่าง Entry กับ TP2 · ไม่มี = 1R
        float t1 = na
        if tp1Mode == "Roadblock"
            for m in lvL
                if m.fresh and m.kind == -dir and math.abs(m.price - ep) >= 0.5 * risk
                    if dir == 1 and m.price > ep and m.price < tp and (na(t1) or m.price < t1)
                        t1 := m.price
                    if dir == -1 and m.price < ep and m.price > tp and (na(t1) or m.price > t1)
                        t1 := m.price
        if na(t1)
            t1 := ep + dir * risk
        if (dir == 1 and t1 >= tp) or (dir == -1 and t1 <= tp)
            t1 := na
        enP   := ep
        slP   := sl
        tpP   := tp
        tp1P  := t1
        tp1H  := false
        slNow := sl
        rlz   := 0.0
        lotV  := math.floor(riskUsd / (risk * ctSz) * 100) / 100
        rrV   := math.abs(tp - ep) / risk
        enTxt := et + " · " + f_grade(tSc, scMax)
        ss    := 4
        stBar := bar_index
        line.delete(eL)
        line.delete(sL)
        line.delete(tL)
        label.delete(eB)
        label.delete(sB)
        label.delete(tB)
        line.delete(t1L)
        label.delete(t1B)
        int x2 = bar_index + offs
        color dc = dir == 1 ? colS : colR
        eL := line.new(bar_index, ep, x2, ep, color=dc, width=lw)
        sL := line.new(bar_index, sl, x2, sl, color=colR, width=lw, style=line.style_dotted)
        tL := line.new(bar_index, tp, x2, tp, color=colS, width=lw, style=line.style_dotted)
        eB := label.new(x2, ep, (dir == 1 ? "Buy Limit · " : "Sell Limit · ") + enTxt, style=label.style_label_lower_left, color=cNone, textcolor=dc, size=txtSz)
        sB := label.new(x2, sl, "SL", style=label.style_label_lower_left, color=cNone, textcolor=colR, size=txtSz)
        tB := label.new(x2, tp, (na(t1) or mgMode == "SL / TP ตายตัว" ? "TP 1:" : "TP2 1:") + str.tostring(rrV, "#.#"), style=label.style_label_lower_left, color=cNone, textcolor=colS, size=txtSz)
        if not na(t1) and mgMode != "SL / TP ตายตัว"
            t1L := line.new(bar_index, t1, x2, t1, color=color.new(colS, 50), width=lw, style=line.style_dotted)
            t1B := label.new(x2, t1, "TP1 " + str.tostring(partPct, "#") + "% · BE", style=label.style_label_lower_left, color=cNone, textcolor=color.new(colS, 30), size=txtSz)
        alert("MSNR×SMC " + (dir == 1 ? "▲ MSS → Buy Limit " : "▼ MSS → Sell Limit ") + str.tostring(ep, format.mintick) + " [" + enTxt + " · POI " + zTxt + " · " + ckTxt + "] | SL " + str.tostring(sl, format.mintick) + (na(t1) ? "" : " | TP1 " + str.tostring(t1, format.mintick)) + " | TP " + str.tostring(tp, format.mintick) + " | RR 1:" + str.tostring(rrV, "#.#") + " | Lot " + str.tostring(lotV, "#.##") + " (risk $" + str.tostring(riskUsd, "#.##") + ") | " + syminfo.ticker, alert.freq_once_per_bar_close)

    // ── โซนหมดอายุ / ราคาวิ่งทะลุโซน
    if ss == 1
        bool runThrough = dir == 1 ? close < zP - zoneSw * atr - tol : close > zP + zoneSw * atr + tol
        if not zoneAlive or runThrough
            ss := 0

    // ── แตะเลเวล HTF Fresh → เปิดโซนรอ Sweep
    int nH = lvH.size()
    if nH > 0
        for i = 0 to nH - 1
            Lvl l = lvH.get(i)
            if f_touch(l) and ss <= 1 and inSess and (not needStory or sty == l.kind)
                ss   := 1
                dir  := l.kind
                zP   := l.price
                zTxt := l.tf + " " + l.tag
                zBar := bar_index
                skip := ""
    // ── PRO: แตะโซน OB (TF ใหญ่ / ทุก OB) → เปิดโซนรอ Sweep · ขอบใกล้ราคา = zP
    if obOn and obPoi != "ปิด" and ss <= 1 and inSess and obZones.size() > 0
        for z in obZones
            int od = z.isSup ? -1 : 1
            if z.touchBar == bar_index and (obPoi == "ทุก OB" or z.src > 0) and (not needStory or sty == od)
                ss   := 1
                dir  := od
                zP   := z.isSup ? z.bot : z.top
                zTxt := z.tfTxt + " OB"
                zBar := bar_index
                skip := ""

    // ── Liquidity swings (ไส้) + Sweep
    float eqT = math.max(eqTol * atr, syminfo.mintick)
    if not na(sph)
        bool isEq = false
        if sHP.size() > 0
            for i = 0 to sHP.size() - 1
                if math.abs(sHP.get(i) - sph) <= eqT
                    sHE.set(i, true)
                    isEq := true
        sHP.push(sph)
        sHB.push(bar_index - sLen)
        sHT.push(time[sLen])
        sHE.push(isEq)
        sHX.push(xPk)
        if sHP.size() > 60
            sHP.shift()
            sHB.shift()
            sHT.shift()
            sHE.shift()
            sHX.shift()
        // SMT แบบ swing: ทองทำ High ที่สูงกว่า แต่เงินทำ High ที่ต่ำกว่า = Bearish SMT
        if useSMT and not na(pGH) and not na(pXH) and not na(xPk) and sph > pGH and xPk < pXH
            smtDBar := bar_index
            if showSMT
                f_smtMark(pHT, pGH, time[sLen], sph, f_tfTxt(timeframe.period), false, chSec * 1000, false)
        pGH := sph
        st0.rgh := na
        st0.rxh := na
        pHT := time[sLen]
        pXH := xPk
    if not na(spl)
        bool isEq = false
        if sLP.size() > 0
            for i = 0 to sLP.size() - 1
                if math.abs(sLP.get(i) - spl) <= eqT
                    sLE.set(i, true)
                    isEq := true
        sLP.push(spl)
        sLB.push(bar_index - sLen)
        sLT.push(time[sLen])
        sLE.push(isEq)
        sLX.push(xVal)
        if sLP.size() > 60
            sLP.shift()
            sLB.shift()
            sLT.shift()
            sLE.shift()
            sLX.shift()
        // SMT แบบ swing: ทองทำ Low ที่ต่ำกว่า แต่เงินทำ Low ที่สูงกว่า = Bullish SMT
        if useSMT and not na(pGL) and not na(pXL) and not na(xVal) and spl < pGL and xVal > pXL
            smtUBar := bar_index
            if showSMT
                f_smtMark(pGT, pGL, time[sLen], spl, f_tfTxt(timeframe.period), true, chSec * 1000, false)
        pGL := spl
        st0.rgl := na
        st0.rxl := na
        pGT := time[sLen]
        pXL := xVal
    float  uSwP = na
    int    uSwT = na
    bool   uKey = false
    string uTag = ""
    float  uX   = na
    float  dSwP = na
    int    dSwT = na
    bool   dKey = false
    string dTag = ""
    float  dX   = na
    if sLP.size() > 0
        for i = sLP.size() - 1 to 0
            float p = sLP.get(i)
            if bar_index - sLB.get(i) > liqAge
                sLP.remove(i)
                sLB.remove(i)
                sLT.remove(i)
                sLE.remove(i)
                sLX.remove(i)
            else if low < p
                if close > p and bar_index - sLB.get(i) - 1 >= sGap
                    if sLE.get(i)
                        uKey := true
                        uTag := "EQL"
                    if na(uSwP) or p < uSwP
                        uSwP := p
                        uSwT := sLT.get(i)
                        uX   := sLX.get(i)
                sLP.remove(i)
                sLB.remove(i)
                sLT.remove(i)
                sLE.remove(i)
                sLX.remove(i)
    if sHP.size() > 0
        for i = sHP.size() - 1 to 0
            float p = sHP.get(i)
            if bar_index - sHB.get(i) > liqAge
                sHP.remove(i)
                sHB.remove(i)
                sHT.remove(i)
                sHE.remove(i)
                sHX.remove(i)
            else if high > p
                if close < p and bar_index - sHB.get(i) - 1 >= sGap
                    if sHE.get(i)
                        dKey := true
                        dTag := "EQH"
                    if na(dSwP) or p > dSwP
                        dSwP := p
                        dSwT := sHT.get(i)
                        dX   := sHX.get(i)
                sHP.remove(i)
                sHB.remove(i)
                sHT.remove(i)
                sHE.remove(i)
                sHX.remove(i)
    // Key liquidity: PDH/PDL · Asia H/L (ไส้ทะลุแล้วปิดกลับ)
    bool hitPDL = useKey and not na(pdl) and low < pdl and close > pdl and (na(usedPDL) or pdl != usedPDL)
    bool hitAL  = useKey and not na(aL) and not inAsia and low < aL and close > aL
    bool hitPDH = useKey and not na(pdh) and high > pdh and close < pdh and (na(usedPDH) or pdh != usedPDH)
    bool hitAH  = useKey and not na(aH) and not inAsia and high > aH and close < aH
    if hitPDL or hitAL
        float kp = hitPDL ? pdl : aL
        uKey := true
        uTag := hitPDL ? "PDL" : "Asia L"
        if na(uSwP) or kp < uSwP
            uSwP := kp
        if na(uSwT)
            uSwT := time[20]
    if hitPDH or hitAH
        float kp = hitPDH ? pdh : aH
        dKey := true
        dTag := hitPDH ? "PDH" : "Asia H"
        if na(dSwP) or kp > dSwP
            dSwP := kp
        if na(dSwT)
            dSwT := time[20]

    // Sweep นับเฉพาะในโซน HTF และตรงทิศ · ระดับ MSS = high/low สุดของขาที่ส่งราคาไป sweep
    bool bullSw = ss == 1 and dir == 1 and not na(uSwP) and low <= zP + zoneSw * atr
    bool bearSw = ss == 1 and dir == -1 and not na(dSwP) and high >= zP - zoneSw * atr
    if bullSw or bearSw
        int   swT = bullSw ? uSwT : dSwT
        float swP = bullSw ? uSwP : dSwP
        float m   = na
        int   mt  = na
        float mb  = na
        for j = 1 to 300
            if time[j] < swT
                break
            if bullSw and (na(m) or high[j] > m)
                m  := high[j]
                mt := time[j]
                mb := math.max(open[j], close[j])
            if bearSw and (na(m) or low[j] < m)
                m  := low[j]
                mt := time[j]
                mb := math.min(open[j], close[j])
        if not na(m) and ((bullSw and m > close) or (bearSw and m < close))
            ss    := 2
            swWk  := bullSw ? low : high
            swBar := bar_index
            mLvl  := m
            mT    := mt
            mBody := mb
            swKey := bullSw ? uKey : dKey
            swTag := bullSw ? uTag : dTag
            kzHit := inKz
            // SMT: เงินไม่ทะลุ swing เดียวกันตอนทอง sweep · หรือมี SMT แบบ swing เกิดไม่นานก่อนหน้า
            bool swSmt = useSMT and (bullSw ? (not na(uX) and not na(xLo) and xLo > uX) : (not na(dX) and not na(xHi) and xHi < dX))
            int  dd    = bullSw ? 1 : -1
            bool htfSm = f_smtAct(st1, smtU1, smtTf1) == dd or f_smtAct(st2, smtU2, smtTf2) == dd or f_smtAct(st3, smtU3, smtTf3) == dd or f_smtAct(st4, smtU4, smtTf4) == dd
            htfSm := htfSm or f_smtNow(st1, smtU1, smtTf1) == dd or f_smtNow(st2, smtU2, smtTf2) == dd or f_smtNow(st3, smtU3, smtTf3) == dd or f_smtNow(st4, smtU4, smtTf4) == dd
            smtHit := swSmt or htfSm or (bullSw ? bar_index - smtUBar <= liqAge : bar_index - smtDBar <= liqAge)
            if bullSw and hitPDL
                usedPDL := pdl
            if bullSw and hitAL
                aL := na
            if bearSw and hitPDH
                usedPDH := pdh
            if bearSw and hitAH
                aH := na
            if showSM
                f_keepL(line.new(swT, swP, time, swP, xloc=xloc.bar_time, color=colSw, width=lw, style=line.style_dotted))
                f_sweepMark(time, swWk, "Sweep" + (swTag != "" ? " " + swTag : "") + (swSmt ? " · SMT" : ""), bullSw, swSmt ? colSMT : colSw)
                msL := line.new(mt, m, time, m, xloc=xloc.bar_time, color=color.new(bullSw ? colS : colR, 40), width=lw, style=line.style_dashed)

// ───────── SMT เรียลไทม์ (ทุก tick · ไม่รอแท่งปิด) ─────────
bool on1 = inCalc and useSMT and smtU1 and timeframe.in_seconds(smtTf1) > chSec
bool on2 = inCalc and useSMT and smtU2 and timeframe.in_seconds(smtTf2) > chSec
bool on3 = inCalc and useSMT and smtU3 and timeframe.in_seconds(smtTf3) > chSec
bool on4 = inCalc and useSMT and smtU4 and timeframe.in_seconds(smtTf4) > chSec
[lu0, ld0] = f_smtLive(st0, inCalc and useSMT, pGL, pGT, pXL, pGH, pHT, pXH, false)
[lu1, ld1] = f_smtLive(st1, on1, st1.gl, st1.glt, st1.xl, st1.gh, st1.ght, st1.xh, true)
[lu2, ld2] = f_smtLive(st2, on2, st2.gl, st2.glt, st2.xl, st2.gh, st2.ght, st2.xh, true)
[lu3, ld3] = f_smtLive(st3, on3, st3.gl, st3.glt, st3.xl, st3.gh, st3.ght, st3.xh, true)
[lu4, ld4] = f_smtLive(st4, on4, st4.gl, st4.glt, st4.xl, st4.gh, st4.ght, st4.xh, true)
// ป้ายเดียวต่อฝั่ง รวมชื่อ TF (ไม่ซ้อนกัน) · วางห่างจากไส้ 0.6 ATR ไม่ให้ทับป้าย Sweep / SMT จริง
string lvUt = (lu0 ? " " + f_tfTxt(timeframe.period) : "") + (lu1 ? " " + f_tfTxt(smtTf1) : "") + (lu2 ? " " + f_tfTxt(smtTf2) : "") + (lu3 ? " " + f_tfTxt(smtTf3) : "") + (lu4 ? " " + f_tfTxt(smtTf4) : "")
string lvDt = (ld0 ? " " + f_tfTxt(timeframe.period) : "") + (ld1 ? " " + f_tfTxt(smtTf1) : "") + (ld2 ? " " + f_tfTxt(smtTf2) : "") + (ld3 ? " " + f_tfTxt(smtTf3) : "") + (ld4 ? " " + f_tfTxt(smtTf4) : "")
float lpU = na
int   ltU = na
float lpD = na
int   ltD = na
[pu0, tu0] = f_pk(lu0, st0.rgl, st0.rglt, lpU, ltU, true)
[pu1, tu1] = f_pk(lu1, st1.rgl, st1.rglt, pu0, tu0, true)
[pu2, tu2] = f_pk(lu2, st2.rgl, st2.rglt, pu1, tu1, true)
[pu3, tu3] = f_pk(lu3, st3.rgl, st3.rglt, pu2, tu2, true)
[pu4, tu4] = f_pk(lu4, st4.rgl, st4.rglt, pu3, tu3, true)
[pd0, td0] = f_pk(ld0, st0.rgh, st0.rght, lpD, ltD, false)
[pd1, td1] = f_pk(ld1, st1.rgh, st1.rght, pd0, td0, false)
[pd2, td2] = f_pk(ld2, st2.rgh, st2.rght, pd1, td1, false)
[pd3, td3] = f_pk(ld3, st3.rgh, st3.rght, pd2, td2, false)
[pd4, td4] = f_pk(ld4, st4.rgh, st4.rght, pd3, td3, false)
var label lvU = na
var label lvD = na
color lvC = color.new(colSMT, 25)
if smtRT and showSMT and lvUt != "" and not na(pu4)
    float y = pu4 - 0.6 * atr
    if na(lvU)
        lvU := label.new(tu4, y, "SMT?" + lvUt, xloc=xloc.bar_time, style=label.style_label_up, color=cNone, textcolor=lvC, size=txtSz)
    else
        label.set_xy(lvU, tu4, y)
        label.set_text(lvU, "SMT?" + lvUt)
else if not na(lvU)
    label.delete(lvU)
    lvU := na
if smtRT and showSMT and lvDt != "" and not na(pd4)
    float y = pd4 + 0.6 * atr
    if na(lvD)
        lvD := label.new(td4, y, "SMT?" + lvDt, xloc=xloc.bar_time, style=label.style_label_down, color=cNone, textcolor=lvC, size=txtSz)
    else
        label.set_xy(lvD, td4, y)
        label.set_text(lvD, "SMT?" + lvDt)
else if not na(lvD)
    label.delete(lvD)
    lvD := na
bool smtLiveNew = barstate.isrealtime and smtRT and ((lvUt != "" and lvUt != lvUt[1]) or (lvDt != "" and lvDt != lvDt[1]))
if smtLiveNew
    alert("MSNR×SMC: SMT เรียลไทม์" + (lvUt != "" ? " ▲ Bullish" + lvUt : "") + (lvDt != "" ? " ▼ Bearish" + lvDt : "") + " · " + syminfo.ticker + " " + str.tostring(close, format.mintick), alert.freq_once_per_bar)

alertcondition(sigMss == 1, "MSS → Buy Limit", "MSNR×SMC: Sweep + MSS ขึ้น → ตั้ง Buy Limit")
alertcondition(sigMss == -1, "MSS → Sell Limit", "MSNR×SMC: Sweep + MSS ลง → ตั้ง Sell Limit")
alertcondition(sigFill != 0, "Limit Filled", "MSNR×SMC: Limit โดนแล้ว")
plotshape(sigFill == 1, title="Buy filled", style=shape.triangleup, location=location.belowbar, color=colS, size=size.tiny, display=display.pane)
plotshape(sigFill == -1, title="Sell filled", style=shape.triangledown, location=location.abovebar, color=colR, size=size.tiny, display=display.pane)

// ───────── Render ─────────
// Dashboard SMT: ▲/▼ = ยืนยันแล้ว · ▲?/▼? = เรียลไทม์ (ยังไม่ยืนยัน)
f_smD(bool on, string tf, int a, bool lu, bool ld) =>
    on ? "  " + f_tfTxt(tf) + (a == 1 ? " ▲" : a == -1 ? " ▼" : lu ? " ▲?" : ld ? " ▼?" : " ·") : ""
string dPos = dashPos == "บนขวา" ? position.top_right : dashPos == "ล่างซ้าย" ? position.bottom_left : dashPos == "บนซ้าย" ? position.top_left : position.bottom_right
var table dash = table.new(dPos, 2, 11, bgcolor=color.new(chart.bg_color, 0), frame_color=color.new(chart.fg_color, 85), frame_width=1, border_width=0)

if barstate.islast
    array<float> vp = array.new<float>()
    array<int>   vk = array.new<int>()
    float  nR = na
    float  nS = na
    string tR = ""
    string tS = ""
    int    xR = bar_index + offs
    int    xT = bar_index + 2

    // HTF
    int nH = lvH.size()
    if nH > 0
        for i = 0 to nH - 1
            Lvl  l    = lvH.get(i)
            bool up   = l.price >= close
            bool ok   = l.fresh or not freshOnly
            int  rank = 0
            if ok
                float d = math.abs(l.price - close)
                for j = 0 to nH - 1
                    if j != i
                        Lvl m = lvH.get(j)
                        if (m.fresh or not freshOnly) and (m.price >= close) == up and math.abs(m.price - close) < d
                            rank += 1
            if l.fresh and up and l.kind == -1 and (na(nR) or l.price < nR)
                nR := l.price
                tR := l.tf + " " + l.tag
            if l.fresh and not up and l.kind == 1 and (na(nS) or l.price > nS)
                nS := l.price
                tS := l.tf + " " + l.tag
            bool  vis = ok and rank < nShowH
            color c   = f_col(l.base, l.kind)
            color cc  = l.fresh ? c : color.new(c, 50)
            l.ln.set_x2(xR)
            l.lb.set_xy(xT, l.price)
            if vis
                string cf = f_conf(l)
                vp.push(l.price)
                vk.push(l.kind)
                l.ln.set_color(cc)
                l.ln.set_width(lw)
                l.ln.set_style(l.fresh ? line.style_solid : line.style_dotted)
                l.lb.set_text(l.tf + " " + l.tag + (cf != "" ? "  ✦ " + cf : ""))
                l.lb.set_textcolor(cc)
            else
                l.ln.set_color(color.new(c, 100))
                l.lb.set_text("")

    // LTF
    int   nL1 = lvL.size()
    float ct  = math.max(atr * confA, syminfo.mintick)
    if nL1 > 0
        for i = 0 to nL1 - 1
            Lvl  l      = lvL.get(i)
            bool ok     = l.fresh or not freshOnly
            bool merged = false
            bool near   = not ltfNear
            if vp.size() > 0
                for k = 0 to vp.size() - 1
                    float d = math.abs(l.price - vp.get(k))
                    if vk.get(k) == l.kind and d <= ct
                        merged := true
                    if d <= zoneA * atr
                        near := true
            bool  vis = ok and not merged and near
            color c   = f_col(l.base, l.kind)
            color cc  = l.fresh ? c : color.new(c, 50)
            l.ln.set_x2(xR)
            l.lb.set_xy(xT, l.price)
            if vis
                l.ln.set_color(cc)
                l.ln.set_width(lw)
                l.ln.set_style(l.fresh ? line.style_solid : line.style_dotted)
                l.lb.set_text(l.tag)
                l.lb.set_textcolor(cc)
            else
                l.ln.set_color(color.new(c, 100))
                l.lb.set_text("")

    // แท่งเทียน TF ใหญ่
    for b in pX
        b.delete()
    for ln in pL
        ln.delete()
    for lb in pB
        lb.delete()
    pX.clear()
    pL.clear()
    pB.clear()
    if showC
        int xNext = f_drawC(cAO, cAH, cAL, cAC, cAT, cNA, offs + 4, cTfA)
        f_drawC(cBO, cBH, cBL, cBC, cBT, cNB, xNext, cTfB)

    if ss == 4
        line.set_x2(eL, xR)
        line.set_x2(sL, xR)
        line.set_x2(tL, xR)
        label.set_x(eB, xR)
        label.set_x(sB, xR)
        label.set_x(tB, xR)
        line.set_x2(t1L, xR)
        label.set_x(t1B, xR)

    if showDash
        color  fg   = chart.fg_color
        color  dim  = color.new(fg, 40)
        int    sty  = story2 != 0 ? story2 : story1
        string sSrc = story2 != 0 ? tf2T : tf1T
        string sTxt = sty == 1 ? "▲ Bullish (" + sSrc + ")" : sty == -1 ? "▼ Bearish (" + sSrc + ")" : "— No trend"
        color  sCol = sty == 1 ? colS : sty == -1 ? colR : dim
        string arw  = dir == 1 ? "▲ " : "▼ "
        string stTxt = ss == 0 ? (skip != "" ? skip : inSess ? "รอราคาแตะเลเวล HTF" : "นอก Session") : ss == 1 ? arw + "ในโซน " + zTxt + " · รอ Sweep" : ss == 2 or ss == 3 ? arw + "Sweep ✓ · รอ MSS " + (dir == 1 ? "> " : "< ") + str.tostring(mLvl, format.mintick) : ss == 4 ? arw + (dir == 1 ? "Buy" : "Sell") + " Limit " + str.tostring(enP, format.mintick) + " · " + enTxt : arw + "In trade " + str.tostring(enP, format.mintick) + (tp1H ? " · TP1 ✓ กันทุนแล้ว" : "")
        color  stCol = ss == 0 ? dim : dir == 1 ? colS : colR
        int    nWL   = nW + nL
        string stat  = nWL + nT == 0 ? "—" : "W " + str.tostring(nW) + " · L " + str.tostring(nL) + (nT > 0 ? " · T " + str.tostring(nT) : "") + " · " + (nWL > 0 ? str.tostring(100.0 * nW / nWL, "#") + "%" : "-") + " · " + (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.#") + "R"
        table.cell(dash, 0, 0, "Storyline", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 0, sTxt, text_color=sCol, text_size=size.tiny, text_halign=text.align_right)
        table.cell(dash, 0, 1, "Next R", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 1, na(nR) ? "—" : str.tostring(nR, format.mintick) + "  " + tR, text_color=colR, text_size=size.tiny, text_halign=text.align_right)
        table.cell(dash, 0, 2, "Next S", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 2, na(nS) ? "—" : str.tostring(nS, format.mintick) + "  " + tS, text_color=colS, text_size=size.tiny, text_halign=text.align_right)
        table.cell(dash, 0, 3, "Setup", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 3, stTxt, text_color=stCol, text_size=size.tiny, text_halign=text.align_right)
        table.cell(dash, 0, 4, "SL / TP", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 4, ss >= 4 ? str.tostring(slNow, format.mintick) + (tp1H ? " (BE)" : "") + " / " + (na(tp1P) ? "" : str.tostring(tp1P, format.mintick) + " · ") + str.tostring(tpP, format.mintick) + "  1:" + str.tostring(rrV, "#.#") : "—", text_color=fg, text_size=size.tiny, text_halign=text.align_right)
        table.cell(dash, 0, 5, "Score", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 5, ckTxt == "" ? "—" : f_grade(tSc, scMax) + " " + str.tostring(tSc) + "/" + str.tostring(scMax) + "  " + ckTxt, text_color=tSc >= scMax - 2 ? (dir == 1 ? colS : colR) : fg, text_size=size.tiny, text_halign=text.align_right)
        table.cell(dash, 0, 6, "Stats", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 6, stat, text_color=fg, text_size=size.tiny, text_halign=text.align_right)
        int    nA    = aW + aL2
        string statA = nA == 0 ? "—" : "W " + str.tostring(aW) + " · L " + str.tostring(aL2) + " · " + str.tostring(100.0 * aW / nA, "#") + "% · " + (aR >= 0 ? "+" : "") + str.tostring(aR, "#.#") + "R"
        table.cell(dash, 0, 7, "Stats A/A+", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 7, statA, text_color=fg, text_size=size.tiny, text_halign=text.align_right)
        int    cS   = bar_index - smtUBar <= liqAge and smtUBar >= smtDBar ? 1 : bar_index - smtDBar <= liqAge ? -1 : bar_index - smtUBar <= liqAge ? 1 : 0
        string sm0  = useSMT ? f_tfTxt(timeframe.period) + (cS == 1 ? " ▲" : cS == -1 ? " ▼" : lu0 ? " ▲?" : ld0 ? " ▼?" : " ·") : "ปิด"
        int    a1   = f_smtAct(st1, smtU1, smtTf1)
        int    a2   = f_smtAct(st2, smtU2, smtTf2)
        int    a3   = f_smtAct(st3, smtU3, smtTf3)
        int    a4   = f_smtAct(st4, smtU4, smtTf4)
        string smR  = sm0 + f_smD(smtU1, smtTf1, a1, lu1, ld1) + f_smD(smtU2, smtTf2, a2, lu2, ld2) + f_smD(smtU3, smtTf3, a3, lu3, ld3) + f_smD(smtU4, smtTf4, a4, lu4, ld4)
        table.cell(dash, 0, 9, "SMT", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 9, smR, text_color=colSMT, text_size=size.tiny, text_halign=text.align_right)
        // PRO: OB ใกล้ราคา + Quarter
        float  obNs = na
        float  obNd = na
        string obNsT = ""
        string obNdT = ""
        for z in obZones
            if z.isSup and z.bot >= close and (na(obNs) or z.bot < obNs)
                obNs  := z.bot
                obNsT := z.tfTxt
            if not z.isSup and z.top <= close and (na(obNd) or z.top > obNd)
                obNd  := z.top
                obNdT := z.tfTxt
        array<string> qph = array.from("A", "M", "D", "X")
        string qtTx = "Q" + str.tostring(qtDQ + 1) + " " + qph.get(qtDQ) + " · 90m Q" + str.tostring(qtMQ + 1) + (qtMQ == 0 ? " สะสม" : qsML and qsMH ? " · กวาด Q1 2 ฝั่ง" : qsML ? " · กวาด L → BUY" : qsMH ? " · กวาด H → SELL" : " · ยังไม่กวาด")
        string obTx = (na(obNd) ? "D —" : "D " + str.tostring(obNd, format.mintick) + " " + obNdT) + " · " + (na(obNs) ? "S —" : "S " + str.tostring(obNs, format.mintick) + " " + obNsT)
        table.cell(dash, 0, 10, "OB · QT", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 10, obTx + "  |  " + qtTx, text_color=qsML and not qsMH ? colS : qsMH and not qsML ? colR : fg, text_size=size.tiny, text_halign=text.align_right)
        table.cell(dash, 0, 8, "Lot", text_color=dim, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, 8, ss >= 4 and not na(lotV) ? str.tostring(lotV, "#.##") + " lot · เสี่ยง $" + str.tostring(riskUsd, "#.##") + " · SL " + str.tostring(math.abs(enP - slP) / ptSize, "#") + " pts" : "—", text_color=fg, text_size=size.tiny, text_halign=text.align_right)

// ════════════════════════════════════════════════════════════════
// ███ QT: เส้น True Open / Q1 + แถบ Quarter ใต้กราฟ (วาดตอนแท่งสุดท้าย) ███
// ════════════════════════════════════════════════════════════════
var array<line>  qtLn = array.new<line>()
var array<label> qtLb = array.new<label>()
var array<box>   qtB  = array.new<box>()

f_qtLine(float p, int t0, string txt, color c, string st) =>
    if not na(p) and not na(t0)
        int x2 = time + offs * chSec * 1000
        qtLn.push(line.new(t0, p, x2, p, xloc=xloc.bar_time, color=c, style=st, width=1))
        qtLb.push(label.new(x2, p, txt, xloc=xloc.bar_time, style=label.style_label_left, color=cNone, textcolor=c, size=txtSz))

if barstate.islast
    while qtLn.size() > 0
        line.delete(qtLn.pop())
    while qtLb.size() > 0
        label.delete(qtLb.pop())
    if qtLines
        color cTO = color.new(chart.fg_color, 35)
        f_qtLine(qsTO, qsTOT, "TO 90m", cTO, line.style_dotted)
        f_qtLine(qdTO, qdTOT, "TDO", cTO, line.style_dashed)
        if qtMQ > 0
            f_qtLine(qsH, qsHT, "Q1 H" + (qsMH ? " ✓กวาด" : ""), color.new(colR, 30), line.style_dotted)
            f_qtLine(qsL, qsLT, "Q1 L" + (qsML ? " ✓กวาด" : ""), color.new(colS, 30), line.style_dotted)

if qtShow and barstate.islast
    while qtB.size() > 0
        box.delete(qtB.pop())
    int   nbq = math.min(bar_index, qtDays * int(86400 / math.max(chSec, 1)), 480)
    float qlo = low
    float qhi = high
    for j = 0 to nbq
        qlo := math.min(qlo, low[j])
        qhi := math.max(qhi, high[j])
    float qrg  = math.max(qhi - qlo, atr)
    float qh   = qrg * 0.035
    float qy0  = qlo - qrg * 0.03
    int   tCyc = time - qtMin * 60000            // ต้นวัน Quarterly (18:00 NY)
    color qTx  = color.new(chart.fg_color, 40)
    array<color>  qc = array.from(color.new(color.gray, 70), color.new(colR, 75), color.new(colS, 75), color.new(color.blue, 75))
    array<string> qn = array.from("Q1 A · Asia", "Q2 M · London", "Q3 D · NY AM", "Q4 X · NY PM")
    for k = -(qtDays * 4) to 3
        int  t0  = tCyc + k * 21600000
        int  qi  = ((k % 4) + 4) % 4
        bool cur = k == qtDQ
        qtB.push(box.new(t0, qy0 - qh, t0 + 21600000, qy0 - 2 * qh, xloc=xloc.bar_time, border_color=cur ? chart.fg_color : color.new(chart.fg_color, 55), border_width=cur ? 2 : 1, bgcolor=qc.get(qi), text=qn.get(qi), text_size=size.tiny, text_color=qTx))
        for m = 0 to 3
            int  t1 = t0 + m * 5400000
            bool c2 = cur and m == qtMQ
            qtB.push(box.new(t1, qy0, t1 + 5400000, qy0 - qh, xloc=xloc.bar_time, border_color=c2 ? chart.fg_color : color.new(chart.fg_color, 55), border_width=c2 ? 2 : 1, bgcolor=qc.get(m)))
