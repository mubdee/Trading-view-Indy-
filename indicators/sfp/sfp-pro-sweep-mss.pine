// ════════════════════════════════════════════════════════════════
// SFP Pro X — Liquidity Sweep + MSS  (Pine Script v6)
// Sweep liquidity → MSS ด้วยเนื้อเทียน + displacement → เข้าที่ OB/FVG
// กรองด้วย HTF Bias, Session, Key liquidity, ความลึก sweep, Volume (LTF)
// ดูคำอธิบาย: indicators/sfp/README.md
// ════════════════════════════════════════════════════════════════
//@version=6
indicator("SFP Pro X — Liquidity Sweep + MSS", "SFP Pro X", overlay = true, max_boxes_count = 200, max_lines_count = 400, max_labels_count = 300, max_bars_back = 500)

// ═════════════════════════ INPUTS ═════════════════════════
grpG = "General"
confirmClose = input.bool(true, "ยืนยันเมื่อแท่งปิด", group = grpG, tooltip = "ปิด = เห็นสัญญาณ real-time ระหว่างแท่ง")
sessTz       = input.string("UTC", "Timezone ของ Session", group = grpG, tooltip = "เช่น UTC, Asia/Bangkok, America/New_York")

grpL = "1) Liquidity"
showBullS = input.bool(true, "Bullish SFP", inline = "s0", group = grpL)
showBearS = input.bool(true, "Bearish SFP", inline = "s0", group = grpL)
liqMode   = input.string("All", "ใช้ Liquidity", options = ["All", "Key only"], group = grpL, tooltip = "Key only = เฉพาะ EQH/EQL, PDH/PDL, Asia H/L, HTF H/L")
pivLeft   = input.int(5, "Swing: Left", minval = 1, inline = "p", group = grpL)
pivRight  = input.int(1, "Right", minval = 1, inline = "p", group = grpL)
maxLv     = input.int(10, "จำนวนระดับที่ติดตาม (ต่อฝั่ง)", minval = 1, maxval = 40, group = grpL)
useEq     = input.bool(true, "Equal Highs/Lows", inline = "eq", group = grpL)
eqTol     = input.float(0.1, "Tolerance (x ATR)", minval = 0.01, step = 0.01, inline = "eq", group = grpL)
usePD     = input.bool(true, "PDH/PDL", inline = "k", group = grpL)
useAsia   = input.bool(true, "Asia H/L", inline = "k", group = grpL)
useHtfLv  = input.bool(false, "HTF candle H/L", inline = "k", group = grpL)
asiaSess  = input.session("0000-0700", "Asia session", group = grpL)

grpS = "2) Sweep"
rejMode  = input.string("Close", "แท่ง Sweep ต้องปิดกลับด้วย", options = ["Close", "Body"], group = grpS, tooltip = "Close = ราคาปิดกลับเข้ามาในระดับ\nBody = ทั้ง open และ close ต้องอยู่ในระดับ")
sweepMin = input.float(0.0, "ลึกอย่างน้อย (x ATR)", minval = 0, step = 0.05, group = grpS)
sweepMax = input.float(1.5, "ลึกไม่เกิน (x ATR) · 0 = ปิด", minval = 0, step = 0.1, group = grpS, tooltip = "ไส้ลึกเกินไปมักเป็น breakout จริง ไม่ใช่ SFP")

grpC = "3) MSS Confirmation"
intLeft     = input.int(2, "Swing ล่าสุด: Left", minval = 1, inline = "i", group = grpC)
intRight    = input.int(1, "Right", minval = 1, inline = "i", group = grpC)
breakMode   = input.string("Close", "ทะลุด้วย", options = ["Close", "Full Body"], group = grpC, tooltip = "Close = ราคาปิดทะลุ\nFull Body = ทั้ง open และ close ต้องเลยระดับ")
dispMode    = input.string("Body ATR หรือ FVG", "Displacement", options = ["Off", "Body ATR", "FVG", "Body ATR หรือ FVG"], group = grpC, tooltip = "แท่งที่ทะลุต้องมีแรง: body ใหญ่ หรือทิ้ง FVG")
dispAtr     = input.float(0.8, "Body ขั้นต่ำ (x ATR)", minval = 0.1, step = 0.1, group = grpC)
confBars    = input.int(10, "ต้องทะลุภายใน (แท่ง)", minval = 1, maxval = 50, group = grpC)
showPending = input.bool(true, "แสดง SFP ที่รอ MSS (จาง ๆ)", group = grpC)

grpH = "4) HTF Bias"
biasMode  = input.string("EMA", "Bias filter", options = ["Off", "EMA", "Premium/Discount", "EMA + P/D"], group = grpH, tooltip = "EMA: Bull SFP เฉพาะเมื่อ HTF close > EMA\nP/D: Bull SFP เฉพาะใน Discount, Bear SFP เฉพาะใน Premium")
htfTf     = input.timeframe("240", "HTF", group = grpH)
htfEmaLen = input.int(50, "EMA length (HTF)", minval = 1, group = grpH)
pdLen     = input.int(50, "P/D range (HTF bars)", minval = 5, group = grpH)

grpK = "5) Session (Kill Zone)"
useSess = input.bool(false, "เอาเฉพาะ SFP ใน London / NY", group = grpK)
sessLon = input.session("0700-1000", "London", group = grpK)
sessNy  = input.session("1230-1530", "New York", group = grpK)

grpE = "6) Entry Zone"
entryMode  = input.string("OB + FVG", "โซนเข้า", options = ["OB", "FVG", "OB + FVG", "Sweep Wick"], group = grpE, tooltip = "OB/FVG ที่เกิดในขา MSS")
obType     = input.string("Full", "OB ขอบเขต", options = ["Full", "Body"], group = grpE)
zExt       = input.int(10, "ยื่นไปทางขวา (แท่ง)", minval = 0, group = grpE)
obBullCol  = input.color(color.new(#089981, 80), "OB Bull", inline = "e1", group = grpE)
obBearCol  = input.color(color.new(#f23645, 80), "OB Bear", inline = "e1", group = grpE)
fvgBullCol = input.color(color.new(#2962ff, 85), "FVG Bull", inline = "e2", group = grpE)
fvgBearCol = input.color(color.new(#ff9800, 85), "FVG Bear", inline = "e2", group = grpE)

grpR = "7) Trade & Stats"
showTP = input.bool(true, "แสดง TP / SL", group = grpR)
rr     = input.float(2.0, "RR", minval = 0.5, step = 0.5, group = grpR)
slBuf  = input.float(0.1, "SL buffer (x ATR)", minval = 0, step = 0.05, group = grpR)

grpD = "Display"
maxShow  = input.int(1, "แสดง SFP ล่าสุด (ต่อฝั่ง)", minval = 1, maxval = 10, group = grpD)
maxAge   = input.int(150, "ลบเมื่อเก่าเกิน (แท่ง) · 0 = ไม่จำกัด", minval = 0, group = grpD)
showLbl  = input.bool(true, "Label SFP", inline = "d0", group = grpD)
showLn   = input.bool(true, "เส้น Liquidity", inline = "d0", group = grpD)
showMss  = input.bool(true, "เส้น MSS", inline = "d1", group = grpD)
showWick = input.bool(false, "ไฮไลต์ไส้", inline = "d1", group = grpD)
bullCol  = input.color(#089981, "Bull", inline = "d2", group = grpD)
bearCol  = input.color(#f23645, "Bear", inline = "d2", group = grpD)
txtSize  = input.string("small", "ขนาดตัวอักษร", options = ["tiny", "small", "normal"], group = grpD)

grpV = "Volume Validation (LTF)"
useVol  = input.bool(false, "ใช้ Volume กรอง SFP", group = grpV)
volThr  = input.float(25, "Volume เลยระดับได้ไม่เกิน (%)", minval = 1, maxval = 100, group = grpV)
ltfMode = input.string("Auto", "LTF Resolution", options = ["Auto", "Manual"], group = grpV)
ltfMan  = input.timeframe("1", "Manual LTF", group = grpV)

grpT = "Dashboard"
showDash = input.bool(true, "แสดง Dashboard", group = grpT)
dashPos  = input.string("Top Right", "ตำแหน่ง", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grpT)

// ═════════════════════════ HELPERS ═════════════════════════
f_size(string s) =>
    s == "tiny" ? size.tiny : s == "small" ? size.small : size.normal

f_pos(string s) =>
    s == "Top Right" ? position.top_right : s == "Bottom Right" ? position.bottom_right : s == "Top Left" ? position.top_left : position.bottom_left

f_autoLTF() =>
    s = timeframe.in_seconds()
    s <= 60 ? timeframe.period : s <= 300 ? "1" : s <= 3600 ? "5" : s <= 14400 ? "15" : s <= 86400 ? "60" : "240"

f_inSess(string s) =>
    not na(time(timeframe.period, s, sessTz))

ltf      = ltfMode == "Auto" ? f_autoLTF() : ltfMan
conf     = confirmClose ? barstate.isconfirmed : true
bt       = math.max(open, close)
bb       = math.min(open, close)
body     = bt - bb
atrV     = ta.atr(14)
wickZone = entryMode == "Sweep Wick"
rejBody  = rejMode == "Body"
fullBody = breakMode == "Full Body"

// Sessions
inAsia = f_inSess(asiaSess)
inLon  = f_inSess(sessLon)
inNy   = f_inSess(sessNy)
sessOk = not useSess or inLon or inNy

// ═════════════════════════ HTF DATA (non-repaint) ═════════════════════════
[hC, hE, hHi, hLo, hH1, hL1] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, htfEmaLen)[1], ta.highest(high, pdLen)[1], ta.lowest(low, pdLen)[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

pdMid   = (hHi + hLo) / 2
emaBull = hC > hE
emaBear = hC < hE
inPrem  = close > pdMid
inDisc  = close < pdMid

bullAllowed = biasMode == "Off" ? true : biasMode == "EMA" ? emaBull : biasMode == "Premium/Discount" ? inDisc : emaBull and inDisc
bearAllowed = biasMode == "Off" ? true : biasMode == "EMA" ? emaBear : biasMode == "Premium/Discount" ? inPrem : emaBear and inPrem

emaTxt  = emaBull ? "▲ Bull" : emaBear ? "▼ Bear" : "-"
pdTxt   = inPrem ? "Premium" : "Discount"
biasTxt = biasMode == "Off" ? "Off" : biasMode == "EMA" ? emaTxt : biasMode == "Premium/Discount" ? pdTxt : emaTxt + " · " + pdTxt

newDay = timeframe.change("D")
newHtf = timeframe.change(htfTf)

// ═════════════════════════ DISPLACEMENT ═════════════════════════
dispBodyBull = close > open and body >= dispAtr * atrV
dispBodyBear = close < open and body >= dispAtr * atrV
bullFvgNow   = high[2] < low
bearFvgNow   = low[2] > high
bullFvgRec   = bullFvgNow or bullFvgNow[1]
bearFvgRec   = bearFvgNow or bearFvgNow[1]
dispBull = dispMode == "Off" ? true : dispMode == "Body ATR" ? dispBodyBull : dispMode == "FVG" ? bullFvgRec : (dispBodyBull or bullFvgRec)
dispBear = dispMode == "Off" ? true : dispMode == "Body ATR" ? dispBodyBear : dispMode == "FVG" ? bearFvgRec : (dispBodyBear or bearFvgRec)

// ═════════════════════════ LTF VOLUME ═════════════════════════
[ltfH, ltfL, ltfV] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low, volume])

f_beyondPct(float level, bool isBear) =>
    float tot = 0.0
    float out = 0.0
    for [i, v] in ltfV
        vv = nz(v)
        tot += vv
        if isBear ? ltfH.get(i) > level : ltfL.get(i) < level
            out += vv
    tot > 0 ? out / tot * 100 : na

// ═════════════════════════ TYPES ═════════════════════════
type Level
    float  price
    int    bar
    string tag

type Sig
    bool   bull
    float  lvl
    int    lvlBar
    string tag
    int    bar
    float  ext
    float  edge
    float  trig
    int    trigBar
    int    expire
    float  pct
    int    born
    float  sl
    float  tp
    bool   drawn = false
    label  lb
    label  ml
    label  tpLb
    label  slLb
    line   ln
    line   wk
    line   cl
    line   tpl
    line   sll
    box    bx
    box    fx

type Trade
    bool  bull
    int   bar
    float sl
    float tp

var array<Level> highsLv = array.new<Level>()
var array<Level> lowsLv  = array.new<Level>()
var array<Sig>   actBull = array.new<Sig>()
var array<Sig>   actBear = array.new<Sig>()
var array<Trade> trades  = array.new<Trade>()
var Sig pBull = na
var Sig pBear = na

var string lastType  = "-"
var string lastTag   = ""
var float  lastPrice = na
var float  lastPct   = na
var float  lastTrig  = na
var string lastValid = "-"
var int    nWin      = 0
var int    nLoss     = 0

// ═════════════════════════ SWING ล่าสุด (สำหรับ MSS) ═════════════════════════
iph = ta.pivothigh(high, intLeft, intRight)
ipl = ta.pivotlow(low, intLeft, intRight)
var float lastSH    = na
var int   lastSHBar = na
var float lastSL    = na
var int   lastSLBar = na
if not na(iph)
    lastSH    := iph
    lastSHBar := bar_index - intRight
if not na(ipl)
    lastSL    := ipl
    lastSLBar := bar_index - intRight

fbN       = intLeft + intRight + 1
fbLow     = ta.lowest(low, fbN)[1]
fbLowBar  = bar_index - 1 + ta.lowestbars(low, fbN)[1]
fbHigh    = ta.highest(high, fbN)[1]
fbHighBar = bar_index - 1 + ta.highestbars(high, fbN)[1]

// ═════════════════════════ FUNCTIONS ═════════════════════════
f_pushLv(array<Level> arr, float price, int bar, string tag) =>
    arr.push(Level.new(price, bar, tag))
    if arr.size() > maxLv
        arr.shift()

f_delSig(Sig s) =>
    if not na(s.lb)
        s.lb.delete()
    if not na(s.ml)
        s.ml.delete()
    if not na(s.tpLb)
        s.tpLb.delete()
    if not na(s.slLb)
        s.slLb.delete()
    if not na(s.ln)
        s.ln.delete()
    if not na(s.wk)
        s.wk.delete()
    if not na(s.cl)
        s.cl.delete()
    if not na(s.tpl)
        s.tpl.delete()
    if not na(s.sll)
        s.sll.delete()
    if not na(s.bx)
        s.bx.delete()
    if not na(s.fx)
        s.fx.delete()

f_draw(Sig s, bool pend) =>
    col    = s.bull ? bullCol : bearCol
    c      = pend ? color.new(col, 65) : col
    tagTxt = s.tag == "Swing" ? "" : " · " + s.tag
    tip    = (s.bull ? "Bullish SFP" : "Bearish SFP") + "\nLiquidity: " + s.tag + " @ " + str.tostring(s.lvl, format.mintick) + "\nSweep: " + str.tostring(s.ext, format.mintick) + "\nMSS level: " + str.tostring(s.trig, format.mintick) + (useVol and not na(s.pct) ? "\nVol beyond: " + str.tostring(s.pct, "#.#") + "%" : "")
    if showLbl
        s.lb := label.new(s.bar, s.ext, (pend ? "SFP ?" : "SFP") + tagTxt, style = s.bull ? label.style_label_up : label.style_label_down, color = c, textcolor = pend ? color.new(color.white, 30) : color.white, size = f_size(txtSize), tooltip = tip)
    if showLn
        s.ln := line.new(s.lvlBar, s.lvl, s.bar, s.lvl, color = pend ? color.new(col, 50) : col, style = line.style_dashed)
    if showWick
        s.wk := line.new(s.bar, s.ext, s.bar, s.lvl, color = c, width = 3)
    if showMss
        s.cl := line.new(s.trigBar, s.trig, bar_index + 1, s.trig, color = color.new(col, 50), style = line.style_dotted)
    s.drawn := true

// OB = แท่งสวนทางสุดท้ายที่ปลายขา (bear: แท่งเขียวที่ high สูงสุด / bull: แท่งแดงที่ low ต่ำสุด)
f_findOB(bool bull, int n) =>
    int   k    = na
    float best = na
    for i = 0 to n
        if bull
            if close[i] < open[i] and (na(best) or low[i] < best)
                best := low[i]
                k    := i
        else
            if close[i] > open[i] and (na(best) or high[i] > best)
                best := high[i]
                k    := i
    float top = na
    float bot = na
    if not na(k)
        top := obType == "Full" ? high[k] : math.max(open[k], close[k])
        bot := obType == "Full" ? low[k] : math.min(open[k], close[k])
    [k, top, bot]

// FVG ที่ใหญ่ที่สุดในขา MSS
f_findFVG(bool bull, int n) =>
    int   k      = na
    float top    = na
    float bot    = na
    float bestSz = 0.0
    for i = 0 to n - 2
        if bull
            if high[i + 2] < low[i]
                sz = low[i] - high[i + 2]
                if sz > bestSz
                    bestSz := sz
                    k      := i + 2
                    top    := low[i]
                    bot    := high[i + 2]
        else
            if low[i + 2] > high[i]
                sz = low[i + 2] - high[i]
                if sz > bestSz
                    bestSz := sz
                    k      := i + 2
                    top    := low[i + 2]
                    bot    := high[i]
    [k, top, bot]

f_activate(Sig s, array<Sig> arr) =>
    col = s.bull ? bullCol : bearCol
    if not s.drawn
        f_draw(s, false)
    else
        if not na(s.lb)
            s.lb.set_text("SFP" + (s.tag == "Swing" ? "" : " · " + s.tag))
            s.lb.set_color(col)
            s.lb.set_textcolor(color.white)
        if not na(s.ln)
            s.ln.set_color(col)
        if not na(s.wk)
            s.wk.set_color(col)
    if showMss and not na(s.cl)
        s.cl.set_x2(bar_index)
        s.cl.set_color(col)
        s.cl.set_style(line.style_solid)
        s.cl.set_width(2)
        s.ml := label.new(math.round((s.trigBar + bar_index) / 2), s.trig, "MSS", style = s.bull ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = col, size = size.tiny)
    // ── Entry zones ──
    n = math.max(3, math.min(60, bar_index - s.bar + 2))
    if wickZone
        top = s.bull ? s.edge : s.ext
        bot = s.bull ? s.ext : s.edge
        zc  = s.bull ? obBullCol : obBearCol
        s.bx := box.new(s.bar, top, bar_index + zExt, bot, border_color = color.new(zc, 50), bgcolor = zc, text = "SFP", text_size = size.tiny, text_color = color.new(chart.fg_color, 40), text_halign = text.align_right)
    else
        if entryMode != "FVG"
            [k, t, b] = f_findOB(s.bull, n)
            if not na(k)
                zc = s.bull ? obBullCol : obBearCol
                s.bx := box.new(bar_index - k, t, bar_index + zExt, b, border_color = color.new(zc, 40), bgcolor = zc, text = "OB", text_size = size.tiny, text_color = color.new(chart.fg_color, 30), text_halign = text.align_right)
        if entryMode != "OB"
            [k2, t2, b2] = f_findFVG(s.bull, n)
            if not na(k2)
                fc = s.bull ? fvgBullCol : fvgBearCol
                s.fx := box.new(bar_index - k2, t2, bar_index + zExt, b2, border_color = color.new(fc, 50), bgcolor = fc, text = "FVG", text_size = size.tiny, text_color = color.new(chart.fg_color, 30), text_halign = text.align_right)
    // ── TP / SL ──
    entry = close
    s.sl := s.bull ? s.ext - slBuf * atrV : s.ext + slBuf * atrV
    risk = math.abs(entry - s.sl)
    s.tp := s.bull ? entry + rr * risk : entry - rr * risk
    if showTP
        s.tpl  := line.new(bar_index, s.tp, bar_index + zExt, s.tp, color = col, style = line.style_dashed)
        s.sll  := line.new(bar_index, s.sl, bar_index + zExt, s.sl, color = color.new(color.gray, 20), style = line.style_dashed)
        s.tpLb := label.new(bar_index + zExt, s.tp, "TP " + str.tostring(rr) + "R", style = label.style_label_left, color = color.new(col, 80), textcolor = col, size = size.tiny)
        s.slLb := label.new(bar_index + zExt, s.sl, "SL", style = label.style_label_left, color = color.new(color.gray, 80), textcolor = color.gray, size = size.tiny)
    trades.push(Trade.new(s.bull, bar_index, s.sl, s.tp))
    s.born := bar_index
    arr.push(s)
    if arr.size() > maxShow
        f_delSig(arr.shift())
    alert((s.bull ? "Bullish" : "Bearish") + " SFP + MSS | " + syminfo.ticker + " " + timeframe.period + " | " + s.tag + " " + str.tostring(s.lvl, format.mintick) + " | SL " + str.tostring(s.sl, format.mintick) + " | TP " + str.tostring(s.tp, format.mintick), alert.freq_once_per_bar_close)

// ลบเมื่อ: ราคาปิดเลยปลายไส้ (setup พัง) / ถึง TP / เก่าเกิน
f_updActive(array<Sig> arr, bool canAct) =>
    bool touched = false
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            s = arr.get(i)
            dead  = s.bull ? close < s.ext : close > s.ext
            tpHit = s.bull ? high >= s.tp : low <= s.tp
            old   = maxAge > 0 and bar_index - s.bar > maxAge
            if canAct and bar_index > s.born and (dead or tpHit or old)
                f_delSig(s)
                arr.remove(i)
            else
                nx = bar_index + zExt
                if not na(s.bx)
                    if bar_index > s.born and high >= s.bx.get_bottom() and low <= s.bx.get_top()
                        touched := true
                    s.bx.set_right(nx)
                if not na(s.fx)
                    if bar_index > s.born and high >= s.fx.get_bottom() and low <= s.fx.get_top()
                        touched := true
                    s.fx.set_right(nx)
                if not na(s.tpl)
                    s.tpl.set_x2(nx)
                if not na(s.sll)
                    s.sll.set_x2(nx)
                if not na(s.tpLb)
                    s.tpLb.set_x(nx)
                if not na(s.slLb)
                    s.slLb.set_x(nx)
    touched

// ทะลุ swing ล่าสุดด้วยเนื้อเทียน + displacement
f_broke(Sig s) =>
    s.bull ? ((fullBody ? bb > s.trig : close > s.trig) and dispBull) : ((fullBody ? bt < s.trig : close < s.trig) and dispBear)

// ═════════════════════════ 1) STATS ═════════════════════════
if conf and trades.size() > 0
    for i = trades.size() - 1 to 0
        t = trades.get(i)
        if bar_index > t.bar
            lossHit = t.bull ? low <= t.sl : high >= t.sl
            winHit  = t.bull ? high >= t.tp : low <= t.tp
            if lossHit
                nLoss += 1
                trades.remove(i)
            else if winHit
                nWin += 1
                trades.remove(i)

// ═════════════════════════ 2) ACTIVE SFP ═════════════════════════
bullRetest = f_updActive(actBull, conf)
bearRetest = f_updActive(actBear, conf)

// ═════════════════════════ 3) PENDING → MSS / ลบทิ้ง ═════════════════════════
bool bullConfSig = false
bool bearConfSig = false

if not na(pBear) and not na(pBear.cl)
    pBear.cl.set_x2(bar_index + 1)
if not na(pBull) and not na(pBull.cl)
    pBull.cl.set_x2(bar_index + 1)

if conf and not na(pBear)
    if bar_index > pBear.bar and f_broke(pBear)
        f_activate(pBear, actBear)
        bearConfSig := true
        lastValid := "✔ MSS Confirmed"
        pBear := na
    else if close > pBear.ext or bar_index >= pBear.expire
        f_delSig(pBear)
        lastValid := "✖ ไม่เกิด MSS"
        pBear := na

if conf and not na(pBull)
    if bar_index > pBull.bar and f_broke(pBull)
        f_activate(pBull, actBull)
        bullConfSig := true
        lastValid := "✔ MSS Confirmed"
        pBull := na
    else if close < pBull.ext or bar_index >= pBull.expire
        f_delSig(pBull)
        lastValid := "✖ ไม่เกิด MSS"
        pBull := na

// ═════════════════════════ 4) LIQUIDITY LEVELS ═════════════════════════
// Swing + Equal Highs/Lows
ph = ta.pivothigh(high, pivLeft, pivRight)
pl = ta.pivotlow(low, pivLeft, pivRight)

if conf and not na(ph)
    string tg = "Swing"
    if useEq
        for lv in highsLv
            if math.abs(lv.price - ph) <= eqTol * atrV
                tg := "EQH"
                if lv.tag == "Swing"
                    lv.tag := "EQH"
    f_pushLv(highsLv, ph, bar_index - pivRight, tg)

if conf and not na(pl)
    string tg = "Swing"
    if useEq
        for lv in lowsLv
            if math.abs(lv.price - pl) <= eqTol * atrV
                tg := "EQL"
                if lv.tag == "Swing"
                    lv.tag := "EQL"
    f_pushLv(lowsLv, pl, bar_index - pivRight, tg)

// PDH / PDL
if conf and usePD and newDay and not na(pdh)
    f_pushLv(highsLv, pdh, bar_index, "PDH")
    f_pushLv(lowsLv, pdl, bar_index, "PDL")

// HTF candle H/L
if conf and useHtfLv and newHtf and not na(hH1)
    f_pushLv(highsLv, hH1, bar_index, "HTF H")
    f_pushLv(lowsLv, hL1, bar_index, "HTF L")

// Asia session H/L
var float asH  = na
var float asL  = na
var int   asHB = na
var int   asLB = na
if inAsia and not inAsia[1]
    asH  := high
    asL  := low
    asHB := bar_index
    asLB := bar_index
else if inAsia
    if high > asH
        asH  := high
        asHB := bar_index
    if low < asL
        asL  := low
        asLB := bar_index
if conf and useAsia and inAsia[1] and not inAsia and not na(asH)
    f_pushLv(highsLv, asH, asHB, "Asia H")
    f_pushLv(lowsLv, asL, asLB, "Asia L")

// ═════════════════════════ 5) SWEEP DETECTION ═════════════════════════
float  bearSwept    = na
int    bearSweptBar = na
string bearTag      = ""
float  bullSwept    = na
int    bullSweptBar = na
string bullTag      = ""
minDist = sweepMin * atrV
maxDist = sweepMax * atrV

if conf and highsLv.size() > 0
    for i = highsLv.size() - 1 to 0
        lv = highsLv.get(i)
        if close > lv.price
            highsLv.remove(i)
        else if high > lv.price and high - lv.price >= minDist
            depthOk  = sweepMax == 0 or high - lv.price <= maxDist
            rejected = rejBody ? bt < lv.price : close < lv.price
            keyOk    = liqMode == "All" or lv.tag != "Swing"
            if depthOk and rejected and keyOk and (na(bearSwept) or lv.price > bearSwept)
                bearSwept    := lv.price
                bearSweptBar := lv.bar
                bearTag      := lv.tag
            highsLv.remove(i)

if conf and lowsLv.size() > 0
    for i = lowsLv.size() - 1 to 0
        lv = lowsLv.get(i)
        if close < lv.price
            lowsLv.remove(i)
        else if low < lv.price and lv.price - low >= minDist
            depthOk  = sweepMax == 0 or lv.price - low <= maxDist
            rejected = rejBody ? bb > lv.price : close > lv.price
            keyOk    = liqMode == "All" or lv.tag != "Swing"
            if depthOk and rejected and keyOk and (na(bullSwept) or lv.price < bullSwept)
                bullSwept    := lv.price
                bullSweptBar := lv.bar
                bullTag      := lv.tag
            lowsLv.remove(i)

// ═════════════════════════ 6) CREATE SFP (รอ MSS) ═════════════════════════
bool bullRawSig = false
bool bearRawSig = false

if showBearS and not na(bearSwept)
    lastType  := "Bearish SFP"
    lastTag   := bearTag
    lastPrice := bearSwept
    if not bearAllowed
        lastValid := "✖ สวน HTF Bias"
    else if not sessOk
        lastValid := "✖ นอก Session"
    else
        pct = useVol ? f_beyondPct(bearSwept, true) : na
        lastPct := pct
        if useVol and (na(pct) or pct > volThr)
            lastValid := "✖ Volume สูงเกิน"
        else
            bearRawSig := true
            if not na(pBear)
                f_delSig(pBear)
                pBear := na
            useSwing = not na(lastSL) and lastSLBar < bar_index and lastSL < high
            trig     = useSwing ? lastSL : fbLow
            trigBar  = useSwing ? lastSLBar : fbLowBar
            lastTrig := trig
            s = Sig.new(bull = false, lvl = bearSwept, lvlBar = bearSweptBar, tag = bearTag, bar = bar_index, ext = high, edge = bt, trig = trig, trigBar = trigBar, expire = bar_index + confBars, pct = pct)
            if f_broke(s)
                f_activate(s, actBear)
                bearConfSig := true
                lastValid := "✔ MSS Confirmed"
            else
                if showPending
                    f_draw(s, true)
                pBear := s
                lastValid := "⏳ รอ MSS"

if showBullS and not na(bullSwept)
    lastType  := "Bullish SFP"
    lastTag   := bullTag
    lastPrice := bullSwept
    if not bullAllowed
        lastValid := "✖ สวน HTF Bias"
    else if not sessOk
        lastValid := "✖ นอก Session"
    else
        pct = useVol ? f_beyondPct(bullSwept, false) : na
        lastPct := pct
        if useVol and (na(pct) or pct > volThr)
            lastValid := "✖ Volume สูงเกิน"
        else
            bullRawSig := true
            if not na(pBull)
                f_delSig(pBull)
                pBull := na
            useSwing = not na(lastSH) and lastSHBar < bar_index and lastSH > low
            trig     = useSwing ? lastSH : fbHigh
            trigBar  = useSwing ? lastSHBar : fbHighBar
            lastTrig := trig
            s = Sig.new(bull = true, lvl = bullSwept, lvlBar = bullSweptBar, tag = bullTag, bar = bar_index, ext = low, edge = bb, trig = trig, trigBar = trigBar, expire = bar_index + confBars, pct = pct)
            if f_broke(s)
                f_activate(s, actBull)
                bullConfSig := true
                lastValid := "✔ MSS Confirmed"
            else
                if showPending
                    f_draw(s, true)
                pBull := s
                lastValid := "⏳ รอ MSS"

// ═════════════════════════ DASHBOARD ═════════════════════════
var table dash = table.new(f_pos(dashPos), 2, 8, bgcolor = color.new(#131722, 8), border_color = color.new(color.gray, 75), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
if showDash and barstate.islast
    tc = color.new(color.white, 5)
    sc = color.new(color.white, 45)
    total   = nWin + nLoss
    winRate = total > 0 ? nWin * 100.0 / total : na
    netR    = nWin * rr - nLoss
    sessTxt = inLon ? "London ●" : inNy ? "New York ●" : inAsia ? "Asia ●" : "-"
    dash.cell(0, 0, "SFP Pro X", text_color = tc, text_size = size.small, bgcolor = color.new(#2962ff, 30))
    dash.merge_cells(0, 0, 1, 0)
    dash.cell(0, 1, "HTF Bias", text_color = sc, text_size = size.small, text_halign = text.align_left)
    dash.cell(1, 1, biasTxt + (biasMode != "Off" ? "  (" + htfTf + ")" : ""), text_color = emaBull ? bullCol : emaBear ? bearCol : tc, text_size = size.small)
    dash.cell(0, 2, "Session", text_color = sc, text_size = size.small, text_halign = text.align_left)
    dash.cell(1, 2, sessTxt + (useSess ? "  · filter on" : ""), text_color = tc, text_size = size.small)
    dash.cell(0, 3, "Last", text_color = sc, text_size = size.small, text_halign = text.align_left)
    dash.cell(1, 3, lastType + (lastTag != "" and lastTag != "Swing" ? " · " + lastTag : ""), text_color = lastType == "Bearish SFP" ? bearCol : lastType == "Bullish SFP" ? bullCol : tc, text_size = size.small)
    dash.cell(0, 4, "Liq / MSS", text_color = sc, text_size = size.small, text_halign = text.align_left)
    dash.cell(1, 4, (na(lastPrice) ? "-" : str.tostring(lastPrice, format.mintick)) + "  /  " + (na(lastTrig) ? "-" : str.tostring(lastTrig, format.mintick)), text_color = tc, text_size = size.small)
    dash.cell(0, 5, "Status", text_color = sc, text_size = size.small, text_halign = text.align_left)
    dash.cell(1, 5, lastValid, text_color = tc, text_size = size.small)
    dash.cell(0, 6, "Stats (" + str.tostring(rr) + "R)", text_color = sc, text_size = size.small, text_halign = text.align_left)
    dash.cell(1, 6, "W " + str.tostring(nWin) + " / L " + str.tostring(nLoss) + (na(winRate) ? "" : "  · " + str.tostring(winRate, "#") + "%") + "  · " + str.tostring(netR, "#.#") + "R", text_color = netR > 0 ? bullCol : netR < 0 ? bearCol : tc, text_size = size.small)
    dash.cell(0, 7, "Active", text_color = sc, text_size = size.small, text_halign = text.align_left)
    dash.cell(1, 7, "▲ " + str.tostring(actBull.size()) + "   ▼ " + str.tostring(actBear.size()) + (useVol ? "  · vol " + (na(lastPct) ? "-" : str.tostring(lastPct, "#.#") + "%") : ""), text_color = tc, text_size = size.small)

// ═════════════════════════ ALERTS ═════════════════════════
alertcondition(bullRawSig, "Bullish Sweep (รอ MSS)", "Bullish liquidity sweep — waiting MSS | {{ticker}} {{interval}} @ {{close}}")
alertcondition(bearRawSig, "Bearish Sweep (รอ MSS)", "Bearish liquidity sweep — waiting MSS | {{ticker}} {{interval}} @ {{close}}")
alertcondition(bullConfSig, "Bullish SFP + MSS", "Bullish SFP confirmed by MSS | {{ticker}} {{interval}} @ {{close}}")
alertcondition(bearConfSig, "Bearish SFP + MSS", "Bearish SFP confirmed by MSS | {{ticker}} {{interval}} @ {{close}}")
alertcondition(bullRetest and conf, "Retest Bull Entry Zone", "Price retesting Bullish OB/FVG | {{ticker}} {{interval}}")
alertcondition(bearRetest and conf, "Retest Bear Entry Zone", "Price retesting Bearish OB/FVG | {{ticker}} {{interval}}")
