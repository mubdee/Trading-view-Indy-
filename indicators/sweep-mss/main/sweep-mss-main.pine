// ════════════════════════════════════════════════════════════════
// Sweep + MSS — MAIN · ยืนยันโครงสร้างอย่างเดียว (Pine Script v6)
// ⭐ ไฟล์หลัก (v2 2026-11-20) · ไฟล์สำรองสำหรับแก้: indicators/sweep-mss/sweep-mss-dev.pine
// Sweep = ไส้เลย swing แล้วปิดกลับ (นับ swing ของ TF กราฟ + TF ใหญ่)
// MSS   = ปิดทะลุ low/high ต้นขาที่ส่งไป sweep + ยืนยัน (Displacement / แท่งถัดไปไม่ปิดกลับ / วิ่งต่อ)
// v2: ตัดสินเฉพาะแท่งที่ปิดแล้ว · เส้น MSS รอยืนยัน · เกรด ★ (TF ใหญ่ · Displacement · FVG) · กล่อง FVG
// ════════════════════════════════════════════════════════════════
//@version=6
indicator("Sweep + MSS", shorttitle = "Sweep MSS", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 500)

// ═══════════════════════ INPUTS ═══════════════════════
string G1 = "Sweep"
int    pivLen  = input.int(3, "Swing length (TF กราฟ)", minval = 1, group = G1)
int    liqAge  = input.int(60, "กวาดเฉพาะ swing ที่เกิดภายใน (แท่ง)", minval = 5, group = G1)
int    gap     = input.int(2, "แท่ง Sweep ต้องห่างจากแท่ง swing อย่างน้อย (แท่ง)", minval = 1, group = G1)
bool   use1    = input.bool(true, "นับ swing ของ TF", inline = "t1", group = G1)
string tf1     = input.timeframe("60", "", inline = "t1", group = G1)
bool   use2    = input.bool(false, "และ TF", inline = "t2", group = G1)
string tf2     = input.timeframe("240", "", inline = "t2", group = G1)
int    htfLen  = input.int(2, "Swing length (TF ใหญ่)", minval = 1, group = G1)
bool   needHtf = input.bool(false, "ต้องกวาด swing ของ TF ใหญ่ด้วย", group = G1)

string G2 = "MSS"
string M1 = "Displacement หรือ แท่งถัดไปไม่ปิดกลับ"
string M2 = "แท่งถัดไปปิดเลย High/Low แท่งทะลุ"
string M3 = "แท่งถัดไปไม่ปิดกลับ"
string M4 = "ไม่ต้องยืนยัน (ปิดทะลุ = MSS)"
int    mssWin  = input.int(20, "ต้องทะลุภายใน (แท่งหลัง Sweep)", minval = 2, group = G2)
string cfmMode = input.string(M1, "ยืนยัน MSS แบบ", options = [M1, M2, M3, M4], group = G2)
int    cfmBars = input.int(1, "จำนวนแท่งยืนยันหลังแท่งทะลุ", minval = 1, maxval = 5, group = G2)
float  dispK   = input.float(1.0, "Displacement = body แท่งทะลุ ≥ (x ATR)", minval = 0.1, step = 0.1, group = G2)
float  backTol = input.float(0.1, "ปิดกลับเลยระดับ MSS เกิน (x ATR) = แค่ sweep", minval = 0, step = 0.05, group = G2)
bool   needFvg = input.bool(false, "ต้องมี FVG ในขา MSS", group = G2)

string G3 = "การแสดงผล"
color  cBull    = input.color(#2962FF, "Bullish (Sweep low → MSS ขึ้น)", group = G3)
color  cBear    = input.color(#E91E63, "Bearish (Sweep high → MSS ลง)", group = G3)
color  cWait    = input.color(#787B86, "Sweep ที่รอ MSS", group = G3)
bool   showPend = input.bool(true, "แสดงเส้น MSS ระหว่างรอยืนยัน (เส้นประ)", group = G3)
bool   showFvg  = input.bool(true, "แสดง FVG ของขา MSS", group = G3)
bool   showFail = input.bool(false, "แสดง Sweep ที่ไม่เกิด MSS (จาง)", group = G3)
bool   showDash = input.bool(true, "แสดง Dashboard", group = G3)

int   chartSec = timeframe.in_seconds(timeframe.period)
int   barMs    = chartSec * 1000
bool  ok1      = use1 and timeframe.in_seconds(tf1) > chartSec
bool  ok2      = use2 and timeframe.in_seconds(tf2) > chartSec
bool  mDisp    = cfmMode == M1
bool  mStrict  = cfmMode == M2
bool  mNone    = cfmMode == M4
color cNone    = color.new(color.white, 100)
float atr      = ta.atr(14)

f_tfStr(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? "M" + str.tostring(s / 60) : s < 86400 ? "H" + str.tostring(s / 3600) : s < 604800 ? "D" + str.tostring(s / 86400) : tf

f_kName(int k) =>
    k == 0 ? f_tfStr(timeframe.period) : k == 1 ? f_tfStr(tf1) : f_tfStr(tf2)

// ═══════════════════════ SWING (TF กราฟ + TF ใหญ่) ═══════════════════════
var array<float> hiP = array.new<float>()
var array<int>   hiT = array.new<int>()
var array<int>   hiB = array.new<int>()
var array<int>   hiK = array.new<int>()
var array<float> loP = array.new<float>()
var array<int>   loT = array.new<int>()
var array<int>   loB = array.new<int>()
var array<int>   loK = array.new<int>()

f_push(array<float> P, array<int> T, array<int> B, array<int> K, float p, int t, int b, int k) =>
    P.push(p)
    T.push(t)
    B.push(b)
    K.push(k)
    if P.size() > 150
        P.shift()
        T.shift()
        B.shift()
        K.shift()

f_pv(int len) =>
    [ta.pivothigh(high, len, len), ta.pivotlow(low, len, len), time[len], time]

f_pvC(int len) =>
    [a, b, c, d] = f_pv(len)
    [a[1], b[1], c[1], d[1]]

float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
[h1h, h1l, h1t, h1n] = request.security(syminfo.tickerid, tf1, f_pvC(htfLen), lookahead = barmerge.lookahead_on)
[h2h, h2l, h2t, h2n] = request.security(syminfo.tickerid, tf2, f_pvC(htfLen), lookahead = barmerge.lookahead_on)
bool n1 = ta.change(h1n) != 0
bool n2 = ta.change(h2n) != 0

// ═══════════════════════ ตรวจ SWEEP ═══════════════════════
// คืน [ระดับที่ถูกกวาด (สุดขั้ว), เวลา swing, ข้อความ TF, มี TF ใหญ่]
f_scan(array<float> P, array<int> T, array<int> B, array<int> K, bool isHigh) =>
    float  lvl  = na
    int    lvT  = na
    string tfs  = ""
    bool   htfH = false
    if P.size() > 0
        for i = P.size() - 1 to 0
            float p   = P.get(i)
            int   k   = K.get(i)
            bool  old = k == 0 and bar_index - B.get(i) > liqAge
            bool  hit = isHigh ? high > p : low < p
            if old
                P.remove(i)
                T.remove(i)
                B.remove(i)
                K.remove(i)
            else if hit
                bool rej = isHigh ? close < p : close > p
                bool gOk = k != 0 or bar_index - B.get(i) >= gap
                if rej and gOk
                    if na(lvl) or (isHigh ? p > lvl : p < lvl)
                        lvl := p
                        lvT := T.get(i)
                    string nm = f_kName(k)
                    if not str.contains(tfs, nm)
                        tfs += (tfs == "" ? "" : ",") + nm
                    if k != 0
                        htfH := true
                P.remove(i)
                T.remove(i)
                B.remove(i)
                K.remove(i)
    [lvl, lvT, tfs, htfH]

// ═══════════════════════ SETUP: Sweep → MSS ═══════════════════════
// st: 0 = จบ · 1 = รอปิดทะลุ · 2 = ทะลุแล้ว รอแท่งยืนยัน
type Su
    bool   bull
    int    st   = 0
    float  wick
    int    sBar
    bool   htf  = false
    float  mss
    int    mT
    int    brkBar
    float  brkEx
    bool   disp = false
    bool   fvg  = false
    int    fT
    float  fTop
    float  fBot
    line   ln
    label  lb
    line   pl
    label  pb

f_new(bool bull, float lvl, int lvT, string tfs, bool htf) =>
    // ระดับ MSS = จุดต่ำสุด / สูงสุดของขาที่ส่งราคาไป sweep (ระหว่าง swing ที่ถูกกวาด กับแท่ง Sweep)
    float m  = na
    int   mt = na
    for j = 1 to 300
        if time[j] < lvT
            break
        float v = bull ? high[j] : low[j]
        if na(m) or (bull ? v > m : v < m)
            m  := v
            mt := time[j]
    line  l = line.new(lvT, lvl, time, lvl, xloc = xloc.bar_time, color = cWait, width = 1)
    label b = label.new(time, bull ? low : high, "Sweep " + tfs, xloc = xloc.bar_time, style = bull ? label.style_label_up : label.style_label_down, color = cNone, textcolor = cWait, size = size.small)
    Su.new(bull = bull, st = na(m) ? 0 : 1, wick = bull ? low : high, sBar = bar_index, htf = htf, mss = m, mT = mt, ln = l, lb = b)

f_clrPend(Su s) =>
    if not na(s.pl)
        line.delete(s.pl)
    if not na(s.pb)
        label.delete(s.pb)

f_fail(Su s) =>
    s.st := 0
    f_clrPend(s)
    if showFail
        line.set_color(s.ln, color.new(cWait, 70))
        label.set_textcolor(s.lb, color.new(cWait, 70))
        label.set_text(s.lb, label.get_text(s.lb) + " ✗")
    else
        line.delete(s.ln)
        label.delete(s.lb)

f_stars(Su s) =>
    int n = (s.htf ? 1 : 0) + (s.disp ? 1 : 0) + (s.fvg ? 1 : 0)
    n == 3 ? "★★★" : n == 2 ? "★★" : n == 1 ? "★" : ""

f_ok(Su s) =>
    s.st := 0
    f_clrPend(s)
    color c = s.bull ? cBull : cBear
    line.set_color(s.ln, c)
    label.set_textcolor(s.lb, c)
    line.new(s.mT, s.mss, time, s.mss, xloc = xloc.bar_time, color = c, width = 2)
    string tag = (s.disp ? " · Disp" : "") + (s.fvg ? " · FVG" : "")
    label.new(time, s.mss, "MSS " + f_tfStr(timeframe.period) + " " + f_stars(s) + tag, xloc = xloc.bar_time, style = s.bull ? label.style_label_down : label.style_label_up, color = cNone, textcolor = c, size = size.small)
    if showFvg and s.fvg
        box.new(s.fT, s.fTop, time + 10 * barMs, s.fBot, xloc = xloc.bar_time, border_color = color.new(c, 60), bgcolor = color.new(c, 85))

f_confirm(Su s) =>
    string tx = ""
    bool   ok = false
    if needFvg and not s.fvg
        f_fail(s)
        tx := "ไม่มี FVG ในขา MSS"
    else
        f_ok(s)
        ok := true
        tx := "MSS ✓ " + f_stars(s) + " @ " + str.tostring(s.mss, format.mintick)
    [tx, ok]

// เดิน state ของ setup 1 แท่ง (เรียกเฉพาะแท่งที่ปิดแล้ว) → [ข้อความ, MSS ยืนยันแท่งนี้]
f_step(Su s) =>
    string tx = ""
    bool   ok = false
    bool   b  = s.bull
    if s.st > 0 and bar_index > s.sBar
        line.set_x2(s.ln, time)
        if not na(s.pl)
            line.set_x2(s.pl, time)
        // FVG ทิศเดียวกับ MSS ที่เกิดในขาหลัง Sweep
        bool fv = b ? low > high[2] : high < low[2]
        if fv and bar_index - 2 >= s.sBar
            s.fvg  := true
            s.fT   := time[2]
            s.fTop := b ? low : low[2]
            s.fBot := b ? high[2] : high
        if b ? low < s.wick : high > s.wick
            f_fail(s)
            tx := b ? "ทำ Low ใหม่ · ไม่เกิด MSS" : "ทำ High ใหม่ · ไม่เกิด MSS"
        else if s.st == 1
            if b ? close > s.mss : close < s.mss
                s.st     := 2
                s.brkBar := bar_index
                s.brkEx  := b ? high : low
                s.disp   := math.abs(close - open) >= dispK * atr and (b ? close > open : close < open)
                if mNone or (mDisp and s.disp)
                    [t2, o2] = f_confirm(s)
                    tx := t2
                    ok := o2
                else
                    tx := "ทะลุ " + str.tostring(s.mss, format.mintick) + " · รอแท่งยืนยัน"
                    if showPend
                        color c = b ? cBull : cBear
                        s.pl := line.new(s.mT, s.mss, time, s.mss, xloc = xloc.bar_time, color = c, style = line.style_dashed, width = 1)
                        s.pb := label.new(time, s.mss, "MSS? รอยืนยัน", xloc = xloc.bar_time, style = b ? label.style_label_down : label.style_label_up, color = cNone, textcolor = color.new(c, 30), size = size.tiny)
            else if bar_index - s.sBar > mssWin
                f_fail(s)
                tx := "ไม่เกิด MSS ใน " + str.tostring(mssWin) + " แท่ง"
        else if bar_index > s.brkBar
            float tol  = backTol * atr
            bool  back = b ? close < s.mss - tol : close > s.mss + tol
            bool  run  = b ? close > s.brkEx : close < s.brkEx
            bool  due  = bar_index - s.brkBar >= cfmBars
            if back
                f_fail(s)
                tx := "ทะลุแล้วปิดกลับ = แค่ sweep"
            else if mStrict ? run : due
                [t2, o2] = f_confirm(s)
                tx := t2
                ok := o2
            else if due
                f_fail(s)
                tx := "ทะลุแต่ไม่วิ่งต่อ"
    [tx, ok]

var Su bS = na
var Su sS = na
var string bTxt = "—"
var string sTxt = "—"

bool bullSweep = false
bool bearSweep = false
bool bullMss   = false
bool bearMss   = false

// ═══════════════════════ คำนวณเฉพาะแท่งที่ปิดแล้ว (ไม่ตัดสินจากแท่งที่ยังวิ่ง) ═══════════════════════
if barstate.isconfirmed
    if not na(ph)
        f_push(hiP, hiT, hiB, hiK, ph, time[pivLen], bar_index - pivLen, 0)
    if not na(pl)
        f_push(loP, loT, loB, loK, pl, time[pivLen], bar_index - pivLen, 0)
    if ok1 and n1
        if not na(h1h)
            f_push(hiP, hiT, hiB, hiK, h1h, h1t, bar_index, 1)
        if not na(h1l)
            f_push(loP, loT, loB, loK, h1l, h1t, bar_index, 1)
    if ok2 and n2
        if not na(h2h)
            f_push(hiP, hiT, hiB, hiK, h2h, h2t, bar_index, 2)
        if not na(h2l)
            f_push(loP, loT, loB, loK, h2l, h2t, bar_index, 2)

    // เดิน setup ที่มีอยู่ก่อน แล้วค่อยรับ Sweep ใหม่
    if not na(bS)
        [t, o] = f_step(bS)
        if t != ""
            bTxt := t
        bullMss := o
    if not na(sS)
        [t, o] = f_step(sS)
        if t != ""
            sTxt := t
        bearMss := o

    [sHiLvl, sHiT, sHiTf, sHiHtf] = f_scan(hiP, hiT, hiB, hiK, true)
    [sLoLvl, sLoT, sLoTf, sLoHtf] = f_scan(loP, loT, loB, loK, false)

    // Sweep ใหม่ แทนตัวเก่าที่ยังรอ (ถ้าตัวเก่ายังไม่ทะลุ)
    if not na(sLoLvl) and (not needHtf or sLoHtf) and not (not na(bS) and bS.st == 2)
        if not na(bS) and bS.st > 0
            f_fail(bS)
        bS := f_new(true, sLoLvl, sLoT, sLoTf, sLoHtf)
        bullSweep := true
        bTxt := "Sweep " + sLoTf + " · รอ MSS"
        alert("Bullish Sweep " + sLoTf + " | " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(sLoLvl, format.mintick) + " · รอ MSS", alert.freq_once_per_bar_close)
    if not na(sHiLvl) and (not needHtf or sHiHtf) and not (not na(sS) and sS.st == 2)
        if not na(sS) and sS.st > 0
            f_fail(sS)
        sS := f_new(false, sHiLvl, sHiT, sHiTf, sHiHtf)
        bearSweep := true
        sTxt := "Sweep " + sHiTf + " · รอ MSS"
        alert("Bearish Sweep " + sHiTf + " | " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(sHiLvl, format.mintick) + " · รอ MSS", alert.freq_once_per_bar_close)

    if bullMss
        alert("Bullish MSS ✓ " + bTxt + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
    if bearMss
        alert("Bearish MSS ✓ " + sTxt + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)

plotshape(bullMss, "Bullish MSS", shape.triangleup, location.belowbar, cBull, size = size.tiny)
plotshape(bearMss, "Bearish MSS", shape.triangledown, location.abovebar, cBear, size = size.tiny)

// ═══════════════════════ DASHBOARD ═══════════════════════
var table dash = table.new(position.top_right, 2, 4, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(color.gray, 70))
f_txCol(string tx, color c) =>
    str.contains(tx, "✓") ? c : str.contains(tx, "รอ") ? color.yellow : color.gray
if showDash and barstate.islast
    string tfTx = f_tfStr(timeframe.period) + (ok1 ? " + " + f_tfStr(tf1) : "") + (ok2 ? " + " + f_tfStr(tf2) : "")
    table.cell(dash, 0, 0, "Sweep + MSS", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, "Swing: " + tfTx, text_color = color.gray, text_size = size.small)
    table.cell(dash, 0, 1, "▲ Bullish", text_color = cBull, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1, bTxt, text_color = f_txCol(bTxt, cBull), text_size = size.small)
    table.cell(dash, 0, 2, "▼ Bearish", text_color = cBear, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2, sTxt, text_color = f_txCol(sTxt, cBear), text_size = size.small)
    table.cell(dash, 0, 3, "ยืนยัน MSS", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3, mNone ? "ปิดทะลุ = MSS" : mDisp ? "Displacement ≥ " + str.tostring(dispK) + " ATR หรือ " + str.tostring(cfmBars) + " แท่งไม่ปิดกลับ" : mStrict ? str.tostring(cfmBars) + " แท่งต้องวิ่งต่อ" : str.tostring(cfmBars) + " แท่งไม่ปิดกลับ", text_color = color.gray, text_size = size.small)

// ═══════════════════════ ALERTS ═══════════════════════
alertcondition(bullSweep, "Bullish Sweep", "Bullish Sweep | {{ticker}} {{interval}} · รอ MSS")
alertcondition(bearSweep, "Bearish Sweep", "Bearish Sweep | {{ticker}} {{interval}} · รอ MSS")
alertcondition(bullMss, "Bullish MSS ✓", "Bullish MSS ✓ | {{ticker}} {{interval}} @ {{close}}")
alertcondition(bearMss, "Bearish MSS ✓", "Bearish MSS ✓ | {{ticker}} {{interval}} @ {{close}}")
