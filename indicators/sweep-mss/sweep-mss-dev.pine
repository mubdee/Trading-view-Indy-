// ════════════════════════════════════════════════════════════════
// Sweep + MSS — DEV · MTF: เปิดกราฟเล็ก (เช่น M5) ตรวจจับโครงสร้างบน M30 · H1 · H4 (Pine Script v6)
// ✏️ ไฟล์สำรองสำหรับแก้/ทดลอง (สำเนาเดียวกับ MAIN v5 2026-11-20) · ไฟล์หลัก: indicators/sweep-mss/main/sweep-mss-main.pine
// Sweep = ไส้เลย swing แล้วปิดกลับ (คำนวณบนแท่งของ TF ใหญ่แต่ละตัว)
// MSS   = แท่ง TF ใหญ่ปิดด้วยเนื้อทะลุ high/low ต้นขาที่ส่งไป sweep · ไส้ทะลุแล้วปิดกลับ = แค่ sweep (รอต่อ)
// v5: ใช้ค่าของแท่ง TF ใหญ่ที่ปิดแล้วเท่านั้น (ไม่ repaint) · เวอร์ชันดูบนกราฟ TF เดียว = v4 ใน git history
// ════════════════════════════════════════════════════════════════
//@version=6
indicator("Sweep + MSS DEV", shorttitle = "Sweep MSS DEV", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ═══════════════════════ INPUTS ═══════════════════════
string G0 = "ทามเฟรมที่ตรวจจับ (เปิดกราฟเล็ก เช่น M5)"
bool   u1  = input.bool(true, "TF 1", inline = "a", group = G0)
string tf1 = input.timeframe("30", "", inline = "a", group = G0)
bool   u2  = input.bool(true, "TF 2", inline = "b", group = G0)
string tf2 = input.timeframe("60", "", inline = "b", group = G0)
bool   u3  = input.bool(true, "TF 3", inline = "c", group = G0)
string tf3 = input.timeframe("240", "", inline = "c", group = G0)

string G1 = "Sweep / MSS (นับเป็นแท่งของ TF นั้นๆ)"
int    pivLen = input.int(3, "Swing length", minval = 1, group = G1)
int    liqAge = input.int(60, "กวาดเฉพาะ swing ที่เกิดภายใน (แท่ง)", minval = 5, group = G1)
int    gap    = input.int(2, "แท่ง Sweep ต้องห่างจากแท่ง swing อย่างน้อย (แท่ง)", minval = 1, group = G1)
int    mssWin = input.int(20, "MSS ต้องเกิดภายใน (แท่งหลัง Sweep)", minval = 2, group = G1)

string G3 = "การแสดงผล"
color  cBull    = input.color(#2962FF, "Bullish (Sweep low → MSS ขึ้น)", group = G3)
color  cBear    = input.color(#E91E63, "Bearish (Sweep high → MSS ลง)", group = G3)
color  cWait    = input.color(#787B86, "Sweep ที่รอ MSS", group = G3)
bool   showPend = input.bool(true, "แสดงระดับ MSS ระหว่างรอ (เส้นประ)", group = G3)
bool   showFail = input.bool(false, "แสดง Sweep ที่ไม่เกิด MSS (จาง)", group = G3)
bool   showDash = input.bool(true, "แสดง Dashboard", group = G3)

int   chartSec = timeframe.in_seconds(timeframe.period)
bool  ok1 = u1 and timeframe.in_seconds(tf1) > chartSec
bool  ok2 = u2 and timeframe.in_seconds(tf2) > chartSec
bool  ok3 = u3 and timeframe.in_seconds(tf3) > chartSec
color cNone = color.new(color.white, 100)

f_tfStr(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? "M" + str.tostring(s / 60) : s < 86400 ? "H" + str.tostring(s / 3600) : s < 604800 ? "D" + str.tostring(s / 86400) : tf

// ═══════════════════════ ENGINE (รันบนแท่งของ TF ใหญ่) ═══════════════════════
// Sweep = ไส้เลย swing แล้วปิดกลับ · MSS = แท่งปิดด้วยเนื้อทะลุ high/low ต้นขาที่ส่งไป sweep
// ไส้ทะลุระดับ MSS แล้วปิดกลับ = แค่ sweep ระดับ MSS (รอต่อ) · ทำ Low/High ใหม่เลยไส้ sweep = ยกเลิก
f_eng(int len, int age, int gp, int win) =>
    var array<float> hP = array.new<float>()
    var array<int>   hT = array.new<int>()
    var array<int>   hB = array.new<int>()
    var array<float> lP = array.new<float>()
    var array<int>   lT = array.new<int>()
    var array<int>   lB = array.new<int>()
    // Bullish (sweep low)
    var int   uSt   = 0
    var float uWick = na
    var int   uSBar = na
    var float uMss  = na
    var int   uMT   = na
    var bool  uIsw  = false
    // Bearish (sweep high)
    var int   dSt   = 0
    var float dWick = na
    var int   dSBar = na
    var float dMss  = na
    var int   dMT   = na
    var bool  dIsw  = false
    bool  uSwEv = false
    bool  uOkEv = false
    bool  uFail = false
    float uSwP  = na
    int   uSwT  = na
    float uOkM  = na
    int   uOkT  = na
    bool  uOkI  = false
    bool  dSwEv = false
    bool  dOkEv = false
    bool  dFail = false
    float dSwP  = na
    int   dSwT  = na
    float dOkM  = na
    int   dOkT  = na
    bool  dOkI  = false

    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    if not na(ph)
        hP.push(ph)
        hT.push(time[len])
        hB.push(bar_index - len)
        if hP.size() > 100
            hP.shift()
            hT.shift()
            hB.shift()
    if not na(pl)
        lP.push(pl)
        lT.push(time[len])
        lB.push(bar_index - len)
        if lP.size() > 100
            lP.shift()
            lT.shift()
            lB.shift()

    // ── เดิน setup เดิม ──
    if uSt == 1 and bar_index > uSBar
        if low < uWick
            uSt   := 0
            uFail := true
        else if close > uMss
            uSt   := 0
            uOkEv := true
            uOkM  := uMss
            uOkT  := uMT
            uOkI  := uIsw
        else
            if high > uMss
                uIsw := true
            if bar_index - uSBar > win
                uSt   := 0
                uFail := true
    if dSt == 1 and bar_index > dSBar
        if high > dWick
            dSt   := 0
            dFail := true
        else if close < dMss
            dSt   := 0
            dOkEv := true
            dOkM  := dMss
            dOkT  := dMT
            dOkI  := dIsw
        else
            if low < dMss
                dIsw := true
            if bar_index - dSBar > win
                dSt   := 0
                dFail := true

    // ── หา Sweep ใหม่ ──
    if lP.size() > 0
        for i = lP.size() - 1 to 0
            float p = lP.get(i)
            if bar_index - lB.get(i) > age
                lP.remove(i)
                lT.remove(i)
                lB.remove(i)
            else if low < p
                if close > p and bar_index - lB.get(i) >= gp and (na(uSwP) or p < uSwP)
                    uSwP := p
                    uSwT := lT.get(i)
                lP.remove(i)
                lT.remove(i)
                lB.remove(i)
    if hP.size() > 0
        for i = hP.size() - 1 to 0
            float p = hP.get(i)
            if bar_index - hB.get(i) > age
                hP.remove(i)
                hT.remove(i)
                hB.remove(i)
            else if high > p
                if close < p and bar_index - hB.get(i) >= gp and (na(dSwP) or p > dSwP)
                    dSwP := p
                    dSwT := hT.get(i)
                hP.remove(i)
                hT.remove(i)
                hB.remove(i)

    if not na(uSwP)
        float m  = na
        int   mt = na
        for j = 1 to 300
            if time[j] < uSwT
                break
            if na(m) or high[j] > m
                m  := high[j]
                mt := time[j]
        if not na(m)
            if uSt == 1
                uFail := true
            uSt   := 1
            uWick := low
            uSBar := bar_index
            uMss  := m
            uMT   := mt
            uIsw  := false
            uSwEv := true
    if not na(dSwP)
        float m  = na
        int   mt = na
        for j = 1 to 300
            if time[j] < dSwT
                break
            if na(m) or low[j] < m
                m  := low[j]
                mt := time[j]
        if not na(m)
            if dSt == 1
                dFail := true
            dSt   := 1
            dWick := high
            dSBar := bar_index
            dMss  := m
            dMT   := mt
            dIsw  := false
            dSwEv := true

    [time, uSwEv, uSwP, uSwT, uWick, uMss, uMT, uOkEv, uOkM, uOkT, uFail, uOkI, uIsw and uSt == 1, dSwEv, dSwP, dSwT, dWick, dMss, dMT, dOkEv, dOkM, dOkT, dFail, dOkI, dIsw and dSt == 1]

// ส่งค่าของแท่ง TF ใหญ่ที่ "ปิดแล้ว" เท่านั้น (ไม่ repaint)
f_engC(int len, int age, int gp, int win) =>
    [t, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12] = f_eng(len, age, gp, win)
    [t[1], a1[1], a2[1], a3[1], a4[1], a5[1], a6[1], a7[1], a8[1], a9[1], a10[1], a11[1], a12[1], b1[1], b2[1], b3[1], b4[1], b5[1], b6[1], b7[1], b8[1], b9[1], b10[1], b11[1], b12[1]]

[x1t, x1a1, x1a2, x1a3, x1a4, x1a5, x1a6, x1a7, x1a8, x1a9, x1a10, x1a11, x1a12, x1b1, x1b2, x1b3, x1b4, x1b5, x1b6, x1b7, x1b8, x1b9, x1b10, x1b11, x1b12] = request.security(syminfo.tickerid, tf1, f_engC(pivLen, liqAge, gap, mssWin), lookahead = barmerge.lookahead_on)
[x2t, x2a1, x2a2, x2a3, x2a4, x2a5, x2a6, x2a7, x2a8, x2a9, x2a10, x2a11, x2a12, x2b1, x2b2, x2b3, x2b4, x2b5, x2b6, x2b7, x2b8, x2b9, x2b10, x2b11, x2b12] = request.security(syminfo.tickerid, tf2, f_engC(pivLen, liqAge, gap, mssWin), lookahead = barmerge.lookahead_on)
[x3t, x3a1, x3a2, x3a3, x3a4, x3a5, x3a6, x3a7, x3a8, x3a9, x3a10, x3a11, x3a12, x3b1, x3b2, x3b3, x3b4, x3b5, x3b6, x3b7, x3b8, x3b9, x3b10, x3b11, x3b12] = request.security(syminfo.tickerid, tf3, f_engC(pivLen, liqAge, gap, mssWin), lookahead = barmerge.lookahead_on)
bool nw1 = ok1 and ta.change(x1t) != 0
bool nw2 = ok2 and ta.change(x2t) != 0
bool nw3 = ok3 and ta.change(x3t) != 0

// ═══════════════════════ วาดบนกราฟเล็ก ═══════════════════════
type Dw
    line   sl
    label  sb
    line   ml
    string tx = "—"

f_side(Dw d, bool bull, string tn, int w, bool nw, int ht, bool swEv, float swP, int swT, float wick, float mss, int mT, bool okEv, float okM, int okT, bool fail, bool okI, bool iswNow) =>
    bool  okNow = false
    color c     = bull ? cBull : cBear
    if nw and fail and not na(d.sl)
        if not na(d.ml)
            line.delete(d.ml)
        if showFail
            line.set_color(d.sl, color.new(cWait, 70))
            label.set_textcolor(d.sb, color.new(cWait, 70))
            label.set_text(d.sb, label.get_text(d.sb) + " ✗")
        else
            line.delete(d.sl)
            label.delete(d.sb)
        d.sl := na
        d.sb := na
        d.ml := na
        d.tx := "ไม่เกิด MSS"
    if nw and okEv and not na(d.sl)
        if not na(d.ml)
            line.delete(d.ml)
        line.set_color(d.sl, c)
        line.set_x2(d.sl, ht)
        label.set_textcolor(d.sb, c)
        line.new(okT, okM, ht, okM, xloc = xloc.bar_time, color = c, width = w + 1)
        label.new(ht, okM, "MSS " + tn + (okI ? " · หลัง sweep" : ""), xloc = xloc.bar_time, style = bull ? label.style_label_down : label.style_label_up, color = cNone, textcolor = c, size = size.small)
        d.sl := na
        d.sb := na
        d.ml := na
        d.tx := "MSS ✓ @ " + str.tostring(okM, format.mintick)
        okNow := true
    if nw and swEv
        d.sl := line.new(swT, swP, ht, swP, xloc = xloc.bar_time, color = cWait, width = w)
        d.sb := label.new(ht, wick, "Sweep " + tn, xloc = xloc.bar_time, style = bull ? label.style_label_up : label.style_label_down, color = cNone, textcolor = cWait, size = size.small)
        if showPend
            d.ml := line.new(mT, mss, ht, mss, xloc = xloc.bar_time, color = color.new(c, 40), style = line.style_dashed, width = 1)
        d.tx := "Sweep · รอ MSS " + str.tostring(mss, format.mintick)
    else if not na(d.sl)
        line.set_x2(d.sl, time)
        if not na(d.ml)
            line.set_x2(d.ml, time)
        if nw and iswNow
            d.tx := "ไส้ทะลุ MSS = sweep · รอปิดด้วยเนื้อ"
    okNow

var Dw u1d = Dw.new()
var Dw d1d = Dw.new()
var Dw u2d = Dw.new()
var Dw d2d = Dw.new()
var Dw u3d = Dw.new()
var Dw d3d = Dw.new()
string n1 = f_tfStr(tf1)
string n2 = f_tfStr(tf2)
string n3 = f_tfStr(tf3)

bool m1u = f_side(u1d, true,  n1, 1, nw1, x1t, x1a1, x1a2, x1a3, x1a4, x1a5, x1a6, x1a7, x1a8, x1a9, x1a10, x1a11, x1a12)
bool m1d = f_side(d1d, false, n1, 1, nw1, x1t, x1b1, x1b2, x1b3, x1b4, x1b5, x1b6, x1b7, x1b8, x1b9, x1b10, x1b11, x1b12)
bool m2u = f_side(u2d, true,  n2, 2, nw2, x2t, x2a1, x2a2, x2a3, x2a4, x2a5, x2a6, x2a7, x2a8, x2a9, x2a10, x2a11, x2a12)
bool m2d = f_side(d2d, false, n2, 2, nw2, x2t, x2b1, x2b2, x2b3, x2b4, x2b5, x2b6, x2b7, x2b8, x2b9, x2b10, x2b11, x2b12)
bool m3u = f_side(u3d, true,  n3, 3, nw3, x3t, x3a1, x3a2, x3a3, x3a4, x3a5, x3a6, x3a7, x3a8, x3a9, x3a10, x3a11, x3a12)
bool m3d = f_side(d3d, false, n3, 3, nw3, x3t, x3b1, x3b2, x3b3, x3b4, x3b5, x3b6, x3b7, x3b8, x3b9, x3b10, x3b11, x3b12)

bool sw1u = nw1 and x1a1
bool sw1d = nw1 and x1b1
bool sw2u = nw2 and x2a1
bool sw2d = nw2 and x2b1
bool sw3u = nw3 and x3a1
bool sw3d = nw3 and x3b1
bool bullSweep = sw1u or sw2u or sw3u
bool bearSweep = sw1d or sw2d or sw3d
bool bullMss   = m1u or m2u or m3u
bool bearMss   = m1d or m2d or m3d

// ═══════════════════════ ALERTS ═══════════════════════
f_al(bool cond, string msg) =>
    if cond
        alert(msg + " | " + syminfo.ticker, alert.freq_once_per_bar)

f_al(sw1u, "Bullish Sweep " + n1 + " · รอ MSS")
f_al(sw1d, "Bearish Sweep " + n1 + " · รอ MSS")
f_al(sw2u, "Bullish Sweep " + n2 + " · รอ MSS")
f_al(sw2d, "Bearish Sweep " + n2 + " · รอ MSS")
f_al(sw3u, "Bullish Sweep " + n3 + " · รอ MSS")
f_al(sw3d, "Bearish Sweep " + n3 + " · รอ MSS")
f_al(m1u, "Bullish MSS ✓ " + n1)
f_al(m1d, "Bearish MSS ✓ " + n1)
f_al(m2u, "Bullish MSS ✓ " + n2)
f_al(m2d, "Bearish MSS ✓ " + n2)
f_al(m3u, "Bullish MSS ✓ " + n3)
f_al(m3d, "Bearish MSS ✓ " + n3)

alertcondition(bullSweep, "Bullish Sweep (TF ใหญ่)", "Bullish Sweep | {{ticker}} · รอ MSS")
alertcondition(bearSweep, "Bearish Sweep (TF ใหญ่)", "Bearish Sweep | {{ticker}} · รอ MSS")
alertcondition(bullMss, "Bullish MSS ✓ (TF ใหญ่)", "Bullish MSS ✓ | {{ticker}} @ {{close}}")
alertcondition(bearMss, "Bearish MSS ✓ (TF ใหญ่)", "Bearish MSS ✓ | {{ticker}} @ {{close}}")

plotshape(bullMss, "Bullish MSS", shape.triangleup, location.belowbar, cBull, size = size.tiny)
plotshape(bearMss, "Bearish MSS", shape.triangledown, location.abovebar, cBear, size = size.tiny)

// ═══════════════════════ DASHBOARD ═══════════════════════
var table dash = table.new(position.top_right, 3, 4, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(color.gray, 70))
f_col(string tx, color c) =>
    str.contains(tx, "✓") ? c : str.contains(tx, "รอ") ? color.yellow : color.gray
f_row(int r, bool on, string tn, Dw u, Dw d) =>
    table.cell(dash, 0, r, tn, text_color = on ? color.white : color.gray, text_size = size.small)
    table.cell(dash, 1, r, on ? u.tx : "ปิด / ไม่ใหญ่กว่ากราฟ", text_color = on ? f_col(u.tx, cBull) : color.gray, text_size = size.small)
    table.cell(dash, 2, r, on ? d.tx : "", text_color = f_col(d.tx, cBear), text_size = size.small)
if showDash and barstate.islast
    table.cell(dash, 0, 0, "Sweep + MSS", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, "▲ Bullish", text_color = cBull, text_size = size.small)
    table.cell(dash, 2, 0, "▼ Bearish", text_color = cBear, text_size = size.small)
    f_row(1, ok1, n1, u1d, d1d)
    f_row(2, ok2, n2, u2d, d2d)
    f_row(3, ok3, n3, u3d, d3d)
